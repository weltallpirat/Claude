# =========================================================
# BEDWARS SYSTEM, MECHANICS & CUSTOM ITEMS
# (Syntax gegen Skript 2.16 geprüft)
# =========================================================

options:
    # true = natürliches Gelände (Gras, Erde, Stein, Sand, Holz ...) überlebt Explosionen
    protect_landscape: true
    # Sekunden zwischen zwei Smaragden pro Smaragd-Spawner der Schmiede (ab Stufe 3): alle 60 Sekunden
    emerald_interval: 60
    # Arena-Welten im Squad-Modus (Komma getrennt, KEINE Leerzeichen).
    # (Nur noch für Squad-Funktionen genutzt, NICHT mehr für die Spawner-Menge: Eisen droppt überall 1x)
    squad_worlds: BedwarsRooftop,BedwarsWilderWestern,BedwarsPlayground
    # Name der Lobby-Welt: dort wird Level/Punkte-Anzeige gezeigt
    lobby_world: Lobby
    # Punkte pro Aktion (kommen ueber die SBW-Rewards aus der config.yml)
    pts_join: 10
    pts_kill: 10
    pts_final_kill: 20
    pts_bed: 50
    pts_win: 100
    # Maximales Level
    max_level: 100
    # Gamble: Stunden zwischen zwei Tagesboni und Grundbonus (+10 pro Tag Serie bis Tag 7, +2 pro Level)
    daily_hours: 20
    daily_base: 50
    # Schmiede: Smaragd-Intervall ab Stufe 4 (Sekunden). Gleich wie Stufe 3 = Smaragde alle 60 Sekunden.
    emerald_interval_max: 60
    # Schmiede: Ein Eisen-/Gold-Spawner gehört zum Team, dessen Smaragd-Spawner (/emeraldspawner)
    # am nächsten liegt, wenn dieser höchstens so viele Blöcke entfernt ist
    forge_radius: 30
    # Schmiede-Bonus: Das Skript fasst den NORMALEN Spawner-Drop (Eisen alle 0,75 s laut config.yml)
    # nie an: nicht abbrechen, nicht verschieben, nicht verteilen. Die Schmiede legt nur ZUSAETZLICHES
    # Eisen/Gold direkt neben den normalen Drop. Das Teilen unter Spielern am Spawner macht allein das
    # SBA-Plugin (sbaconfig.yml -> generator-splitter), damit nichts doppelt verteilt wird.
    # false = das Skript fasst die Spawner GAR NICHT an (keine Schmiede-Boni). Zum Testen:
    # ist das Eisen dann normal, lag es am Skript.
    spawner_boost: true
    # Maximale Anzahl auf dem Boden pro Spawner (Summe aller Items im Umkreis). Gilt für Map- UND Schmiede-Spawner.
    max_diamonds: 6
    max_emeralds: 4
    # Umkreis in Blöcken um den Spawner, in dem gezählt wird
    cap_radius: 2.5

# =========================================================
# HILFSFUNKTIONEN
# =========================================================

# Deutsche Teamnamen (wie in der Teamauswahl) -> interner Farbname
function bwTeamAlias(t: text) :: text:
    set {_t} to {_t} in lowercase
    replace all " " with "_" in {_t}
    if {_t} is "blau":
        return "blue"
    if {_t} is "gelb":
        return "yellow"
    if {_t} is "grau":
        return "gray"
    if {_t} is "grün" or "gruen":
        return "lime"
    if {_t} is "dunkelgrün" or "dunkelgruen":
        return "green"
    if {_t} is "rosa" or "pink":
        return "pink"
    if {_t} is "rot":
        return "red"
    if {_t} is "türkis" or "tuerkis":
        return "cyan"
    if {_t} is "weiß" or "weiss":
        return "white"
    if {_t} is "schwarz":
        return "black"
    if {_t} is "braun":
        return "brown"
    if {_t} is "hellblau":
        return "light_blue"
    if {_t} is "hellgrau":
        return "light_gray"
    if {_t} is "lila":
        return "magenta"
    return {_t}

# interner Farbname -> deutscher Teamname (für Anzeigen)
function bwTeamGerman(t: text) :: text:
    if {_t} is "blue":
        return "Blau"
    if {_t} is "yellow":
        return "Gelb"
    if {_t} is "gray":
        return "Grau"
    if {_t} is "lime":
        return "Grün"
    if {_t} is "green":
        return "Dunkelgrün"
    if {_t} is "pink":
        return "Rosa"
    if {_t} is "red":
        return "Rot"
    if {_t} is "cyan":
        return "Türkis"
    if {_t} is "white":
        return "Weiß"
    return {_t}

# SBW-Teamfarben (exakte Lederfarben aus dem SBW-Quellcode). Teams heißen dadurch
# direkt wie ihre Farbe (red, blue, green, yellow, cyan, white, pink, gray, ...).
function bwAddPreset(n: text, r: number, g: number, b: number):
    set {_i} to leather chestplate
    dye {_i} ({_r}, {_g}, {_b})
    set {-bw::preset::%{_n}%} to {_i}

function bwBuildPresets():
    delete {-bw::preset::*}
    bwAddPreset("black", 0, 0, 0)
    bwAddPreset("blue", 0, 0, 170)
    bwAddPreset("green", 0, 170, 0)
    bwAddPreset("red", 255, 85, 85)
    bwAddPreset("magenta", 170, 0, 170)
    bwAddPreset("orange", 255, 170, 0)
    bwAddPreset("light_gray", 170, 170, 170)
    bwAddPreset("gray", 85, 85, 85)
    bwAddPreset("light_blue", 85, 85, 255)
    bwAddPreset("lime", 85, 255, 85)
    bwAddPreset("cyan", 85, 255, 255)
    bwAddPreset("pink", 255, 85, 255)
    bwAddPreset("yellow", 255, 255, 85)
    bwAddPreset("white", 255, 255, 255)
    bwAddPreset("brown", 139, 69, 19)

on load:
    bwBuildPresets()
    # Glücksrad: ein beim Reload/Absturz unterbrochener Spin gibt den Einsatz zurück und gibt den Spieler wieder frei
    loop {bwg::pend::*}:
        add loop-value to {bwp::pts::%loop-index%}
        delete {bwg::pend::%loop-index%}
    delete {-bwg::spin::*}

# Team-Kennung: zuerst Farbname (red, blue, ...), sonst team1, team2, ... (gelernt).
# Skript kann die Farbe von Lederrüstung nicht auslesen, deshalb wird die Brustplatte
# mit bekannten bzw. gelernten Vorlagen verglichen.
# NEU: Das zuletzt erkannte Team wird pro Spieler und Welt gemerkt. Fehlt die Rüstung kurz
# (Tod, Respawn, Unsichtbarkeit, Spectator), bleibt das Team erhalten. Dadurch ändert sich der
# Schlüssel der Schmiede/Upgrades mitten im Spiel nicht mehr.
# Optional: {bw.team::<spieler>} überschreibt die Erkennung.
function bwTeam(p: player) :: text:
    if {bw.team::%{_p}%} is set:
        return "%{bw.team::%{_p}%}%"
    set {_u} to "%uuid of {_p}%"
    set {_wn} to name of world of {_p}
    set {_c} to chestplate of {_p}
    if {bw::invis::%{_p}%} is true:
        set {_c} to {bw::invis_armor::%{_p}%::chest}
    if "%type of {_c}%" contains "leather chestplate":
        if {-bw::preset::*} is not set:
            bwBuildPresets()
        loop {-bw::preset::*}:
            if {_c} is loop-value:
                set {-bw::tc::%{_u}%} to "%{_wn}%|%loop-index%"
                return loop-index
        loop {bw::tref::*}:
            if {_c} is loop-value:
                set {-bw::tc::%{_u}%} to "%{_wn}%|team%loop-index%"
                return "team%loop-index%"
        # Neue Teamfarben nur im Spiel lernen (nicht in der Lobby/als Zuschauer)
        if gamemode of {_p} is survival:
            set {_n} to size of {bw::tref::*} + 1
            set {bw::tref::%{_n}%} to {_c}
            set {-bw::tc::%{_u}%} to "%{_wn}%|team%{_n}%"
            return "team%{_n}%"
    # Rüstung gerade nicht erkennbar -> zuletzt bekanntes Team in dieser Welt
    if {-bw::tc::%{_u}%} is set:
        set {_parts::*} to split "%{-bw::tc::%{_u}%}%" at "|"
        if {_parts::1} is {_wn}:
            return {_parts::2}
    return "none"

# true, wenn unter dem Spieler (40 Blöcke) kein fester Block ist (Void)
function overVoid(p: player) :: boolean:
    set {_l} to location of {_p}
    loop 40 times:
        if (block at ({_l} offset by vector(0, 0 - loop-number, 0))) is solid:
            return false
    return true

# Schlüssel "Welt|Team" (pro Arena-Welt und Team eindeutig)
function bwKey(p: player) :: text:
    return "%name of world of {_p}%|%bwTeam({_p})%"

function toolTier(i: item) :: number:
    set {_n} to "%type of {_i}%"
    if {_n} contains "wooden":
        return 1
    if {_n} contains "stone":
        return 2
    if {_n} contains "golden":
        return 2
    if {_n} contains "iron":
        return 3
    if {_n} contains "diamond":
        return 4
    return 0

function diamondCount(p: player) :: number:
    set {_n} to 0
    loop all items in {_p}'s inventory:
        if loop-item is diamond:
            add item amount of loop-item to {_n}
    return {_n}

# Alle Rundendaten einer Arena-Welt löschen (Teamtruhe, Forge-Stufen, Upgrades, Smaragd-Zähler)
function bwResetWorldData(w: world):
    set {_pre} to "%name of {_w}%|"
    loop {-bw::tcinv::*}:
        if loop-index starts with {_pre}:
            delete {-bw::tcinv::%loop-index%}
    loop {-bw::tcloc::*}:
        if loop-index starts with {_pre}:
            delete {-bw::tcloc::%loop-index%}
    # Einstufige Listen: nach Präfix löschen
    loop {bw::forge::*}:
        if loop-index starts with {_pre}:
            delete {bw::forge::%loop-index%}
    loop {bw::fcarry::*}:
        if loop-index starts with {_pre}:
            delete {bw::fcarry::%loop-index%}
    # Zusätzlich direkt über alle bekannten Teamnamen löschen (sicher, auch bei verschachtelten Listen wie bw::up)
    loop {-bw::preset::*}:
        delete {bw::forge::%{_pre}%%loop-index%}
        delete {bw::up::%{_pre}%%loop-index%::*}
    loop {bw::tref::*}:
        delete {bw::forge::%{_pre}%team%loop-index%}
        delete {bw::up::%{_pre}%team%loop-index%::*}
    # Smaragd-Zähler der Schmiede-Spawner dieser Welt auf 0
    loop {bw::esp::*}:
        if world of loop-value is {_w}:
            delete {-bw::espc::%loop-index%}

# Rundendaten einer Welt werden gelöscht, wenn die Welt mindestens 10 Sekunden lang leer war
# (Fallback; zusätzlich setzt bwCheckEmpty sofort zurück, sobald der letzte Spieler die Welt verlässt).
function bwSweepWorlds():
    loop all worlds:
        set {_n} to name of loop-world
        if size of (all players in loop-world) is 0:
            if {-bw::empty::%{_n}%} is not set:
                set {-bw::empty::%{_n}%} to now
            else if difference between {-bw::empty::%{_n}%} and now is greater than 10 seconds:
                bwResetWorldData(loop-world)
                delete {-bw::empty::%{_n}%}
        else:
            delete {-bw::empty::%{_n}%}

# Setzt Schmiede, Upgrades und Teamtruhen einer Welt sofort zurück, sobald der letzte Spieler sie verlassen hat
function bwCheckEmpty(w: world, leaver: player):
    wait 2 seconds
    set {_n} to 0
    loop all players in {_w}:
        if loop-player is not {_leaver}:
            add 1 to {_n}
    if {_n} is 0:
        bwResetWorldData({_w})

every 30 seconds:
    bwSweepWorlds()

# =========================================================
# 1. REGENERATION (alle 4 Sekunden ein halbes Herz, nur Spieler im Spiel)
# =========================================================
# Natürliche Heilung (peaceful regeneration / satiated) wird gestoppt,
# Tränke, Essen und Heal Pool bleiben erlaubt.
on heal:
    set {_r} to "%heal reason%"
    if {_r} contains "peaceful" or "satiated":
        cancel event

every 4 seconds:
    loop all players:
        if gamemode of loop-player is survival:
            if bwTeam(loop-player) is not "none":
                if health of loop-player < max health of loop-player:
                    heal loop-player by 0.5 hearts

# =========================================================
# 2. DROP-SPERRE IN DER LUFT
# =========================================================
on drop:
    if player is not on ground:
        set {_i} to event-item
        if {_i} is iron ingot or gold ingot or emerald or diamond:
            cancel event

# =========================================================
# 3. LANDSCHAFT SCHÜTZEN
# =========================================================
function isLandscape(b: block) :: boolean:
    set {_m} to "%type of {_b}%"
    if {_m} contains "end stone" or "cut sandstone" or "wool" or "planks" or "glass" or "packed ice" or "iron block" or "ladder" or "tnt" or "chest" or "bed":
        return false
    if {_m} contains "grass" or "dirt" or "podzol" or "mycelium" or "leaves" or "log" or "wood" or "sand" or "gravel" or "clay" or "snow" or "stone" or "cobble" or "andesite" or "diorite" or "granite" or "deepslate" or "ore" or "netherrack" or "flower" or "fern" or "vine" or "moss":
        return true
    return false

# Glas ist gegen jede Explosion (TNT, Feuerball, TNT-Schaf, ...) immun
on explode:
    loop exploded blocks:
        if "%type of loop-block%" contains "glass":
            add loop-block to {_glass::*}
    if size of {_glass::*} > 0:
        remove {_glass::*} from exploded blocks

# Feuerbälle zerstören keinen Endstein
on explode:
    if event-entity is a fireball or a small fireball:
        loop exploded blocks:
            if "%type of loop-block%" contains "end stone":
                add loop-block to {_keep::*}
        if size of {_keep::*} > 0:
            remove {_keep::*} from exploded blocks

on explode:
    if "{@protect_landscape}" is "true":
        loop exploded blocks:
            if isLandscape(loop-block) is true:
                add loop-block to {_protect::*}
        if size of {_protect::*} > 0:
            remove {_protect::*} from exploded blocks

# =========================================================
# 4. WINDKANONE (30s Cooldown)
# =========================================================
# Eine ECHTE Wind Charge (normales Projektil-Entity, Vanilla-Aufprall und -Rückstoß).
# Sie fliegt geradeaus. Taucht im 10-Block-Umkreis der FLIEGENDEN Charge ein Gegner auf,
# wird ihre Flugrichtung laufend auf ihn gelenkt (nur die Flugbahn, kein künstlicher Knockback).
# Kill-Gutschrift OHNE Schaden: Beim Aufprall (Windcharge bzw. Feuerball) merkt sich das Skript
# den Schützen für Gegner im 4-Block-Umkreis. Stirbt so ein Gegner innerhalb von 10 Sekunden
# ohne Spieler als Killer (Void, Fall), bekommt der Schütze Kill-Punkte und Statistik.
function bwCreditHit(shooter: player, loc: location):
    set {_myTeam} to bwTeam({_shooter})
    loop all players in radius 4 around {_loc}:
        if loop-player is not {_shooter}:
            if gamemode of loop-player is survival:
                set {_same} to false
                if {_myTeam} is not "none":
                    if bwTeam(loop-player) is {_myTeam}:
                        set {_same} to true
                if {_same} is false:
                    set {-bw::cr::%uuid of loop-player%} to {_shooter}
                    set {-bw::crt::%uuid of loop-player%} to now

on death of player:
    set {_u} to "%uuid of victim%"
    if {-bw::cr::%{_u}%} is set:
        set {_s} to {-bw::cr::%{_u}%}
        set {_t} to {-bw::crt::%{_u}%}
        delete {-bw::cr::%{_u}%}
        delete {-bw::crt::%{_u}%}
        if attacker is not a player:
            if {_s} is online:
                if difference between {_t} and now is less than 10 seconds:
                    if {_s} is not victim:
                        bwAddPoints({_s}, {@pts_kill}, "Kill")
                        bwStatAdd({_s}, "kills", 1)
                        send "&aDu hast &f%victim% &aausgeschaltet!" to {_s}

on rightclick holding nautilus shell:
    if "%name of player's tool%" contains "Windkanone":
        cancel event
        if {-bw::wk_cd::%uuid of player%} is set:
            set {_waited} to difference between {-bw::wk_cd::%uuid of player%} and now
            if {_waited} is less than 30 seconds:
                stop
        if player has 1 wind charge:
            remove 1 wind charge from player's inventory
            set {-bw::wk_cd::%uuid of player%} to now
            set item cooldown of nautilus shell for player to 30 seconds
            set {_shooter} to player
            set {_myTeam} to bwTeam({_shooter})
            set {_start} to location of {_shooter}
            shoot a wind charge from {_shooter} at speed 1.4
            set {_proj} to shot wind charge
            set {-bwx::wkproj::%uuid of {_proj}%} to true
            set {_last} to {_start}
            loop 70 times:
                if {_proj} is alive:
                    set {_loc} to location of {_proj}
                    set {_last} to {_loc}
                    if (distance between {_start} and {_loc}) > 30:
                        delete {_proj}
                        stop
                    draw cloud particle at {_loc}
                    # Gegner im 10-Block-Umkreis der fliegenden Windcharge suchen (nächster gewinnt)
                    delete {_target}
                    set {_best} to 999
                    loop all players in radius 10 around {_loc}:
                        if loop-player is not {_shooter}:
                            if gamemode of loop-player is survival:
                                set {_same} to false
                                if {_myTeam} is not "none":
                                    if bwTeam(loop-player) is {_myTeam}:
                                        set {_same} to true
                                if {_same} is false:
                                    set {_d} to distance between {_loc} and location of loop-player
                                    if {_d} < {_best}:
                                        set {_best} to {_d}
                                        set {_target} to loop-player
                    if {_target} is set:
                        set {_want} to vector from {_loc} to ((location of {_target}) offset by vector(0, 1, 0))
                        if vector length of {_want} > 0.05:
                            set vector length of {_want} to 1.2
                            set velocity of {_proj} to {_want}
                    wait 1 tick
                else:
                    bwCreditHit({_shooter}, {_last})
                    stop
            delete {_proj}
        else:
            send "&cDu benötigst eine Wind Charge in deinem Inventar!" to player

# =========================================================
# 5. RETTUNGSPLATTFORM: KEIN FALLSCHADEN
# =========================================================
# SBW bricht den Rechtsklick selbst ab, deshalb wird der Verbrauch des Items erkannt.
every 3 ticks:
    loop all players:
        if gamemode of loop-player is survival:
            set {_c} to 0
            loop all items in loop-player's inventory:
                if "%name of loop-item%" contains "Rettungsplattform":
                    add item amount of loop-item to {_c}
            set {_o} to {-bw::rp_cnt::%uuid of loop-player%}
            if {_o} is set:
                if {_c} < {_o}:
                    set {-bw::nofall::%uuid of loop-player%} to now
                    set fall distance of loop-player to 0
            set {-bw::rp_cnt::%uuid of loop-player%} to {_c}

on damage of player:
    if damage cause is fall:
        if {-bw::nofall::%uuid of victim%} is set:
            if difference between {-bw::nofall::%uuid of victim%} and now is less than 10 seconds:
                cancel event

# =========================================================
# 6. UNSICHTBARKEIT
# =========================================================
on consume of potion:
    set {_n} to "%name of event-item%"
    if {_n} does not contain "Invisibility":
        stop
    set {_p} to player
    if {bw::invis::%{_p}%} is not true:
        set {bw::invis::%{_p}%} to true
        set {bw::invis_armor::%{_p}%::helmet} to helmet of {_p}
        set {bw::invis_armor::%{_p}%::chest} to chestplate of {_p}
        set {bw::invis_armor::%{_p}%::leggings} to leggings of {_p}
        set {bw::invis_armor::%{_p}%::boots} to boots of {_p}
        set helmet of {_p} to air
        set chestplate of {_p} to air
        set leggings of {_p} to air
        set boots of {_p} to air
    apply invisibility 1 to {_p} for 30 seconds
    add 1 to {bw::invis_token::%{_p}%}
    set {_t} to {bw::invis_token::%{_p}%}
    wait 30 seconds
    if {bw::invis::%{_p}%} is true:
        if {bw::invis_token::%{_p}%} is {_t}:
            revealPlayer({_p})

# leichte Partikel unter den Füßen (Skript-Effekt, keine Konsolen-Befehle)
every 6 ticks:
    loop all players:
        if {bw::invis::%loop-player%} is true:
            draw cloud particle at (location of loop-player) offset by vector(random number between -0.25 and 0.25, 0.1, random number between -0.25 and 0.25)

# Enthüllungs-Falle (gibt Leuchten) löst Unsichtbarkeit auf
every 5 ticks:
    loop all players:
        if {bw::invis::%loop-player%} is true:
            if glowing of loop-player is true:
                remove invisibility from loop-player
                revealPlayer(loop-player)
                send "&c&lENTHÜLLT! &7Eine Enthüllungs-Falle hat deine Unsichtbarkeit aufgelöst!" to loop-player

on damage of player:
    if {bw::invis::%victim%} is true:
        remove invisibility from victim
        send "&cDeine Unsichtbarkeit wurde durch Schaden aufgehoben!" to victim
        revealPlayer(victim)

function revealPlayer(p: player):
    delete {bw::invis::%{_p}%}
    set helmet of {_p} to {bw::invis_armor::%{_p}%::helmet}
    set chestplate of {_p} to {bw::invis_armor::%{_p}%::chest}
    set leggings of {_p} to {bw::invis_armor::%{_p}%::leggings}
    set boots of {_p} to {bw::invis_armor::%{_p}%::boots}
    delete {bw::invis_armor::%{_p}%::*}

# =========================================================
# 7. MOBILE TEAMTRUHE
# =========================================================
# Ein Teammitglied platziert die Kiste 1x pro Runde (die platzierte Kiste ist die
# echte SBW-Team-Truhe "(BW) Team chest"). Sobald sie jemand öffnet, merkt sich das
# Skript genau dieses Inventar. Danach öffnet jede "Mobile Teamtruhe" im Team von überall
# DASSELBE Inventar. Nicht nutzbar über dem Void.
on inventory open:
    set {_p} to player
    wait 1 tick
    if "%name of {_p}'s current inventory%" contains "Team chest":
        set {_t} to bwTeam({_p})
        if {_t} is not "none":
            set {_k} to bwKey({_p})
            set {-bw::tcinv::%{_k}%} to {_p}'s current inventory

function bwOpenTeamChest(p: player):
    set {_t} to bwTeam({_p})
    if {_t} is "none":
        send "&cDu bist in keinem Team!" to {_p}
        stop
    if overVoid({_p}) is true:
        send "&cÜber dem Void kannst du die Teamtruhe nicht benutzen!" to {_p}
        stop
    # 6 Sekunden Sperre, nachdem man Schaden bekommen hat
    if {-bw::tc_dmg::%uuid of {_p}%} is set:
        set {_since} to difference between {-bw::tc_dmg::%uuid of {_p}%} and now
        if {_since} is less than 6 seconds:
            set {_rem} to 6 seconds - {_since}
            send "&cNach Schaden kannst du die Teamtruhe erst in %{_rem}% wieder öffnen!" to {_p}
            stop
    set {_k} to bwKey({_p})
    if {-bw::tcloc::%{_k}%} is set:
        if (block at {-bw::tcloc::%{_k}%}) is not ender chest:
            # Truhe existiert nicht mehr (zerstört / neue Runde) -> vergessen
            delete {-bw::tcloc::%{_k}%}
            delete {-bw::tcinv::%{_k}%}
    if {-bw::tcloc::%{_k}%} is not set:
        send "&cEuer Team hat die Teamtruhe noch nicht platziert! (Schleichen + Rechtsklick auf einen Block)" to {_p}
        stop
    if {-bw::tcinv::%{_k}%} is not set:
        send "&cÖffne die platzierte Teamtruhe einmal, danach geht es von überall." to {_p}
        stop
    if {-bw::tc_cd::%uuid of {_p}%} is set:
        if difference between {-bw::tc_cd::%uuid of {_p}%} and now is less than 5 ticks:
            stop
    set {-bw::tc_cd::%uuid of {_p}%} to now
    open {-bw::tcinv::%{_k}%} to {_p}
    play sound "block.ender_chest.open" with volume 1 and pitch 1 to {_p}

on rightclick:
    if "%name of player's tool%" contains "Mobile Teamtruhe":
        if player is sneaking:
            if clicked block is set:
                stop
        cancel event
        bwOpenTeamChest(player)

on place of ender chest:
    if "%name of player's tool%" contains "Mobile Teamtruhe":
        set {_p} to player
        if bwTeam({_p}) is "none":
            cancel event
            stop
        if overVoid({_p}) is true:
            cancel event
            send "&cÜber dem Void kannst du die Teamtruhe nicht platzieren!" to {_p}
            stop
        set {_k} to bwKey({_p})
        if {-bw::tcloc::%{_k}%} is set:
            if (block at {-bw::tcloc::%{_k}%}) is not ender chest:
                # alte Truhe existiert nicht mehr -> neue Runde / zerstört
                delete {-bw::tcloc::%{_k}%}
                delete {-bw::tcinv::%{_k}%}
        if {-bw::tcloc::%{_k}%} is set:
            cancel event
            send "&cEure Teamtruhe wurde in dieser Runde schon platziert (nur 1x pro Team)!" to {_p}
            stop
        delete {-bw::tcinv::%{_k}%}
        set {-bw::tcloc::%{_k}%} to location of event-block
        send "&aTeamtruhe platziert! Das ganze Team nutzt dieselbe Truhe." to {_p}

# Wird von SBW ausgeführt (config.yml -> rewards). Mit dem Zusatz "start" (Spielstart) ODER "end"
# (Spielende) werden Teamtruhen, Kisten und Schmiede-Stufen der Arena zurückgesetzt. Ohne Zusatz
# (Spieler-Events) wird die Schmiede NIE angefasst. Zusätzlich setzt /bwpoints join beim echten Spielstart zurück.
command /bwroundstart [<text>] [<text>]:
    permission: op
    trigger:
        if arg-1 is set:
            set {_w} to world arg-1
            # Arena-Name stimmt nicht exakt mit dem Weltnamen überein -> Welt über Namen suchen
            if {_w} is not set:
                loop all worlds:
                    set {_wn} to name of loop-world in lowercase
                    set {_an} to arg-1 in lowercase
                    if {_wn} is {_an} or "%{_wn}%" contains "%{_an}%" or "%{_an}%" contains "%{_wn}%":
                        set {_w} to loop-world
                        exit loop
            if {_w} is set:
                # Golem / TNT-Schaf lassen sich im Peaceful-Modus nicht spawnen
                set difficulty of {_w} to normal
                if arg-2 is "start" or "end":
                    bwResetWorldData({_w})
                    loop all players in {_w}:
                        delete {-bw::tc::%uuid of loop-player%}
                    delete {-bw::gs::%name of {_w}%}
                stop
            else if arg-2 is "start" or "end":
                # Welt nicht eindeutig gefunden -> sicherheitshalber alle Arena-Welten zurücksetzen
                loop all worlds:
                    if bwIsArena(loop-world) is true:
                        bwResetWorldData(loop-world)
                stop
        bwSweepWorlds()

# Setzt die Schwierigkeit DEINER aktuellen Welt auf "normal" (die server.properties gilt nur für die Hauptwelt)
command /arenanormal:
    permission: op
    trigger:
        set difficulty of world of player to normal
        send "&aSchwierigkeit der Welt &f%name of world of player% &aist jetzt normal." to player

command /resetteamchests:
    permission: op
    trigger:
        loop all worlds:
            bwResetWorldData(loop-world)
        send "&aTeamtruhen, platzierte Kisten und Forge-Stufen wurden zurückgesetzt." to sender

# Gibt dir die Brustplatte eines Teams (zum Ansehen der Farbe): /teamitem red | /teamitem team2
command /teamitem <text>:
    permission: op
    trigger:
        set {_k} to bwTeamAlias(arg-1)
        if {-bw::preset::%{_k}%} is set:
            give {-bw::preset::%{_k}%} to player
            send "&aBrustplatte von Team &f%arg-1% &aerhalten." to player
        else:
            set {_a} to arg-1
            replace all "team" with "" in {_a}
            if {bw::tref::%{_a}%} is set:
                give {bw::tref::%{_a}%} to player
                send "&aBrustplatte von Team &f%arg-1% &aerhalten." to player
            else:
                send "&cUnbekanntes Team. Namen: black, blue, green, red, magenta, orange, light_gray, gray, light_blue, lime, cyan, pink, yellow, white, brown" to player

command /resetteamcolors:
    permission: op
    trigger:
        delete {bw::tref::*}
        send "&aGelernte Teamfarben wurden gelöscht (werden beim nächsten Spiel neu gelernt)." to sender

command /teamdebug:
    permission: op
    trigger:
        send "&7Team-Kennung: &f%bwTeam(player)% &7(%bwTeamGerman(bwTeam(player))%)" to player
        send "&7Teamtruhe platziert bei: &f%{-bw::tcloc::%bwKey(player)%}%" to player
        send "&7Forge-Stufe deines Teams: &f%{bw::forge::%bwKey(player)%}%" to player

# =========================================================
# 8. FORGE: STUFEN NUR DER REIHE NACH KAUFBAR + SMARAGD-SPAWNER-SYSTEM
# =========================================================
on inventory click with priority lowest:
    set {_ci} to event-item
    if {_ci} is not set:
        stop
    set {_n} to "%name of {_ci}%"
    if {_n} does not contain "Schmiede":
        stop
    set {_t} to bwTeam(player)
    if {_t} is "none":
        stop
    set {_stage} to 1
    if {_n} contains "Schmiede IV":
        set {_stage} to 4
    else if {_n} contains "Schmiede III":
        set {_stage} to 3
    else if {_n} contains "Schmiede II":
        set {_stage} to 2
    set {_k} to bwKey(player)
    set {_cur} to {bw::forge::%{_k}%}
    if {_cur} is not set:
        set {_cur} to 0
    if {_stage} is not ({_cur} + 1):
        cancel event
        if {_stage} <= {_cur}:
            send "&cDiese Schmiede-Stufe habt ihr schon!" to player
        else:
            set {_need} to {_cur} + 1
            send "&cKaufe zuerst Schmiede-Stufe %{_need}%!" to player
        stop
    set {_before} to diamondCount(player)
    set {_p} to player
    wait 3 ticks
    if diamondCount({_p}) < {_before}:
        set {bw::forge::%{_k}%} to {_stage}
        # Die Schmiede-Stufen sind nur "Kauf-Items" -> aus dem Inventar entfernen,
        # die Wirkung kommt komplett aus diesem Skript (Abschnitt 15)
        loop all items in {_p}'s inventory:
            if "%name of loop-item%" contains "Schmiede":
                remove loop-item from {_p}'s inventory
        if {_stage} is 1:
            send "&aSchmiede I: Eure Iron- und Gold-Spawner liefern jetzt +50%%!" to {_p}
        else if {_stage} is 2:
            send "&aSchmiede II: Eure Iron- und Gold-Spawner liefern jetzt +100%%!" to {_p}
        else if {_stage} is 3:
            send "&aSchmiede III: Eure Smaragd-Spawner in der Base sind jetzt aktiv!" to {_p}
        else:
            send "&aSchmiede IV: Eure Iron- und Gold-Spawner liefern jetzt +200%%!" to {_p}

# Merkt sich den echten Smaragd der Map-Spawner (grüner Name) als Vorlage,
# damit die Schmiede-Smaragde exakt gleich aussehen und stacken.
on pickup of emerald:
    set {_n} to "%name of event-item%"
    if {_n} contains "Emerald":
        set {bw::emtemplate} to event-item
        set item amount of {bw::emtemplate} to 1

# Smaragd-Spawner: /emeraldspawner add <name> <team> | remove <name> | list
# Team = Farbname (red, lime, pink, cyan ...), deutscher Teamname (Rot, Grün, Rosa, Türkis ...),
# Kennung aus /teamdebug ODER der Name eines Spielers aus dem Team (online, mit Rüstung).
# Stehe beim "add" an der Stelle, an der die Smaragde spawnen sollen.
command /emeraldspawner [<text>] [<text>] [<text>]:
    permission: op
    usage: /emeraldspawner add <name> <team> | remove <name> | list | template
    trigger:
        if arg-1 is "add":
            if sender is not a player:
                send "&cNur als Spieler benutzbar!" to sender
                stop
            if arg-2 is not set:
                send "&cNutzung: /emeraldspawner add <name> <team>" to sender
                stop
            if arg-3 is not set:
                send "&cNutzung: /emeraldspawner add <name> <team>" to sender
                stop
            set {_team} to bwTeamAlias(arg-3)
            set {_pp} to arg-3 parsed as player
            if {_pp} is set:
                set {_team} to bwTeam({_pp})
            set {bw::esp::%arg-2%} to location of player
            set {bw::espteam::%arg-2%} to {_team}
            send "&aSmaragd-Spawner &f%arg-2% &afür Team &f%{_team}% &a(%bwTeamGerman({_team})%) gesetzt." to sender
        else if arg-1 is "template":
            if sender is not a player:
                send "&cNur als Spieler benutzbar!" to sender
                stop
            if "%name of player's tool%" does not contain "Emerald":
                send "&cHalte einen Smaragd aus einem Map-Spawner (grüner Name) in der Hand!" to sender
                stop
            set {bw::emtemplate} to player's tool
            set item amount of {bw::emtemplate} to 1
            send "&aSmaragd-Vorlage gespeichert. Schmiede-Smaragde sehen jetzt genauso aus." to sender
        else if arg-1 is "remove":
            if arg-2 is not set:
                send "&cNutzung: /emeraldspawner remove <name>" to sender
                stop
            delete {bw::esp::%arg-2%}
            delete {bw::espteam::%arg-2%}
            send "&aSmaragd-Spawner &f%arg-2% &aentfernt." to sender
        else if arg-1 is "list":
            if size of {bw::esp::*} is 0:
                send "&7Keine Smaragd-Spawner vorhanden." to sender
                stop
            loop {bw::esp::*}:
                send "&7- &f%loop-index% &7(Team: &f%{bw::espteam::%loop-index%}% &7/ %bwTeamGerman({bw::espteam::%loop-index%})%) bei %loop-value%" to sender
        else:
            send "&cNutzung: /emeraldspawner add <name> <team> | remove <name> | list" to sender

# Ab Schmiede Stufe 3 spawnt jeder Smaragd-Spawner des Teams Smaragde
every 1 second:
    loop {bw::esp::*}:
        set {_name} to loop-index
        set {_l} to loop-value
        set {_key} to "%name of world of {_l}%|%{bw::espteam::%{_name}%}%"
        set {_st} to {bw::forge::%{_key}%}
        if {_st} is set:
            if {_st} >= 3:
                add 1 to {-bw::espc::%{_name}%}
                set {_iv} to {@emerald_interval}
                if {_st} >= 4:
                    set {_iv} to {@emerald_interval_max}
                if {-bw::espc::%{_name}%} >= {_iv}:
                    set {-bw::espc::%{_name}%} to 0
                    set {_it} to {bw::emtemplate}
                    if {_it} is not set:
                        set {_it} to emerald named "&aEmerald"
                    drop {_it} at {_l} without velocity

# =========================================================
# 9. WERKZEUGE: PERMANENT, EINMAL KAUFBAR, HÖHERE ERSETZEN NIEDRIGERE
# =========================================================
on inventory click with priority lowest:
    set {_ci} to event-item
    if {_ci} is not set:
        stop
    if "%lore of {_ci}%" does not contain "Price":
        stop
    # Team-Upgrades (z.B. "Team Effizienz") sind keine Werkzeuge
    if "%name of {_ci}%" contains "Team" or "Schmiede" or "Heal" or "Falle" or "Trap":
        stop
    # im Upgrade-Shop gibt es keine Werkzeuge (z.B. Abbaulähmung-Falle mit Spitzhacken-Symbol)
    if "%name of player's current inventory%" contains "Upgrade":
        stop
    # Quickbuy-Edit-Modus: Item wird nur gespeichert, nicht gekauft -> nie blockieren
    if bwQbEditing(player) is true:
        stop
    if {_ci} is shears:
        if player has shears:
            cancel event
            send "&cDu besitzt bereits eine Schere!" to player
            stop
    set {_s} to "%type of {_ci}%"
    if {_s} contains "pickaxe":
        set {_best} to 0
        loop all items in player's inventory:
            if "%type of loop-item%" contains "pickaxe":
                if toolTier(loop-item) > {_best}:
                    set {_best} to toolTier(loop-item)
        if (toolTier({_ci})) <= {_best}:
            cancel event
            send "&cDu besitzt bereits diese oder eine bessere Spitzhacke!" to player
    else if {_s} contains "axe":
        set {_best} to 0
        loop all items in player's inventory:
            if "%type of loop-item%" contains "axe":
                if "%type of loop-item%" does not contain "pickaxe":
                    if toolTier(loop-item) > {_best}:
                        set {_best} to toolTier(loop-item)
        if (toolTier({_ci})) <= {_best}:
            cancel event
            send "&cDu besitzt bereits diese oder eine bessere Axt!" to player

# Stufen merken, niedrigere Stufen und Duplikate entfernen
every 10 ticks:
    loop all players:
        if gamemode of loop-player is survival:
            if bwTeam(loop-player) is not "none":
                set {_bp} to 0
                set {_ba} to 0
                set {_sh} to false
                loop all items in loop-player's inventory:
                    set {_s} to "%type of loop-item%"
                    if {_s} contains "pickaxe":
                        if toolTier(loop-item) > {_bp}:
                            set {_bp} to toolTier(loop-item)
                    else if {_s} contains "axe":
                        if toolTier(loop-item) > {_ba}:
                            set {_ba} to toolTier(loop-item)
                    else if loop-item is shears:
                        set {_sh} to true
                delete {_rm::*}
                delete {_seenP}
                delete {_seenA}
                delete {_seenS}
                loop all items in loop-player's inventory:
                    set {_s} to "%type of loop-item%"
                    if {_s} contains "pickaxe":
                        if toolTier(loop-item) < {_bp}:
                            add loop-item to {_rm::*}
                        else if {_seenP} is set:
                            add loop-item to {_rm::*}
                        else:
                            set {_seenP} to true
                    else if {_s} contains "axe":
                        if toolTier(loop-item) < {_ba}:
                            add loop-item to {_rm::*}
                        else if {_seenA} is set:
                            add loop-item to {_rm::*}
                        else:
                            set {_seenA} to true
                    else if loop-item is shears:
                        if {_seenS} is set:
                            add loop-item to {_rm::*}
                        else:
                            set {_seenS} to true
                if size of {_rm::*} > 0:
                    remove {_rm::*} from loop-player's inventory
                set {-bw::tt::%uuid of loop-player%::pick} to {_bp}
                set {-bw::tt::%uuid of loop-player%::axe} to {_ba}
                set {-bw::tt::%uuid of loop-player%::shears} to {_sh}

# Beim Tod: immer Holzspitzhacke + Holzaxt zurück (wenn vorher vorhanden), Schere bleibt
on death of player:
    set {_u} to uuid of victim
    if {-bw::tt::%{_u}%::pick} > 0:
        set {-bw::tr::%{_u}%::pick} to 1
    if {-bw::tt::%{_u}%::axe} > 0:
        set {-bw::tr::%{_u}%::axe} to 1
    if {-bw::tt::%{_u}%::shears} is true:
        set {-bw::tr::%{_u}%::shears} to true
    set {-bw::tr::%{_u}%::time} to now

every 10 ticks:
    loop all players:
        set {_u} to uuid of loop-player
        if {-bw::tr::%{_u}%::time} is set:
            if gamemode of loop-player is survival:
                if difference between {-bw::tr::%{_u}%::time} and now is greater than 3 seconds:
                    # alles andere (z.B. von SBA zurückgestufte Werkzeuge) entfernen, dann Holz geben
                    loop all items in loop-player's inventory:
                        set {_s} to "%type of loop-item%"
                        if {_s} contains "pickaxe" or "axe":
                            add loop-item to {_old::*}
                    if size of {_old::*} > 0:
                        remove {_old::*} from loop-player's inventory
                    delete {_old::*}
                    if {-bw::tr::%{_u}%::pick} is set:
                        give wooden pickaxe to loop-player
                    if {-bw::tr::%{_u}%::axe} is set:
                        give wooden axe to loop-player
                    if {-bw::tr::%{_u}%::shears} is true:
                        if loop-player does not have shears:
                            give shears to loop-player
                    delete {-bw::tr::%{_u}%::*}
                    set {-bw::tr_guard::%{_u}%} to now
                    bwArrangeLater(loop-player)

# Kurz nach dem Respawn: von SBA zurückgestufte Werkzeuge (Stein/Eisen/...) entfernen
every 10 ticks:
    loop all players:
        set {_u} to uuid of loop-player
        if {-bw::tr_guard::%{_u}%} is set:
            if difference between {-bw::tr_guard::%{_u}%} and now is less than 5 seconds:
                loop all items in loop-player's inventory:
                    set {_s} to "%type of loop-item%"
                    if {_s} contains "pickaxe" or "axe":
                        if toolTier(loop-item) > 1:
                            add loop-item to {_rm2::*}
                if size of {_rm2::*} > 0:
                    remove {_rm2::*} from loop-player's inventory
                delete {_rm2::*}
            else:
                delete {-bw::tr_guard::%{_u}%}

# =========================================================
# 10. RESET BEIM LEAVEN
# =========================================================
on command "/bw leave":
    bwCheckEmpty(world of player, player)
    delete {bw::invis::%player%}
    delete {bw::invis_armor::%player%::*}
    delete {bw::invis_token::%player%}
    delete {-bw::tt::%uuid of player%::*}
    delete {-bw::tr::%uuid of player%::*}
    delete {-bw::tc::%uuid of player%}

on quit:
    bwCheckEmpty(world of player, player)
    delete {bw::invis::%player%}
    delete {bw::invis_armor::%player%::*}
    delete {bw::invis_token::%player%}
    delete {-bw::tt::%uuid of player%::*}
    delete {-bw::tr::%uuid of player%::*}
    delete {-bw::tc::%uuid of player%}

on world change:
    bwCheckEmpty(past world, player)
    delete {bw::invis::%player%}
    delete {bw::invis_armor::%player%::*}
    delete {bw::invis_token::%player%}
    delete {-bw::tt::%uuid of player%::*}
    delete {-bw::tr::%uuid of player%::*}
    delete {-bw::tc::%uuid of player%}

# =========================================================
# 11. QUICKSHOP (eigenes System, Klick auf freien Slot -> Menü mit allen Kategorien)
# =========================================================
# Auf der Shop-Hauptseite (Reihe 5 + 6) zeigt das Skript deine 14 Quickshop-Slots an.
#  - freier Slot / Rechtsklick: öffnet ein Menü mit allen Kategorien, erst ein Klick auf ein Item legt es dort ab
#  - Linksklick auf einen belegten Slot: kauft das Item
# Der SBA-eigene Quickbuy wird dadurch nicht mehr benutzt (Klicks auf die Slots werden abgefangen).
# Spezial-Items (TNT, Feuerball, Schaf, Golem, Plattform, Ei, Popup Tower, Tränke) werden beim ersten
# normalen Kauf im Shop automatisch "gelernt" und stehen danach im Quickshop zur Verfügung.
function bwRes(p: player, r: text) :: number:
    set {_n} to 0
    loop all items in {_p}'s inventory:
        if "%type of loop-item%" contains {_r}:
            add item amount of loop-item to {_n}
    return {_n}

# Quickshop-Slots in der Shop-Hauptseite: Reihe 5 (Slots 1-7) und Reihe 6 (Slots 8-14)
function bwQbId(i: number) :: number:
    loop 7 times:
        if {_i} is (36 + loop-number):
            return loop-number
    loop 7 times:
        if {_i} is (45 + loop-number):
            return 7 + loop-number
    return 0

# (wird von Abschnitt 9 abgefragt; der Edit-Modus des SBA-Quickbuys wird nicht mehr genutzt)
function bwQbEditing(p: player) :: boolean:
    return false

function bwTeamWool(t: text) :: item:
    if {_t} is "red":
        return red wool
    if {_t} is "blue":
        return blue wool
    if {_t} is "yellow":
        return yellow wool
    if {_t} is "lime":
        return lime wool
    if {_t} is "green":
        return green wool
    if {_t} is "cyan":
        return cyan wool
    if {_t} is "pink":
        return pink wool
    if {_t} is "gray":
        return gray wool
    if {_t} is "light_gray":
        return light gray wool
    if {_t} is "orange":
        return orange wool
    if {_t} is "magenta":
        return magenta wool
    if {_t} is "light_blue":
        return light blue wool
    if {_t} is "black":
        return black wool
    if {_t} is "brown":
        return brown wool
    return white wool

# Team-Upgrades (Schärfe / Effizienz) auf neu gekaufte Items anwenden
function bwTeamEnch(i: item, p: player, kind: text) :: item:
    set {_k} to bwKey({_p})
    set {_lv} to {bw::up::%{_k}%::%{_kind}%}
    if {_lv} > 0:
        if {_kind} is "sharp":
            if {_lv} >= 2:
                enchant {_i} with sharpness 2
            else:
                enchant {_i} with sharpness 1
        else:
            if {_lv} >= 2:
                enchant {_i} with efficiency 2
            else:
                enchant {_i} with efficiency 1
    return {_i}

