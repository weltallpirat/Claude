function bwQsItem(id: text, p: player) :: item:
    if {_id} is "wool":
        set {_i} to bwTeamWool(bwTeam({_p}))
        set item amount of {_i} to 16
        return {_i}
    if {_id} is "packed_ice":
        set {_i} to packed ice
        set item amount of {_i} to 4
        return {_i}
    if {_id} is "glass":
        set {_i} to glass
        set item amount of {_i} to 8
        return {_i}
    if {_id} is "end_stone":
        set {_i} to end stone
        set item amount of {_i} to 12
        return {_i}
    if {_id} is "planks":
        set {_i} to oak planks
        set item amount of {_i} to 16
        return {_i}
    if {_id} is "iron_block":
        set {_i} to iron block
        return {_i}
    if {_id} is "ladder":
        set {_i} to ladder
        set item amount of {_i} to 4
        return {_i}
    if {_id} is "stick":
        set {_i} to stick named "&aKnockback Stick"
        enchant {_i} with knockback 1
        return {_i}
    if {_id} is "stone_sword":
        set {_i} to stone sword
        return bwTeamEnch({_i}, {_p}, "sharp")
    if {_id} is "iron_sword":
        set {_i} to iron sword
        return bwTeamEnch({_i}, {_p}, "sharp")
    if {_id} is "diamond_sword":
        set {_i} to diamond sword
        return bwTeamEnch({_i}, {_p}, "sharp")
    if {_id} is "bow":
        set {_i} to bow
        return {_i}
    if {_id} is "bow_power":
        set {_i} to bow
        enchant {_i} with power 1
        return {_i}
    if {_id} is "bow_punch":
        set {_i} to bow
        enchant {_i} with power 1
        enchant {_i} with punch 1
