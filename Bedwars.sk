function bwQsCatIds(c: text) :: texts:
    if {_c} is "blocks":
        return "wool", "packed_ice", "glass", "end_stone", "planks", "iron_block" and "ladder"
    if {_c} is "melee":
        return "stick", "stone_sword", "iron_sword" and "diamond_sword"
    if {_c} is "ranged":
        return "bow", "bow_power", "bow_punch" and "arrow"
    if {_c} is "tools":
        return "wooden_pickaxe", "stone_pickaxe", "iron_pickaxe", "wooden_axe", "stone_axe", "iron_axe" and "shears"
    if {_c} is "potions":
        return "potion_invisibility", "potion_jump" and "potion_speed"
    if {_c} is "utility":
        return "golden_apple", "ender_pearl", "wind_charge", "windkanone", "teamchest", "tnt", "tnt_sheep", "fireball", "golem", "bridge_egg", "popup_tower" and "rescue_platform"
    return "none"

function bwQsIcon(id: text, p: player) :: item:
    if {bw::tpl::%{_id}%} is set:
        return {bw::tpl::%{_id}%}
    if {_id} is "tnt":
        return tnt
    if {_id} is "tnt_sheep":
        return sheep spawn egg
    if {_id} is "fireball":
        return fire charge
    if {_id} is "golem":
        return ghast spawn egg
    if {_id} is "bridge_egg":
        return egg
    if {_id} is "popup_tower":
        return chest
    if {_id} is "rescue_platform":
        return blaze rod
    if {_id} is "potion_invisibility":
        return potion
    if {_id} is "potion_jump":
        return potion
    if {_id} is "potion_speed":
        return potion
    if {_id} is "bow_power":
        return bow
    if {_id} is "bow_punch":
        return bow
    return bwQsItem({_id}, {_p})

function bwQsPay(p: player, res: text, amt: number):
    if {_res} is "iron ingot":
        remove {_amt} of iron ingot from {_p}'s inventory
    else if {_res} is "gold ingot":
        remove {_amt} of gold ingot from {_p}'s inventory
    else:
        remove {_amt} of emerald from {_p}'s inventory

# Besitz-Regeln (wie im normalen Shop): Schere nur 1x, Spitzhacke/Axt nur wenn besser
function bwQsBlocked(p: player, id: text) :: text:
    if {_id} is "shears":
        if {_p} has shears:
            return "Du besitzt bereits eine Schere!"
    if {_id} contains "pickaxe":
        set {_t} to 1
        if {_id} contains "stone":
            set {_t} to 2
        if {_id} contains "iron":
            set {_t} to 3
        loop all items in {_p}'s inventory:
            if "%type of loop-item%" contains "pickaxe":
                if toolTier(loop-item) >= {_t}:
                    return "Du besitzt bereits diese oder eine bessere Spitzhacke!"
    else if {_id} contains "axe":
        set {_t} to 1
        if {_id} contains "stone":
            set {_t} to 2
        if {_id} contains "iron":
            set {_t} to 3
        loop all items in {_p}'s inventory:
            if "%type of loop-item%" contains "axe":
                if "%type of loop-item%" does not contain "pickaxe":
                    if toolTier(loop-item) >= {_t}:
                        return "Du besitzt bereits diese oder eine bessere Axt!"
    return ""

function bwQsBuy(p: player, id: text):
    set {_blocked} to bwQsBlocked({_p}, {_id})
    if {_blocked} is not "":
        send action bar "&c%{_blocked}%" to {_p}
        stop
    set {_amt} to bwQsAmt({_id})
    set {_res} to bwQsRes({_id})
    if bwRes({_p}, {_res}) < {_amt}:
        send action bar "&cNicht genug Ressourcen!" to {_p}
        play sound "entity.villager.no" with volume 1 and pitch 1 to {_p}
        stop
    if {bw::tpl::%{_id}%} is not set:
        if {_id} is "tnt" or "tnt_sheep" or "fireball" or "golem" or "bridge_egg" or "popup_tower" or "rescue_platform" or "potion_invisibility" or "potion_jump" or "potion_speed":
            send action bar "&eDieses Item muss einmal normal im Shop gekauft werden, danach geht es im Quickshop." to {_p}
            stop
    set {_it} to bwQsItem({_id}, {_p})
    bwQsPay({_p}, {_res}, {_amt})
    give {_it} to {_p}
    play sound "entity.item.pickup" with volume 1 and pitch 1 to {_p}
    wait 2 ticks
    bwArrange({_p})

# --- Anzeige der Slots in der Shop-Hauptseite ---
function bwQsRender(p: player):
    set {_t} to "%name of {_p}'s current inventory%"
    if {_t} does not contain "shop":
        stop
    set {_probe} to slot 37 of {_p}'s current inventory
    if "%lore of {_probe}%" does not contain "Quickbuy-Slot":
        stop
    loop 14 times:
        set {_q} to loop-number
        set {_idx} to 36 + {_q}
        if {_q} > 7:
            set {_idx} to 38 + {_q}
        set {_id} to {bw::qb::%uuid of {_p}%::%{_q}%}
        if {_id} is set:
            set {_x} to bwQsIcon({_id}, {_p})
            set lore of {_x} to "&7Preis: &f%bwQsAmt({_id})% %bwQsRes({_id})%" and "&aLinksklick: kaufen &8| &eRechtsklick: ändern" and "&8Quickbuy-Slot #%{_q}%"
        else:
            set {_x} to red stained glass pane named "&cLeerer Quickbuy-Slot"
            set lore of {_x} to "&7Klicke, um ein Item auszuwählen." and "&8Quickbuy-Slot #%{_q}%"
        set slot {_idx} of {_p}'s current inventory to {_x}

on inventory open:
    set {_p} to player
    wait 3 ticks
    bwQsRender({_p})

on inventory click:
    set {_p} to player
    if "%name of {_p}'s current inventory%" contains "shop":
        wait 3 ticks
        bwQsRender({_p})

# --- Auswahl-Menüs: erst Kategorien, dann Items ---
function bwQsOpenCats(p: player):
    delete {-bw::qsmap::%uuid of {_p}%::*}
    set {_inv} to chest inventory with 3 rows named "&8Quickshop: Kategorie"
    set {_x} to white wool named "&aBlöcke"
    set lore of {_x} to "&7Klicken, um Items dieser Kategorie zu sehen"
    set slot 10 of {_inv} to {_x}
    set {-bw::qsmap::%uuid of {_p}%::10} to "cat_blocks"
    set {_x} to golden sword named "&aNahkampf"
    set lore of {_x} to "&7Klicken, um Items dieser Kategorie zu sehen"
    set slot 11 of {_inv} to {_x}
    set {-bw::qsmap::%uuid of {_p}%::11} to "cat_melee"
    set {_x} to bow named "&aFernkampf"
    set lore of {_x} to "&7Klicken, um Items dieser Kategorie zu sehen"
    set slot 12 of {_inv} to {_x}
    set {-bw::qsmap::%uuid of {_p}%::12} to "cat_ranged"
    set {_x} to stone pickaxe named "&aWerkzeuge"
    set lore of {_x} to "&7Klicken, um Items dieser Kategorie zu sehen"
    set slot 13 of {_inv} to {_x}
    set {-bw::qsmap::%uuid of {_p}%::13} to "cat_tools"
    set {_x} to brewing stand named "&aTränke"
    set lore of {_x} to "&7Klicken, um Items dieser Kategorie zu sehen"
    set slot 14 of {_inv} to {_x}
    set {-bw::qsmap::%uuid of {_p}%::14} to "cat_potions"
    set {_x} to tnt named "&aSpezial"
    set lore of {_x} to "&7Klicken, um Items dieser Kategorie zu sehen"
    set slot 15 of {_inv} to {_x}
    set {-bw::qsmap::%uuid of {_p}%::15} to "cat_utility"
    set {_x} to arrow named "&7Zurück zum Shop"
    set slot 22 of {_inv} to {_x}
    set {-bw::qsmap::%uuid of {_p}%::22} to "shop"
    open {_inv} to {_p}

function bwQsOpenItems(p: player, c: text):
    delete {-bw::qsmap::%uuid of {_p}%::*}
    set {_inv} to chest inventory with 4 rows named "&8Quickshop: Item wählen"
    set {_n} to 0
    loop bwQsCatIds({_c}):
        set {_id} to loop-value
        set {_x} to bwQsIcon({_id}, {_p})
        set name of {_x} to "&a%bwQsLabel({_id})%"
        set lore of {_x} to "&7Preis: &f%bwQsAmt({_id})% %bwQsRes({_id})%" and "&eKlicken, um das Item in den Slot zu legen"
        set slot {_n} of {_inv} to {_x}
        set {-bw::qsmap::%uuid of {_p}%::%{_n}%} to {_id}
        add 1 to {_n}
    set {_x} to arrow named "&7Zurück"
    set slot 31 of {_inv} to {_x}
    set {-bw::qsmap::%uuid of {_p}%::31} to "cats"
    open {_inv} to {_p}

# Klick auf einen Quickshop-Slot in der Shop-Hauptseite
on inventory click with priority lowest:
    set {_ci} to event-item
    if {_ci} is not set:
        stop
    if "%lore of {_ci}%" does not contain "Quickbuy-Slot":
        stop
    if "%name of player's current inventory%" does not contain "shop":
        stop
    cancel event
    set {_p} to player
    set {_qs} to 0
    loop 54 times:
        if clicked slot is (loop-number - 1):
            set {_qs} to bwQbId(loop-number - 1)
    if {_qs} is 0:
        stop
    set {_id} to {bw::qb::%uuid of {_p}%::%{_qs}%}
    if {_id} is set:
        if click type is left mouse button or left mouse button with shift:
            bwQsBuy({_p}, {_id})
            stop
    set {-bw::qs_slot::%uuid of {_p}%} to {_qs}
    set {-bw::qs_inv::%uuid of {_p}%} to {_p}'s current inventory
    wait 1 tick
    bwQsOpenCats({_p})

# Klicks in den Auswahl-Menüs
on inventory click:
    set {_t} to "%name of player's current inventory%"
    if {_t} contains "Quickshop: Kategorie" or "Quickshop: Item":
        cancel event
        set {_p} to player
        set {_u} to uuid of {_p}
        set {_key} to "none"
        loop 54 times:
            set {_s} to loop-number - 1
            if clicked slot is {_s}:
                if {-bw::qsmap::%{_u}%::%{_s}%} is set:
                    set {_key} to {-bw::qsmap::%{_u}%::%{_s}%}
        if {_key} is "none":
            stop
        if {_key} is "shop" or "cats":
            wait 1 tick
            if {_key} is "shop":
                open {-bw::qs_inv::%{_u}%} to {_p}
                wait 3 ticks
                bwQsRender({_p})
            else:
                bwQsOpenCats({_p})
            stop
        if {_key} starts with "cat_":
            set {_c} to {_key}
            replace all "cat_" with "" in {_c}
            wait 1 tick
            bwQsOpenItems({_p}, {_c})
            stop
        # ein Item wurde gewählt -> in den Slot legen und zurück zum Shop
        set {_slot} to {-bw::qs_slot::%{_u}%}
        if {_slot} is not set:
            stop
        set {bw::qb::%{_u}%::%{_slot}%} to {_key}
        send "&aQuickshop-Slot &f%{_slot}% &a= &f%bwQsLabel({_key})%" to {_p}
        wait 1 tick
        open {-bw::qs_inv::%{_u}%} to {_p}
        wait 3 ticks
        bwQsRender({_p})

# Spezial-Items beim ersten normalen Kauf "lernen" (damit sie im Quickshop kaufbar sind)
on inventory click with priority lowest:
    set {_ci} to event-item
    if {_ci} is not set:
        stop
    if "%lore of {_ci}%" does not contain "Price":
        stop
    if "%lore of {_ci}%" contains "Quickbuy-Slot":
        stop
    set {_id0} to bwItemId({_ci})
    set {_want} to false
    if {_id0} is "tnt" or "tnt_sheep" or "fireball" or "golem" or "bridge_egg" or "popup_tower" or "rescue_platform" or "potion_invisibility" or "potion_jump" or "potion_speed":
        set {_want} to true
    if {_want} is false:
        stop
    if {bw::tpl::%{_id0}%} is set:
        stop
    set {_p} to player
    loop 36 times:
        set {_i} to loop-number - 1
        set {_b::%{_i}%} to "%slot {_i} of {_p}'s inventory%"
    wait 3 ticks
    loop 36 times:
        set {_i} to loop-number - 1
        if "%slot {_i} of {_p}'s inventory%" is not {_b::%{_i}%}:
            set {_n} to slot {_i} of {_p}'s inventory
            if {_n} is not air:
                if bwItemId({_n}) is {_id0}:
                    set {bw::tpl::%{_id0}%} to {_n}
                    set item amount of {bw::tpl::%{_id0}%} to 1
                    exit loop

# Team-Upgrades merken (Schärfe / Effizienz), damit Quickshop-Items sie bekommen
on inventory click with priority lowest:
    set {_ci} to event-item
    if {_ci} is not set:
        stop
    set {_n} to "%name of {_ci}%"
    set {_kind} to "none"
    if {_n} contains "Schärfe":
        set {_kind} to "sharp"
    else if {_n} contains "Effizienz":
        set {_kind} to "eff"
    if {_kind} is "none":
        stop
    set {_p} to player
    set {_k} to bwKey({_p})
    set {_before} to diamondCount({_p})
    wait 3 ticks
    if diamondCount({_p}) < {_before}:
        add 1 to {bw::up::%{_k}%::%{_kind}%}

# =========================================================
# 12. HOTBAR-EINSTELLUNGEN: /settings
# =========================================================
# Für jedes einzelne Item, jede Unterkategorie (Schwerter, Äxte, ...) und jede Hauptkategorie
# (Waffen, Werkzeuge, ...) kann ein Hotbar-Slot (1-9) gewählt werden.
# Gruppen belegen ab dem gewählten Slot fortlaufend Slots (z.B. Werkzeuge ab Slot 4:
# Spitzhacke 4, Axt 5, Schere 6). Vorrang: Einzelnes Item > Unterkategorie > Hauptkategorie.
# Sortiert wird nach jedem Kauf im Shop, nach jedem Respawn und über /settings -> "Jetzt sortieren".
# Liegt ein anderes Item im Weg, wird es in einen freien Inventarplatz verschoben.
function bwItemId(i: item) :: text:
    set {_n} to "%type of {_i}%"
    if {_n} contains "potion" or "bottle":
        set {_nm} to "%name of {_i}%"
        if {_nm} contains "Invisib":
            return "potion_invisibility"
        if {_nm} contains "Jump":
            return "potion_jump"
        if {_nm} contains "Speed":
            return "potion_speed"
        return "none"
    if {_n} contains "stained glass pane":
        return "none"
    if {_n} contains "wool":
        return "wool"
    if {_n} contains "glass":
        return "glass"
    if {_n} contains "sheep spawn egg":
        return "tnt_sheep"
    if {_n} contains "ghast spawn egg":
        return "golem"
    if {_n} contains "spawn egg":
        return "none"
    if {_n} contains "boots" or "helmet" or "chestplate" or "leggings":
        return "none"
    if {_n} contains "ender chest":
        return "teamchest"
    if {_n} contains "chest":
        return "popup_tower"
    if {_n} contains "nautilus":
        return "windkanone"
    if {_n} contains "blaze rod":
        return "rescue_platform"
    if {_n} contains "fire charge":
        return "fireball"
    if {_n} contains "planks":
        return "planks"
    if {_n} is "egg":
        return "bridge_egg"
    replace all " " with "_" in {_n}
    return {_n}

# Unterkategorie eines Items (für /settings -> Unterkategorien)
function bwSub(id: text) :: text:
    if {_id} contains "pickaxe":
        return "pickaxes"
    if {_id} contains "axe":
        return "axes"
    if {_id} contains "sword":
        return "swords"
    if {_id} is "stick":
        return "swords"
    if {_id} is "bow":
        return "bows"
    if {_id} is "arrow":
        return "arrows"
    if {_id} is "shears":
        return "shears"
    if {_id} is "wool" or "planks" or "end_stone" or "glass" or "packed_ice" or "ladder" or "iron_block":
        return "blocks"
    if {_id} starts with "potion_":
        return "potions"
    if {_id} is "golden_apple":
        return "food"
    if {_id} is "tnt" or "tnt_sheep" or "fireball":
        return "explosives"
    if {_id} is "ender_pearl" or "wind_charge" or "windkanone" or "rescue_platform" or "bridge_egg":
        return "mobility"
    if {_id} is "teamchest" or "golem" or "popup_tower":
        return "special"
    return "none"

# Hauptkategorie einer Unterkategorie (entspricht den Shop-Kategorien)
function bwCat(sub: text) :: text:
    if {_sub} is "swords" or "bows" or "arrows":
        return "melee"
    if {_sub} is "pickaxes" or "axes" or "shears":
        return "tools"
    if {_sub} is "blocks":
        return "blocks"
    if {_sub} is "potions":
        return "potions"
    if {_sub} is "food" or "explosives" or "mobility" or "special":
        return "utility"
    return "none"

# feste Reihenfolge, in der Gruppen-Items nacheinander einsortiert werden
function bwAllIds() :: texts:
    return "wooden_sword", "stone_sword", "iron_sword", "diamond_sword", "stick", "bow", "arrow", "wooden_pickaxe", "stone_pickaxe", "iron_pickaxe", "wooden_axe", "stone_axe", "iron_axe", "shears", "wool", "planks", "end_stone", "glass", "packed_ice", "ladder", "iron_block", "golden_apple", "tnt", "tnt_sheep", "fireball", "ender_pearl", "wind_charge", "windkanone", "rescue_platform", "teamchest", "golem", "bridge_egg", "popup_tower", "potion_invisibility", "potion_jump" and "potion_speed"

# gewählter Hotbar-Slot (1-9) für einen Schlüssel, 0 = automatisch
function bwPref(p: player, k: text) :: number:
    set {_v} to {bw::islot::%uuid of {_p}%::%{_k}%}
    if {_v} is set:
        return {_v}
    return 0

# erster freier Inventarplatz: erst das Hauptinventar (9-35), dann die Hotbar (0-8); -1 = voll
function bwFreeSlot(p: player) :: number:
    loop 27 times:
        set {_s} to loop-number + 8
        set {_x} to slot {_s} of {_p}'s inventory
        if {_x} is air:
            return {_s}
    loop 9 times:
        set {_s} to loop-number - 1
        set {_x} to slot {_s} of {_p}'s inventory
        if {_x} is air:
            return {_s}
    return -1

function bwArrange(p: player):
    if {_p} is not online:
        stop
    set {_u} to uuid of {_p}
    delete {_idv::*}
    delete {_tgt::*}
    delete {_taken::*}
    delete {_lift::*}
    delete {_order::*}
    # 1. Items erfassen
    set {_i} to 0
    while {_i} < 36:
        set {_it} to slot {_i} of {_p}'s inventory
        if {_it} is not air:
            set {_idv::%{_i}%} to bwItemId({_it})
        add 1 to {_i}
    # 2. einzelne Items (höchster Vorrang)
    set {_i} to 0
    while {_i} < 36:
        set {_id} to {_idv::%{_i}%}
        if {_id} is set:
            if {_id} is not "none":
                set {_pr} to bwPref({_p}, {_id})
                if {_pr} > 0:
                    set {_t} to {_pr} - 1
                    if {_taken::%{_t}%} is not set:
                        set {_tgt::%{_i}%} to {_t}
                        set {_taken::%{_t}%} to true
        add 1 to {_i}
    # 3. Gruppen: erst Unterkategorien (Stufe 1), dann Hauptkategorien (Stufe 2)
    set {_order::*} to bwAllIds()
    set {_i} to 0
    while {_i} < 36:
        set {_id} to {_idv::%{_i}%}
        if {_id} is set:
            if {_id} is not "none":
                if {_order::*} does not contain {_id}:
                    add {_id} to {_order::*}
        add 1 to {_i}
    set {_lvl} to 1
    while {_lvl} <= 2:
        set {_oi} to 1
        while {_oi} <= size of {_order::*}:
            set {_oid} to {_order::%{_oi}%}
            set {_i} to 0
            while {_i} < 36:
                if {_idv::%{_i}%} is {_oid}:
                    if {_tgt::%{_i}%} is not set:
                        set {_sb} to bwSub({_oid})
                        if {_lvl} is 1:
                            set {_pr} to bwPref({_p}, "sub_%{_sb}%")
                        else:
                            set {_pr} to bwPref({_p}, "cat_%bwCat({_sb})%")
                        if {_pr} > 0:
                            set {_k} to 0
                            while {_k} < 9:
                                set {_t} to ({_pr} - 1) + {_k}
                                if {_t} > 8:
                                    subtract 9 from {_t}
                                if {_taken::%{_t}%} is not set:
                                    set {_tgt::%{_i}%} to {_t}
                                    set {_taken::%{_t}%} to true
                                    set {_k} to 99
                                else:
                                    add 1 to {_k}
                add 1 to {_i}
            add 1 to {_oi}
        add 1 to {_lvl}
    # 4. alle Items, die umziehen müssen, aus dem Inventar nehmen
    set {_i} to 0
    while {_i} < 36:
        if {_tgt::%{_i}%} is set:
            if {_tgt::%{_i}%} is not {_i}:
                set {_lift::%{_i}%} to slot {_i} of {_p}'s inventory
                set slot {_i} of {_p}'s inventory to air
        add 1 to {_i}
    # 5. auf den Zielslots ablegen; liegt dort etwas anderes, wandert es in einen freien Platz
    set {_t} to 0
    while {_t} < 9:
        set {_i} to 0
        while {_i} < 36:
            if {_lift::%{_i}%} is set:
                if {_tgt::%{_i}%} is {_t}:
                    set {_cur} to slot {_t} of {_p}'s inventory
                    if {_cur} is not air:
                        set {_f} to bwFreeSlot({_p})
                        if {_f} < 0:
                            set {_f} to {_i}
                        set slot {_f} of {_p}'s inventory to {_cur}
                    set slot {_t} of {_p}'s inventory to {_lift::%{_i}%}
                    delete {_lift::%{_i}%}
            add 1 to {_i}
        add 1 to {_t}

function bwArrangeLater(p: player):
    wait 5 ticks
    bwArrange({_p})
    # zweiter Durchgang, falls SBW/SBA danach noch Start-Items gibt
    wait 20 ticks
    bwArrange({_p})

# Nach jedem Respawn sortieren
on respawn:
    bwArrangeLater(player)

# ---------------------------------------------------------
# Menüs
# ---------------------------------------------------------
function bwSetEntry(inv: inventory, s: number, id: text, icon: item, label: text, p: player):
    set {_cur} to {bw::islot::%uuid of {_p}%::%{_id}%}
    if {_cur} is not set:
        set {_cur} to "automatisch"
    set {_x} to {_icon}
    set name of {_x} to {_label}
    set lore of {_x} to "&7Slot: &f%{_cur}% &8| &eKlicken zum Ändern"
    set slot {_s} of {_inv} to {_x}
    set {-bw::setmap::%uuid of {_p}%::%{_s}%} to {_id}
    set {-bw::setlbl::%uuid of {_p}%::%{_s}%} to {_label}

# Gruppen-Eintrag: label = Name, desc = Inhalt (steht grau hinter dem Namen)
function bwSetGroup(inv: inventory, s: number, key: text, icon: item, label: text, desc: text, p: player):
    set {_cur} to {bw::islot::%uuid of {_p}%::%{_key}%}
    if {_cur} is not set:
        set {_cur} to "automatisch"
    set {_x} to {_icon}
    set name of {_x} to "%{_label}% &8(%{_desc}%)"
    set lore of {_x} to "&7Startslot: &f%{_cur}% &8| &eKlicken zum Ändern"
    set slot {_s} of {_inv} to {_x}
    set {-bw::setmap::%uuid of {_p}%::%{_s}%} to {_key}
    set {-bw::setlbl::%uuid of {_p}%::%{_s}%} to {_label}

function bwBackButton(inv: inventory, s: number, p: player):
    set {_x} to arrow named "&7Zurück"
    set slot {_s} of {_inv} to {_x}
    set {-bw::setmap::%uuid of {_p}%::%{_s}%} to "back"

function bwIcon(id: text) :: item:
    if {_id} is "wooden_sword":
        return wooden sword
    if {_id} is "stone_sword":
        return stone sword
    if {_id} is "iron_sword":
        return iron sword
    if {_id} is "diamond_sword":
        return diamond sword
    if {_id} is "stick":
        return stick
    if {_id} is "bow":
        return bow
    if {_id} is "arrow":
        return arrow
    if {_id} is "wooden_pickaxe":
        return wooden pickaxe
    if {_id} is "stone_pickaxe":
        return stone pickaxe
    if {_id} is "iron_pickaxe":
        return iron pickaxe
    if {_id} is "wooden_axe":
        return wooden axe
    if {_id} is "stone_axe":
        return stone axe
    if {_id} is "iron_axe":
        return iron axe
    if {_id} is "shears":
        return shears
    if {_id} is "planks":
        return oak planks
    if {_id} is "end_stone":
        return end stone
    if {_id} is "glass":
        return glass
    if {_id} is "packed_ice":
        return packed ice
    if {_id} is "ladder":
        return ladder
    if {_id} is "iron_block":
        return iron block
    if {_id} is "golden_apple":
        return golden apple
    if {_id} is "ender_pearl":
        return ender pearl
    if {_id} is "wind_charge":
        return wind charge
    if {_id} is "windkanone":
        return nautilus shell
    if {_id} is "teamchest":
        return ender chest
    if {_id} is "potion_invisibility" or "potion_jump" or "potion_speed":
        return potion
    return barrier

function openQuickshopMenu(p: player):
    delete {-bw::setmap::%uuid of {_p}%::*}
    delete {-bw::setlbl::%uuid of {_p}%::*}
    set {_inv} to chest inventory with 4 rows named "&8Hotbar: Quickshop"
    set {_x} to book named "&eSo änderst du deinen Quickshop"
    set lore of {_x} to "&7Im Item-Shop auf einen freien Quickshop-Slot klicken, ein Item wählen. Hier kannst du Slots leeren."
    set slot 4 of {_inv} to {_x}
    loop 14 times:
        set {_q} to loop-number
        set {_s} to 9 + {_q}
        if {_q} > 7:
            set {_s} to 11 + {_q}
        set {_id} to {bw::qb::%uuid of {_p}%::%{_q}%}
        if {_id} is not set:
            set {_x} to red stained glass pane named "&cQuickshop-Slot %{_q}% (leer)"
            set lore of {_x} to "&7Im Shop: Rechtsklick auf Slot %{_q}%, dann ein Item anklicken."
        else:
            set {_x} to bwQsIcon({_id}, {_p})
            set name of {_x} to "&aQuickshop-Slot %{_q}%"
            set lore of {_x} to "&7Item: &f%bwQsLabel({_id})% &8| &eKlicken: Slot leeren"
        set slot {_s} of {_inv} to {_x}
        set {-bw::setmap::%uuid of {_p}%::%{_s}%} to "qs_%{_q}%"
    bwBackButton({_inv}, 31, {_p})
    open {_inv} to {_p}

