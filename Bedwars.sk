    bwSetGroup({_inv}, 3, "sub_pickaxes", iron pickaxe, "&aSpitzhacken", "alle Spitzhacken", {_p})
    bwSetGroup({_inv}, 4, "sub_axes", iron axe, "&aÄxte", "alle Äxte", {_p})
    bwSetGroup({_inv}, 5, "sub_shears", shears, "&aSchere", "Schere", {_p})
    bwSetGroup({_inv}, 6, "sub_blocks", white wool, "&aBlöcke", "Wolle, Holz, Endstein, Glas, Eis, Leiter, Eisenblock", {_p})
    bwSetGroup({_inv}, 7, "sub_potions", potion, "&aTränke", "alle Tränke", {_p})
    bwSetGroup({_inv}, 8, "sub_food", golden apple, "&aEssen", "Goldener Apfel", {_p})
    bwSetGroup({_inv}, 9, "sub_explosives", tnt, "&aSprengstoff", "TNT, TNT-Schaf, Feuerball", {_p})
    bwSetGroup({_inv}, 10, "sub_mobility", ender pearl, "&aFortbewegung", "Enderperle, Wind Charge, Windkanone, Rettungsplattform, Brücken-Ei", {_p})
    bwSetGroup({_inv}, 11, "sub_special", ender chest, "&aSpezial", "Teamtruhe, Golem, Popup Tower", {_p})
    bwBackButton({_inv}, 31, {_p})
    open {_inv} to {_p}

function openCatSettings(p: player):
    delete {-bw::setmap::%uuid of {_p}%::*}
    delete {-bw::setlbl::%uuid of {_p}%::*}
    set {_inv} to chest inventory with 3 rows named "&8Hotbar: Hauptkategorie"
    bwSetGroup({_inv}, 11, "cat_melee", diamond sword, "&aWaffen", "Schwerter, Bögen, Pfeile", {_p})
    bwSetGroup({_inv}, 12, "cat_tools", iron pickaxe, "&aWerkzeuge", "Spitzhacken, Äxte, Schere", {_p})
    bwSetGroup({_inv}, 13, "cat_blocks", white wool, "&aBlöcke", "alle Blöcke", {_p})
    bwSetGroup({_inv}, 14, "cat_potions", potion, "&aTränke", "alle Tränke", {_p})
    bwSetGroup({_inv}, 15, "cat_utility", tnt, "&aUtility", "Essen, Sprengstoff, Fortbewegung, Spezial", {_p})
    bwBackButton({_inv}, 22, {_p})
    open {_inv} to {_p}

function openItemSlotMenu(p: player):
    set {_inv} to chest inventory with 2 rows named "&8Hotbar: Slot wählen"
    loop 9 times:
        set {_x} to lime stained glass pane named "&aHotbar-Slot %loop-number%"
        set slot (loop-number - 1) of {_inv} to {_x}
    set {_x} to barrier named "&cAutomatisch (kein fester Slot)"
    set slot 13 of {_inv} to {_x}
    open {_inv} to {_p}

command /bwsettings:
    aliases: settings, einstellungen
    trigger:
        openSettingsHome(player)

on inventory click:
    set {_t} to "%name of player's current inventory%"
    if {_t} does not contain "Hotbar:":
        stop
    cancel event
    set {_p} to player
    set {_u} to uuid of {_p}
    # Slot-Auswahl
    if {_t} contains "Slot wählen":
        set {_id} to {-bw::setitem::%{_u}%}
        if {_id} is not set:
            stop
        set {_lab} to {-bw::setlabel::%{_u}%}
        set {_n} to 0
        loop 9 times:
            if clicked slot is (loop-number - 1):
                set {_n} to loop-number
        if {_n} > 0:
            set {bw::islot::%{_u}%::%{_id}%} to {_n}
            send "&a%{_lab}% &7liegt jetzt im Hotbar-Slot &f%{_n}%&7." to {_p}
        else if clicked slot is 13:
            delete {bw::islot::%{_u}%::%{_id}%}
            send "&a%{_lab}% &7wird wieder automatisch einsortiert." to {_p}
        else:
            stop
        wait 1 tick
        bwArrange({_p})
        if {_id} starts with "sub_":
            openSubSettings({_p})
        else if {_id} starts with "cat_":
            openCatSettings({_p})
        else:
            openItemSettings({_p})
        stop
    # angeklickten Eintrag der anderen Menüs ermitteln
    set {_key} to "none"
    set {_lab} to ""
    loop 54 times:
        set {_s} to loop-number - 1
        if clicked slot is {_s}:
            if {-bw::setmap::%{_u}%::%{_s}%} is set:
                set {_key} to {-bw::setmap::%{_u}%::%{_s}%}
                set {_lab} to {-bw::setlbl::%{_u}%::%{_s}%}
    if {_key} is "none":
        stop
    # Startmenü: Sortierung | Quickshop
    if {_t} contains "Menü":
        if {_key} is "home_sort":
            wait 1 tick
            openSettingsMain({_p})
        else if {_key} is "home_qs":
            wait 1 tick
            openQuickshopMenu({_p})
        stop
    # Quickshop-Menü
    if {_t} contains "Quickshop":
        if {_key} is "back":
            wait 1 tick
            openSettingsHome({_p})
        else if {_key} starts with "qs_":
            set {_qn} to {_key}
            replace all "qs_" with "" in {_qn}
            delete {bw::qb::%{_u}%::%{_qn}%}
            send "&7Quickshop-Slot &f%{_qn}% &7wurde geleert." to {_p}
            wait 1 tick
            openQuickshopMenu({_p})
        stop
    # Hauptmenü
    if {_t} contains "Einstellungen":
        if {_key} is "main_items":
            wait 1 tick
            openItemSettings({_p})
        else if {_key} is "main_subs":
            wait 1 tick
            openSubSettings({_p})
        else if {_key} is "main_cats":
            wait 1 tick
            openCatSettings({_p})
        else if {_key} is "main_sort":
            bwArrange({_p})
            send "&aInventar wurde sortiert." to {_p}
        else if {_key} is "main_home":
            wait 1 tick
            openSettingsHome({_p})
        else if {_key} is "main_reset":
            delete {bw::islot::%{_u}%::*}
            send "&7Alle Slot-Einstellungen wurden zurückgesetzt." to {_p}
            wait 1 tick
            openSettingsMain({_p})
        stop
    # Item-, Unterkategorie- und Kategorie-Menü
    if {_key} is "back":
        wait 1 tick
        openSettingsMain({_p})
        stop
    set {-bw::setitem::%{_u}%} to {_key}
    set {-bw::setlabel::%{_u}%} to {_lab}
    wait 1 tick
    openItemSlotMenu({_p})

# Nach jedem Kauf im Shop (auch über Quickbuy) das Inventar nach den Einstellungen sortieren
on inventory click with priority lowest:
    set {_ci} to event-item
    if {_ci} is not set:
        stop
    set {_nm} to "%name of player's current inventory%"
    if {_nm} contains "Hotbar:":
        stop
    set {_trig} to false
    if "%lore of {_ci}%" contains "Price":
        set {_trig} to true
    if {_nm} contains "shop":
        set {_trig} to true
    if {_trig} is false:
        stop
    if "%type of {_ci}%" contains "glass pane":
        stop
    set {_p} to player
    wait 3 ticks
    bwArrange({_p})

# =========================================================
# 13. QUICKSHOP: GELERNTE SPEZIAL-ITEMS ANZEIGEN
# =========================================================
# /qsstatus          zeigt, welche Spezial-Items schon gelernt sind
# /qsstatus reset    vergisst alle gelernten Items (werden beim nächsten normalen Kauf neu gelernt)
command /qsstatus [<text>]:
    permission: op
    trigger:
        if arg-1 is "reset":
            delete {bw::tpl::*}
            send "&aAlle gelernten Spezial-Items wurden vergessen." to sender
            stop
        loop "tnt", "tnt_sheep", "fireball", "golem", "bridge_egg", "popup_tower", "rescue_platform", "potion_invisibility", "potion_jump" and "potion_speed":
            if {bw::tpl::%loop-value%} is set:
                send "&a✔ &f%bwQsLabel(loop-value)% &7(gelernt)" to sender
            else:
                send "&c✘ &f%bwQsLabel(loop-value)% &7(einmal im Shop kaufen)" to sender

# =========================================================
# 14. /chelp: siehe BedwarsExtras.sk (interaktives GUI)
# =========================================================


# =========================================================
# 15. SCHMIEDE (Forge): BONUS-EISEN UND BONUS-GOLD
# =========================================================
# Der Basis-Drop kommt AUSSCHLIESSLICH von SBW laut config.yml (resources):
#   iron = 1 Eisen alle 0,75 s, gold = 1 Gold alle 8 s  (fuer alle Arenen gleich)
# Das Skript aendert diesen Basis-Drop NIE. Es bricht ihn nicht ab und verschiebt ihn nicht.
# Dadurch bleibt der Takt immer exakt 0,75 s, auch mit Schmiede.
# Die Schmiede legt bei jedem Basis-Drop nur ZUSAETZLICHE Barren an dieselbe Stelle.
# Prozente gehen IMMER von der Grundmenge OHNE Schmiede aus (nichts wird multipliziert):
#   Stufe 1 = +50 %  -> Bonus 0,5 pro Drop  (abwechselnd +0 und +1)
#   Stufe 2 = +100 % -> Bonus 1 pro Drop
#   Stufe 3 = Smaragde alle 60 s (Iron/Gold bleiben +100 %)
#   Stufe 4 = +200 % -> Bonus 2 pro Drop (+ Smaragde weiterhin alle 60 s)
# Der Bruchteil (0,5) wird gemerkt und beim naechsten Drop addiert, es geht nichts verloren.
# Zuordnung Spawner -> Team: naechster Smaragd-Spawner (/emeraldspawner add <name> <team>)
# in {@forge_radius} Bloecken. Spawner ohne Team in der Naehe bekommen keinen Bonus.
function bwForgeKey(l: location) :: text:
    set {_best} to {@forge_radius}
    set {_k} to "none"
    loop {bw::esp::*}:
        if world of loop-value is world of {_l}:
            set {_d} to distance between loop-value and {_l}
            if {_d} <= {_best}:
                set {_best} to {_d}
                set {_k} to "%name of world of {_l}%|%{bw::espteam::%loop-index%}%"
    return {_k}

# Faktor der Gesamtmenge je Stufe (1 = Grundmenge ohne Schmiede)
function bwForgeMult(stage: number) :: number:
    if {_stage} >= 4:
        return 3
    if {_stage} >= 2:
        return 2
    if {_stage} >= 1:
        return 1.5
    return 1

# Legt den Schmiede-Bonus als zusaetzlichen Drop an die Stelle des Basis-Drops.
function bwForgeBonus(drp: item, loc: location, res: text):
    set {_key} to bwForgeKey({_loc})
    if {_key} is "none":
        stop
    set {_stage} to 0
    if {bw::forge::%{_key}%} is set:
        set {_stage} to {bw::forge::%{_key}%}
    set {_mult} to bwForgeMult({_stage})
    if {_mult} <= 1:
        stop
    set {_ck} to "%{_key}%|%{_res}%"
    set {_carry} to {bw::fcarry::%{_ck}%}
    if {_carry} is not set:
        set {_carry} to 0
    set {_bonus} to (item amount of {_drp}) * ({_mult} - 1) + {_carry}
    set {_n} to floor({_bonus})
    set {bw::fcarry::%{_ck}%} to {_bonus} - {_n}
    if {_n} > 0:
        set {_ex} to {_drp}
        set item amount of {_ex} to {_n}
        # Merker: dieser Drop loest unser eigenes "item spawn" nicht noch einmal aus
        set {-bw::selfdrop} to true
        drop {_ex} at {_loc} without velocity
        delete {-bw::selfdrop}

on item spawn of iron ingot:
    if "{@spawner_boost}" is not "true":
        stop
    if {-bw::selfdrop} is true:
        stop
    if "%name of event-item%" does not contain "Iron":
        stop
    bwForgeBonus(event-item, location of event-entity, "iron")

on item spawn of gold ingot:
    if "{@spawner_boost}" is not "true":
        stop
    if {-bw::selfdrop} is true:
        stop
    if "%name of event-item%" does not contain "Gold":
        stop
    bwForgeBonus(event-item, location of event-entity, "gold")


# =========================================================
# 15b. MAXIMALE ANZAHL AUF DEM BODEN: Diamanten und Smaragde
# =========================================================
# Es liegen nie mehr als {@max_diamonds} Diamanten und {@max_emeralds} Smaragde gleichzeitig an einem Spawner.
# Das Skript zählt alle Items (Stapelgröße) im Umkreis und bricht den nächsten Drop ab, wenn das Limit erreicht ist.
# Zusätzlich stehen die gleichen Limits (6 Diamanten / 4 Smaragde) in der sbaconfig.yml (upgrades.limit).
function bwGroundCount(l: location, kind: text) :: number:
    set {_n} to 0
    loop all entities in radius {@cap_radius} around {_l}:
        if loop-entity is a dropped item:
            set {_i} to item of loop-entity
            if {_kind} is "emerald":
                if {_i} is emerald:
                    add item amount of {_i} to {_n}
            else if {_kind} is "diamond":
                if {_i} is diamond:
                    add item amount of {_i} to {_n}
    return {_n}

on item spawn of emerald:
    if bwIsArena(world of event-entity) is not true:
        stop
    if bwGroundCount(location of event-entity, "emerald") >= {@max_emeralds}:
        cancel event

on item spawn of diamond:
    if bwIsArena(world of event-entity) is not true:
        stop
    if bwGroundCount(location of event-entity, "diamond") >= {@max_diamonds}:
        cancel event

# =========================================================
# 16. PUNKTE- UND LEVELSYSTEM
# =========================================================
# {bwp::pts::<uuid>} = ausgebbare Punkte (Glücksrad), {bwp::xp::<uuid>} = gesamte XP (sinkt nie -> Level)
# Punkte kommen über die SBW-Rewards (config.yml) per /bwpoints ...

# XP, die man von Level l zu l+1 braucht
function bwXpNeed(l: number) :: number:
    return 100 + 50 * {_l}

function bwLevelOf(xp: number) :: number:
    set {_l} to 1
    set {_x} to {_xp}
    while {_l} < {@max_level}:
        if {_x} < bwXpNeed({_l}):
            return {_l}
        subtract bwXpNeed({_l}) from {_x}
        add 1 to {_l}
    return {_l}

# XP, die im aktuellen Level schon gesammelt wurden
function bwXpInLevel(xp: number) :: number:
    set {_l} to 1
    set {_x} to {_xp}
    while {_l} < {@max_level}:
        if {_x} < bwXpNeed({_l}):
            return {_x}
        subtract bwXpNeed({_l}) from {_x}
        add 1 to {_l}
    return 0

function bwPts(u: text) :: number:
    if {bwp::pts::%{_u}%} is not set:
        return 0
    return {bwp::pts::%{_u}%}

function bwXp(u: text) :: number:
    if {bwp::xp::%{_u}%} is not set:
        return 0
    return {bwp::xp::%{_u}%}

function bwBar(cur: number, tot: number) :: text:
    set {_f} to floor(({_cur} / {_tot}) * 10)
    set {_s} to ""
    loop 10 times:
        if loop-number <= {_f}:
            set {_s} to "%{_s}%&a|"
        else:
            set {_s} to "%{_s}%&7|"
    return {_s}

function bwStatusLine(p: player) :: text:
    set {_u} to "%uuid of {_p}%"
    set {_xp} to bwXp({_u})
    set {_lv} to bwLevelOf({_xp})
    set {_cur} to bwXpInLevel({_xp})
    set {_need} to bwXpNeed({_lv})
    set {_bar} to bwBar({_cur}, {_need})
    return "&6✦ Level %{_lv}% &8[%{_bar}%&8] &7%{_cur}%/%{_need}% XP &8| &e%bwPts({_u})% Punkte"

function bwAddPoints(p: player, amount: number, reason: text):
    set {_u} to "%uuid of {_p}%"
    set {_xp} to bwXp({_u})
    set {_old} to bwLevelOf({_xp})
    set {bwp::xp::%{_u}%} to {_xp} + {_amount}
    set {bwp::pts::%{_u}%} to bwPts({_u}) + {_amount}
    set {_new} to bwLevelOf({_xp} + {_amount})
    send action bar "&6+%{_amount}% Punkte &7(%{_reason}%)" to {_p}
    if {_new} > {_old}:
        set {_bonus} to {_new} * 20
        add {_bonus} to {bwp::pts::%{_u}%}
        send title "&6&lLEVEL UP!" with subtitle "&eLevel %{_new}% &7(+%{_bonus}% Bonuspunkte)" to {_p} for 3 seconds
        send "&6&lLEVEL UP! &eDu bist jetzt &6Level %{_new}%&e. &7Bonus: &e+%{_bonus}% Punkte" to {_p}
        play sound "entity.player.levelup" with volume 1 and pitch 1 to {_p}
        # Level-Kosmetika (Level 5, 10, 20, ...) freischalten (steht in BedwarsExtras.sk)
        bwCosSync({_p}, true)

# Gesamt-XP, die man braucht, um Level l mit 0 XP im Level zu erreichen
function bwXpForLevel(l: number) :: number:
    set {_x} to 0
    set {_i} to 1
    while {_i} < {_l}:
        add bwXpNeed({_i}) to {_x}
        add 1 to {_i}
    return {_x}

# Admin: erhöht das Level um n (höchstens max_level). Der Fortschritt im Level bleibt erhalten,
# es gibt keine Bonuspunkte. Schaltet passende Level-Kosmetika frei.
function bwAddLevels(p: player, n: number):
    set {_u} to "%uuid of {_p}%"
    set {_xp} to bwXp({_u})
    set {_old} to bwLevelOf({_xp})
    set {_target} to {_old} + {_n}
    if {_target} > {@max_level}:
        set {_target} to {@max_level}
    set {bwp::xp::%{_u}%} to bwXpForLevel({_target}) + bwXpInLevel({_xp})
    set {_new} to bwLevelOf(bwXp({_u}))
    if {_new} > {_old}:
        send title "&6&lLEVEL UP!" with subtitle "&eLevel %{_new}%" to {_p} for 3 seconds
        send "&6&lLEVEL UP! &eEin Admin hat dein Level erhöht: &6Level %{_new}%" to {_p}
        play sound "entity.player.levelup" with volume 1 and pitch 1 to {_p}
        bwCosSync({_p}, true)

# Punkte OHNE XP (Admin-Vergabe): erhöht nur das ausgebbare Guthaben, nie XP/Level.
# (Glücksrad/Casino-Gewinne, /pay, Tagesbonus, Bank und Börse fassen XP ohnehin nie an.)
function bwGivePoints(p: player, amount: number, reason: text):
    set {_u} to "%uuid of {_p}%"
    set {bwp::pts::%{_u}%} to bwPts({_u}) + {_amount}
    send action bar "&6+%{_amount}% Punkte &7(%{_reason}%)" to {_p}

# Wird von den SBW-Rewards (config.yml) als Konsolenbefehl ausgeführt
command /bwpoints <text> <text>:
    permission: op
    usage: /bwpoints <join|kill|finalkill|bed|win> <spieler>
    trigger:
        set {_p} to arg-2 parsed as player
        if {_p} is not set:
            stop
        if arg-1 is "join":
            # Spielstart erkannt (erster Spieler einer Runde): Rundendaten der Arena frisch starten
            set {_wn} to name of world of {_p}
            set {_newgame} to true
            if {-bw::gs::%{_wn}%} is set:
                if difference between {-bw::gs::%{_wn}%} and now is less than 20 seconds:
                    set {_newgame} to false
            set {-bw::gs::%{_wn}%} to now
            if {_newgame} is true:
                bwResetWorldData(world of {_p})
                loop all players in world of {_p}:
                    delete {-bw::tc::%uuid of loop-player%}
            bwAddPoints({_p}, {@pts_join}, "Runde betreten")
            bwStatAdd({_p}, "games", 1)
        else if arg-1 is "kill":
            bwAddPoints({_p}, {@pts_kill}, "Kill")
            bwStatAdd({_p}, "kills", 1)
        else if arg-1 is "finalkill":
            bwAddPoints({_p}, {@pts_final_kill}, "Final Kill")
            bwStatAdd({_p}, "finalkills", 1)
        else if arg-1 is "bed":
            bwAddPoints({_p}, {@pts_bed}, "Bett zerstört")
            bwStatAdd({_p}, "beds", 1)
            bwBedEffect({_p})
        else if arg-1 is "win":
            bwAddPoints({_p}, {@pts_win}, "Sieg")
            bwStatAdd({_p}, "wins", 1)

command /addpoints <text> <number>:
    permission: op
    usage: /addpoints <spieler> <anzahl>
    trigger:
        set {_p} to arg-1 parsed as player
        if {_p} is not set:
            send "&cSpieler nicht online." to sender
            stop
        bwGivePoints({_p}, arg-2, "Admin")
        send "&a%arg-2% Punkte an %{_p}% vergeben. &7(zählt nicht als XP)" to sender

# /xp reset <spieler>: setzt nur XP und Level zurück (Level 1), Punkte und Statistiken bleiben
command /xp [<text>] [<text>]:
    permission: op
    usage: /xp reset <spieler>
    trigger:
        if arg-1 is not "reset":
            send "&cNutzung: &e/xp reset <Spieler>" to sender
            stop
        if arg-2 is not set:
            send "&cNutzung: &e/xp reset <Spieler>" to sender
            stop
        set {_op} to arg-2 parsed as offlineplayer
        set {_u} to "%uuid of {_op}%"
        if {bwx::name::%{_u}%} is not set:
            send "&cVon diesem Spieler gibt es keine Daten." to sender
            stop
        delete {bwp::xp::%{_u}%}
        send "&aXP und Level von &f%{bwx::name::%{_u}%}% &awurden zurückgesetzt (Level 1). &7Punkte und Statistiken bleiben." to sender
        set {_pl} to arg-2 parsed as player
        if {_pl} is set:
            send "&6Deine XP und dein Level wurden zurückgesetzt." to {_pl}

# /punkte, /punkte <spieler> und /pay <spieler> <anzahl> stehen in BedwarsExtras.sk

# Anzeige in der Lobby-Welt
every 2 seconds:
    loop all players:
        if name of world of loop-player is "{@lobby_world}":
            set {_s} to bwStatusLine(loop-player)
            send action bar {_s} to loop-player

on world change:
    set {_p} to player
    wait 1 second
    if name of world of {_p} is "{@lobby_world}":
        send "&8&m-------&r &6Dein Fortschritt &8&m-------" to {_p}
        send bwStatusLine({_p}) to {_p}
        send "&7Mit &e/gamble &7setzt du deine Punkte im Glücksrad ein." to {_p}

on join:
    set {_p} to player
    wait 2 seconds
    if name of world of {_p} is "{@lobby_world}":
        send bwStatusLine({_p}) to {_p}
        send "&7Mit &e/gamble &7setzt du deine Punkte im Glücksrad ein." to {_p}

# =========================================================
# 17./18. GAMBLING: siehe BedwarsGamble.sk
# =========================================================

# /itemdebug: zeigt Name, Lore und Typ des Items in deiner Hand (zum Vergleichen von Plugin-Eisen und Skript-Eisen)
command /itemdebug:
    permission: op
    trigger:
        send "&7Typ: &f%type of player's tool%" to player
        send "&7Menge: &f%item amount of player's tool%" to player
        send "&7Name: &f%name of player's tool%" to player
        send "&7Lore: &f%lore of player's tool%" to player
        send "&7Komplett: &f%player's tool%" to player
