# =========================================================
# BEDWARS MUSIK v3 (braucht skript-reflect, KEIN SkBee)
# =========================================================
# ADMIN (nur OPs / Konsole):
#   /musik play <Distanz> <Datei> [Sekunden]   Musikzone an DEINER Position anlegen
#   /musik stop                                Musikzone entfernen, Musik fuer alle beenden
#   /musik reset [alle]                        wie stop (alle = auch Spieler-Einstellungen)
#   /musik list | /musik reload                Dateien anzeigen / Ordner neu einlesen
# SPIELER:
#   /musik                       persoenliche Einstellungen (an/aus, Lautstaerke)
#   /musik lautstaerke <1-100>   Lautstaerke direkt setzen (Prozent)
#
# SO FUNKTIONIERT ES (Zone, z.B. fuer das Casino):
# - Betrittst du die Zone (Abstand zur Quelle <= Distanz in Bloecken), startet das Lied SOFORT von vorne.
# - Verlaesst du die Zone, wird es SOFORT gestoppt. Gehst du wieder rein, faengt es wieder von vorne an.
# - Die Musik kommt aus einer festen Quelle (Mono): je weiter du weg bist, desto leiser. Am Rand ist sie
#   praktisch aus, und genau bei <Distanz> Bloecken schneidet das Skript sie hart ab.
# - Jeder Spieler hat seinen eigenen Start. Mit [Sekunden] (Laenge des Liedes) wird es pro Spieler wiederholt,
#   ohne Laenge spielt es nur einmal pro Betreten.
# - Die Zone wird gespeichert und ist nach einem Neustart wieder da.
# - Tipp: Distanz mindestens 16, sonst kann Minecraft die Lautstaerke nicht sauber ausblenden.
#
# RESOURCE PACK: .ogg-Dateien nach plugins/Musik (nur a-z, 0-9, _ und -), Sound-Name im Pack: musik:<dateiname>
# =========================================================

import:
    java.io.File

options:
    music_dir: plugins/Musik
    music_max_dist: 200
    # Pruefintervall: kleiner = schnelleres Starten/Stoppen
    music_check: 5 ticks

# Ordner einlesen -> {-bwx::music::files::*} (Namen ohne .ogg)
function bwMusicScan():
    delete {-bwx::music::files::*}
    set {_dir} to new File("{@music_dir}")
    {_dir}.mkdirs()
    set {_names::*} to ...{_dir}.list()
    loop sorted {_names::*}:
        set {_f} to "%loop-value%"
        if {_f} ends with ".ogg":
            set {_b} to subtext of {_f} from characters 1 to (length of {_f} - 4)
            if {_b} matches "[a-z0-9_-]+":
                add {_b} to {-bwx::music::files::*}
            else if {-bwx::music::warned::%{_f}%} is not set:
                set {-bwx::music::warned::%{_f}%} to true
                send "&c[Musik] Ungültiger Dateiname (erlaubt: a-z, 0-9, _ und -): %{_f}%" to console

on load:
    bwMusicScan()
    # nach /sk reload laeuft evtl. noch ein Lied beim Client -> sauber stoppen, die Schleife startet es neu
    if {bwx::music::src::file} is set:
        stop sound "musik:%{bwx::music::src::file}%" for all players

every 60 seconds:
    bwMusicScan()

# ---------------------------------------------------------
# SPIELER-EINSTELLUNGEN (gespeichert)
# ---------------------------------------------------------
function bwMusicOn(u: text) :: boolean:
    if {bwx::music::off::%{_u}%} is set:
        return false
    return true

function bwMusicVol(u: text) :: number:
    if {bwx::music::vol::%{_u}%} is not set:
        return 100
    return {bwx::music::vol::%{_u}%}

# ---------------------------------------------------------
# MUSIKZONE
# Gespeichert: {bwx::music::src::file|loc|dist|len}
# Pro Spieler (nur Laufzeit): {-bwx::music::hear::<uuid>} = laufender Titel, {-bwx::music::tick::<uuid>} = Ticks seit Start
# ---------------------------------------------------------
function bwMusicInZone(p: player) :: boolean:
    if {bwx::music::src::file} is not set:
        return false
    if bwMusicOn("%uuid of {_p}%") is not true:
        return false
    if world of {_p} is not world of {bwx::music::src::loc}:
        return false
    if distance between (location of {_p}) and {bwx::music::src::loc} > {bwx::music::src::dist}:
        return false
    return true

# Titel fuer EINEN Spieler von vorne starten.
# Minecraft koppelt Lautstaerke und Reichweite. Darum liegt die Quelle bei Lautstaerke < 100 Prozent
# etwas ueber dem Zonenmittelpunkt: Mitte = gewaehlte Lautstaerke, Rand der Zone = still.
function bwMusicHear(p: player):
    set {_u} to "%uuid of {_p}%"
    set {_n} to {bwx::music::src::dist}
    set {_v} to bwMusicVol({_u}) / 100
    if {_v} > 1:
        set {_v} to 1
    if {_v} < 0.05:
        set {_v} to 0.05
    set {_r} to {_n}
    if {_v} < 0.999:
        set {_r} to {_n} / sqrt(1 - (1 - {_v}) ^ 2)
    if {_r} < 16:
        set {_r} to 16
    set {_h} to {_r} * (1 - {_v})
    set {_src} to {bwx::music::src::loc}
    if {_h} > 0.5:
        set {_src} to {_h} blocks above {bwx::music::src::loc}
    stop sound "musik:%{bwx::music::src::file}%" for {_p}
    play sound "musik:%{bwx::music::src::file}%" with volume ({_r} / 16) and pitch 1 at {_src} to {_p}
    set {-bwx::music::hear::%{_u}%} to "%{bwx::music::src::file}%"
    set {-bwx::music::tick::%{_u}%} to 0

# Spieler: Lied stoppen und Status loeschen
function bwMusicSilence(p: player):
    set {_u} to "%uuid of {_p}%"
    if {-bwx::music::hear::%{_u}%} is set:
        stop sound "musik:%{-bwx::music::hear::%{_u}%}%" for {_p}
    delete {-bwx::music::hear::%{_u}%}
    delete {-bwx::music::tick::%{_u}%}

# Zone entfernen, alles stoppen
function bwMusicHalt():
    loop {-bwx::music::files::*}:
        stop sound "musik:%loop-value%" for all players
    if {bwx::music::src::file} is set:
        stop sound "musik:%{bwx::music::src::file}%" for all players
    delete {bwx::music::src::*}
    delete {-bwx::music::hear::*}
    delete {-bwx::music::tick::*}

every {@music_check}:
    if {bwx::music::src::file} is not set:
        stop
    set {_len} to 0
    if {bwx::music::src::len} is set:
        set {_len} to {bwx::music::src::len}
    loop all players:
        set {_u} to "%uuid of loop-player%"
        set {_in} to bwMusicInZone(loop-player)
        if {-bwx::music::hear::%{_u}%} is set:
            if {_in} is not true:
                bwMusicSilence(loop-player)
            else if "%{-bwx::music::hear::%{_u}%}%" is not "%{bwx::music::src::file}%":
                bwMusicHear(loop-player)
            else:
                add 5 to {-bwx::music::tick::%{_u}%}
                if {_len} > 0:
                    if {-bwx::music::tick::%{_u}%} >= {_len} * 20:
                        bwMusicHear(loop-player)
        else if {_in} is true:
            bwMusicHear(loop-player)

on quit:
    delete {-bwx::music::hear::%uuid of player%}
    delete {-bwx::music::tick::%uuid of player%}

# ---------------------------------------------------------
# EINSTELLUNGS-MENUE (auch aus /chelp aufrufbar: bwMusicSettings(player))
# ---------------------------------------------------------
function bwMusicSettings(p: player):
    set {_u} to "%uuid of {_p}%"
    set {_vol} to bwMusicVol({_u})
    set {_inv} to chest inventory with 3 rows named "&9&lMusik-Einstellungen"
    loop 27 times:
        set {_s} to loop-number - 1
        set slot {_s} of {_inv} to gray stained glass pane named " "
    set {_x} to note block named "&6&lServer-Musik"
    if {bwx::music::src::file} is set:
        set lore of {_x} to "&7Titel: &f%{bwx::music::src::file}%" and "&7Hörweite: &e%{bwx::music::src::dist}% &7Blöcke" and "&8Beim Betreten startet die Musik, beim Verlassen endet sie."
    else:
        set lore of {_x} to "&7Gerade ist keine Musikzone eingerichtet."
    set slot 4 of {_inv} to {_x}
    if bwMusicOn({_u}) is true:
        set {_x} to lime dye named "&a&lMusik: AN"
        set lore of {_x} to "&7Klick zum Ausschalten"
    else:
        set {_x} to gray dye named "&c&lMusik: AUS"
        set lore of {_x} to "&7Klick zum Einschalten"
    set slot 11 of {_inv} to {_x}
    set {_n} to 0
    loop 25, 50, 75 and 100:
        set {_l} to loop-value
        if {_vol} is {_l}:
            set {_x} to lime concrete named "&a&l► Lautstärke %{_l}% Prozent ◄"
            set lore of {_x} to "&7Aktuell gewählt"
        else:
            set {_x} to gray concrete named "&7Lautstärke %{_l}% Prozent"
            set lore of {_x} to "&7Klick zum Wählen" and "&8Wirkt sofort (Titel startet neu)."
        set {_sl} to 13 + {_n}
        set slot {_sl} of {_inv} to {_x}
        add 1 to {_n}
    set {_x} to barrier named "&c&lSchließen"
    set slot 22 of {_inv} to {_x}
    open {_inv} to {_p}

on inventory click:
    if "%name of player's current inventory%" does not contain "Musik-Einstellungen":
        stop
    cancel event
    if event-item is not set:
        stop
    set {_n} to "%name of event-item%"
    set {_u} to "%uuid of player%"
    if {_n} contains "Schließen":
        close player's inventory
        stop
    if {_n} contains "Musik: ":
        if bwMusicOn({_u}) is true:
            set {bwx::music::off::%{_u}%} to true
            bwMusicSilence(player)
            send action bar "&c✘ Musik aus" to player
        else:
            delete {bwx::music::off::%{_u}%}
            send action bar "&a✔ Musik an" to player
        wait 1 tick
        bwMusicSettings(player)
        stop
    loop 25, 50, 75 and 100:
        if {_n} contains "Lautstärke %loop-value% Prozent":
            set {bwx::music::vol::%{_u}%} to loop-value
            if {-bwx::music::hear::%{_u}%} is set:
                bwMusicHear(player)
            send action bar "&a✔ Lautstärke: %loop-value% Prozent" to player
            wait 1 tick
            bwMusicSettings(player)
            stop

# ---------------------------------------------------------
# BEFEHL
# ---------------------------------------------------------
command /musik [<text>] [<text>] [<text>] [<text>]:
    aliases: music
    usage: /musik | lautstaerke <1-100> | play <Distanz> <Datei> [Sekunden] | stop | reset | list | reload
    trigger:
        if arg-1 is not set:
            if sender is a player:
                bwMusicSettings(player)
            else:
                send "&6[Musik] &7Nutzung: &e/musik play <Distanz> <Datei> [Sekunden] &8| &e/musik stop &8| &e/musik reset &8| &e/musik list &8| &e/musik reload" to sender
            stop
        if arg-1 is "lautstaerke" or "lautstärke" or "volume" or "vol":
            if sender is not a player:
                send "&cNur für Spieler." to sender
                stop
            set {_v} to arg-2 parsed as number
            if {_v} is not set:
                set {_cur} to bwMusicVol("%uuid of player%")
                send "&6[Musik] &7Deine Lautstärke: &e%{_cur}% Prozent &8| &7Ändern: &e/musik lautstaerke <1-100>" to player
                stop
            if {_v} < 1:
                set {_v} to 1
            if {_v} > 100:
                set {_v} to 100
            set {bwx::music::vol::%uuid of player%} to {_v}
            if {-bwx::music::hear::%uuid of player%} is set:
                bwMusicHear(player)
            send "&6[Musik] &7Lautstärke: &e%{_v}% Prozent" to player
            stop
        if sender is not op:
            send "&cKeine Berechtigung." to sender
            stop
        if arg-1 is "reload":
            bwMusicScan()
            send "&6[Musik] &7Ordner neu eingelesen: &e%size of {-bwx::music::files::*}% &7Datei(en)." to sender
            stop
        if arg-1 is "list" or "liste":
            bwMusicScan()
            if size of {-bwx::music::files::*} is 0:
                send "&6[Musik] &7Keine .ogg-Dateien in &f{@music_dir} &7gefunden. Dateinamen: nur a-z, 0-9, _ und -" to sender
                stop
            send "&6[Musik] &7Dateien (&e%size of {-bwx::music::files::*}%&7):" to sender
            loop {-bwx::music::files::*}:
                send "&8- &f%loop-value%" to sender
            send "&7Abspielen: &e/musik play <Distanz> <Datei> [Sekunden]" to sender
            stop
        if arg-1 is "stop":
            bwMusicHalt()
            send "&6[Musik] &7Musikzone entfernt, Musik für alle beendet." to sender
            stop
        if arg-1 is "reset":
            bwMusicHalt()
            if arg-2 is "alle":
                delete {bwx::music::off::*}
                delete {bwx::music::vol::*}
                delete {bwx::music::len::*}
                send "&6[Musik] &7Zurückgesetzt: Musik-Status, Spieler-Einstellungen und gemerkte Längen." to sender
            else:
                send "&6[Musik] &7Musikzone zurückgesetzt. &8(&e/musik reset alle &8setzt auch Spieler-Einstellungen zurück)" to sender
            bwMusicScan()
            stop
        if arg-1 is "play" or "abspielen":
            if sender is not a player:
                send "&cNur für Spieler (die Musik startet an deiner Position)!" to sender
                stop
            if arg-2 is not set:
                send "&cNutzung: /musik play <Distanz> <Datei> [Sekunden]" to player
                stop
            if arg-3 is not set:
                send "&cNutzung: /musik play <Distanz> <Datei> [Sekunden] &7(Dateien: /musik list)" to player
                stop
            set {_dist} to arg-2 parsed as number
            if {_dist} is not set:
                send "&cDie Distanz muss eine Zahl sein (Blöcke), z.B. &e30&c." to player
                stop
            if {_dist} < 1:
                set {_dist} to 1
            if {_dist} > {@music_max_dist}:
                set {_dist} to {@music_max_dist}
            set {_n} to arg-3 in lowercase
            if {_n} ends with ".ogg":
                set {_n} to subtext of {_n} from characters 1 to (length of {_n} - 4)
            bwMusicScan()
            if {-bwx::music::files::*} does not contain {_n}:
                send "&cDatei &f%{_n}% &cnicht gefunden. Vorhandene Dateien: &e/musik list" to player
                stop
            set {_len} to 0
            if arg-4 is set:
                set {_len} to arg-4 parsed as number
                if {_len} is not set:
                    send "&cDie Länge muss eine Zahl sein (Sekunden), z.B. &e185&c." to player
                    stop
                if {_len} > 0:
                    set {bwx::music::len::%{_n}%} to {_len}
            if {_len} is 0:
                if {bwx::music::len::%{_n}%} is set:
                    set {_len} to {bwx::music::len::%{_n}%}
            bwMusicHalt()
            set {bwx::music::src::file} to {_n}
            set {bwx::music::src::loc} to location of player
            set {bwx::music::src::dist} to {_dist}
            if {_len} > 0:
                set {bwx::music::src::len} to {_len}
            send "&6[Musik] &7Musikzone: &f%{_n}% &7im Umkreis von &e%{_dist}% &7Blöcken um deine Position." to player
            send "&8Wer die Zone betritt, hört den Titel sofort von vorne. Beim Verlassen endet er." to player
            if {_len} > 0:
                send "&8Wiederholung alle %{_len}% Sekunden." to player
            else:
                send "&8Ohne Länge spielt der Titel nur einmal pro Betreten. Mit &e/musik play %{_dist}% %{_n}% <Sekunden> &8wird er wiederholt." to player
            send "&8Hörst du nichts? Dann fehlt das Resource Pack oder du hast die Musik in den Einstellungen aus." to player
            stop
        send "&6[Musik] &7Nutzung: &e/musik play <Distanz> <Datei> [Sekunden] &8| &e/musik stop &8| &e/musik reset &8| &e/musik list &8| &e/musik reload" to sender
