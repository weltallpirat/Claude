# ---------------------------------------------------------
# /gamble (Casino-Hub) - nur noch für Admins
# ---------------------------------------------------------
command /gamble [<text>]:
    aliases: gluecksrad, wheel, casino
    usage: /gamble [rad|muenzwurf|slots|roulette|blackjack|bonus|stats|bank|boerse]
    trigger:
        if sender is not a player:
            send "&cNur für Spieler!" to sender
            stop
        if player does not have permission "{@admin_perm}":
            send "&cDas Casino erreichst du nur über die Casino-NPCs." to player
            stop
        if bwIsArena(world of player) is true:
            send "&cIn Arena-Welten kannst du nicht gamblen. Geh zurück in die Lobby!" to player
            stop
        if arg-1 is not set:
            bwGambleHub(player)
            stop
        if arg-1 is "rad" or "wheel" or "gluecksrad":
            bwGBetMenu(player, "wheel")
        else if arg-1 is "muenzwurf" or "coin" or "coinflip" or "münzwurf":
            bwGBetMenu(player, "coin")
        else if arg-1 is "slots" or "slot" or "automat":
            bwGBetMenu(player, "slot")
        else if arg-1 is "roulette":
            bwRouMenu(player)
        else if arg-1 is "blackjack" or "bj" or "21":
            bwGBetMenu(player, "bj")
        else if arg-1 is "bonus" or "daily" or "tagesbonus":
            bwGDailyMenu(player)
        else if arg-1 is "stats" or "statistik":
            bwGambleStats(player)
        else if arg-1 is "bank":
            bwBankMenu(player)
        else if arg-1 is "boerse" or "börse" or "aktien" or "stocks":
            bwStkMenu(player)
        else:
            bwGambleHub(player)

# ---------------------------------------------------------
# Getippte Befehle /bank (und optional /aktien) für normale Spieler sperren.
# Die Bank-NPCs nutzen /casinobank, sind also nicht betroffen.
# Wenn /bank auch getippt erlaubt bleiben soll: diesen Block einfach löschen.
# ---------------------------------------------------------
on command:
    if player is not set:
        stop
    if player has permission "{@admin_perm}":
        stop
    set {_c} to lowercase "%command%"
    if {_c} is "bank":
        cancel the event
        send "&cDie Bank erreichst du nur über den Bank-NPC." to player
    # Börse ebenfalls nur per NPC? Dann die drei Zeilen aktivieren (# entfernen):
    # else if {_c} is "aktien":
    #     cancel the event
    #     send "&cDie Börse erreichst du nur über den Börsen-NPC." to player
