function bwCosCat(id: text) :: text:
    if {_id} starts with "a_":
        return "arrow"
    if {_id} starts with "b_":
        return "bed"
    return "kill"

function bwCosCatName(c: text) :: text:
    if {_c} is "arrow":
        return "Pfeilspuren"
    if {_c} is "bed":
        return "Betten-Effekte"
    return "Kill-Effekte"

# ---------------------------------------------------------
# LEVEL-KOSMETIK: gibt es nicht zu kaufen, sondern bei einem bestimmten Level geschenkt
# ---------------------------------------------------------
# Neue Belohnung: unten in bwCosLevel (Level), bwCosLevelIds (Liste), bwCosAll, bwCosName,
# bwCosPart, bwCosIcon und in bwPart (Partikel) eintragen. Praefix a_ = Pfeil, b_ = Bett, k_ = Kill.
function bwCosLevel(id: text) :: number:
    if {_id} is "a_lv5":
        return 5
    if {_id} is "k_lv10":
        return 10
    if {_id} is "b_lv20":
        return 20
    if {_id} is "a_lv30":
        return 30
    if {_id} is "k_lv40":
        return 40
    if {_id} is "b_lv50":
        return 50
    if {_id} is "a_lv75":
        return 75
    if {_id} is "k_lv100":
        return 100
    return 0

function bwCosLevelIds() :: texts:
    return "a_lv5", "k_lv10", "b_lv20", "a_lv30", "k_lv40", "b_lv50", "a_lv75" and "k_lv100"

# Schaltet alle Level-Kosmetika frei, deren Level der Spieler erreicht hat (nimmt nie etwas weg).
# announce = true: Nachricht + Titel + Sound bei neu freigeschalteten Kosmetika.
function bwCosSync(p: player, announce: boolean):
    set {_u} to "%uuid of {_p}%"
    set {_lv} to bwLevelOf(bwXp({_u}))
    loop bwCosLevelIds():
        set {_id} to loop-value
        if {_lv} >= bwCosLevel({_id}):
            if {bwc::own::%{_u}%::%{_id}%} is not true:
                set {bwc::own::%{_u}%::%{_id}%} to true
                if {_announce} is true:
                    send "&6&l★ &eNeue Kosmetik freigeschaltet: &r%bwCosName({_id})% &7(Level %bwCosLevel({_id})%) &8- &e/kosmetik" to {_p}
                    send title "&6&lKOSMETIK FREIGESCHALTET!" with subtitle bwCosName({_id}) to {_p} for 3 seconds
                    play sound "entity.player.levelup" with volume 1 and pitch 1.2 to {_p}

# Beim Betreten des Servers nachholen (auch fuer Spieler, die schon ein hohes Level haben)
on join:
    set {_p} to player
    wait 3 seconds
    if {_p} is online:
        bwCosSync({_p}, true)

function bwCosMenu(p: player):
    set {_u} to "%uuid of {_p}%"
    bwCosSync({_p}, false)
    set {_inv} to chest inventory with 3 rows named "&6&lKosmetik-Shop"
    loop 27 times:
        set {_s} to loop-number - 1
        set slot {_s} of {_inv} to gray stained glass pane named " "
    set {_x} to arrow named "&6Pfeilspuren"
    set lore of {_x} to "&7Effekte hinter deinen Pfeilen" and "&eKlicken zum Öffnen" and "&8[cos=menu:arrow]"
    set slot 11 of {_inv} to {_x}
    set {_x} to red bed named "&cBetten-Effekte"
    set lore of {_x} to "&7Explosion, wenn du ein Bett zerstörst" and "&eKlicken zum Öffnen" and "&8[cos=menu:bed]"
    set slot 13 of {_inv} to {_x}
    set {_x} to skeleton skull named "&5Kill-Effekte"
    set lore of {_x} to "&7Effekt, wenn du einen Spieler besiegst" and "&eKlicken zum Öffnen" and "&8[cos=menu:kill]"
    set slot 15 of {_inv} to {_x}
    set {_x} to nether star named "&6Dein Guthaben: &e%bwPts({_u})% Punkte"
    set lore of {_x} to "&7Punkte sammelst du in Runden und im Glücksrad (&e/gamble&7)"
    set slot 4 of {_inv} to {_x}
    open {_inv} to {_p}

function bwCosCatMenu(p: player, c: text):
    set {_u} to "%uuid of {_p}%"
    set {_inv} to chest inventory with 6 rows named "&6&lKosmetik &8- &7%bwCosCatName({_c})%"
    loop 54 times:
        set {_s} to loop-number - 1
        set slot {_s} of {_inv} to gray stained glass pane named " "
    set {_n} to 0
    loop bwCosAll():
        set {_id} to loop-value
        if bwCosCat({_id}) is {_c}:
            set {_x} to bwCosIcon({_id})
            set name of {_x} to bwCosName({_id})
            set {_slot} to 10 + mod({_n}, 7) + (9 * floor({_n} / 7))
            if {bwc::own::%{_u}%::%{_id}%} is true:
                if {bwc::sel::%{_u}%::%{_c}%} is {_id}:
                    set lore of {_x} to "&a✔ Ausgewählt" and "&7Klicken zum Abwählen" and "&8[cos=item:%{_id}%]"
                else:
                    set lore of {_x} to "&aGekauft" and "&eKlicken zum Auswählen" and "&8[cos=item:%{_id}%]"
            else if bwCosLevel({_id}) > 0:
                set lore of {_x} to "&6★ Level-Belohnung" and "&cGesperrt: freigeschaltet ab &6Level %bwCosLevel({_id})%" and "&7Dein Level: &6%bwLevelOf(bwXp({_u}))%" and "&8[cos=item:%{_id}%]"
            else:
                set lore of {_x} to "&7Preis: &e%bwCosPrice({_id})% Punkte" and "&eKlicken zum Kaufen" and "&8[cos=item:%{_id}%]"
            set slot {_slot} of {_inv} to {_x}
            add 1 to {_n}
    set {_x} to barrier named "&cKeinen Effekt verwenden"
    set lore of {_x} to "&7Wählt in dieser Kategorie nichts aus" and "&8[cos=none:%{_c}%]"
    set slot 48 of {_inv} to {_x}
    set {_x} to arrow named "&7Zurück"
    set lore of {_x} to "&8[cos=back]"
    set slot 50 of {_inv} to {_x}
    set {_x} to nether star named "&6Guthaben: &e%bwPts({_u})% Punkte"
    set slot 4 of {_inv} to {_x}
    open {_inv} to {_p}

function bwCosClick(p: player, id: text):
    set {_u} to "%uuid of {_p}%"
    set {_c} to bwCosCat({_id})
    if {bwc::own::%{_u}%::%{_id}%} is true:
        if {bwc::sel::%{_u}%::%{_c}%} is {_id}:
            delete {bwc::sel::%{_u}%::%{_c}%}
            send "&7Effekt &f%bwCosName({_id})% &7abgewählt." to {_p}
        else:
            set {bwc::sel::%{_u}%::%{_c}%} to {_id}
            send "&aEffekt &f%bwCosName({_id})% &aausgewählt." to {_p}
    else if bwCosLevel({_id}) > 0:
        send "&cDiese Kosmetik bekommst du automatisch ab &6Level %bwCosLevel({_id})%&c. &7Dein Level: &6%bwLevelOf(bwXp({_u}))%" to {_p}
        play sound "entity.villager.no" with volume 1 and pitch 1 to {_p}
    else:
        set {_price} to bwCosPrice({_id})
        if bwPts({_u}) < {_price}:
            send "&cNicht genug Punkte! Du brauchst &e%{_price}%&c, hast &e%bwPts({_u})%&c." to {_p}
            play sound "entity.villager.no" with volume 1 and pitch 1 to {_p}
        else:
            set {bwp::pts::%{_u}%} to bwPts({_u}) - {_price}
            set {bwc::own::%{_u}%::%{_id}%} to true
            set {bwc::sel::%{_u}%::%{_c}%} to {_id}
            send "&aGekauft und ausgewählt: &f%bwCosName({_id})% &7(-%{_price}% Punkte)" to {_p}
            play sound "entity.player.levelup" with volume 1 and pitch 1.4 to {_p}
    wait 1 tick
    bwCosCatMenu({_p}, {_c})

command /kosmetik:
    aliases: cosmetics, cosmetic
    trigger:
        if sender is not a player:
            send "&cNur für Spieler!" to sender
            stop
        bwCosMenu(player)

on inventory click:
    set {_t} to "%name of player's current inventory%"
    if {_t} contains "Kosmetik":
        cancel event
        set {_ci} to event-item
        if {_ci} is not set:
            stop
        set {_l} to "%lore of {_ci}%"
        if {_l} does not contain "[cos=":
            stop
        set {_p} to player
        set {_u} to "%uuid of {_p}%"
        if {_l} contains "[cos=back]":
            wait 1 tick
            bwCosMenu({_p})
            stop
        loop "arrow", "bed" and "kill":
            if {_l} contains "[cos=menu:%loop-value%]":
                set {_c} to loop-value
            if {_l} contains "[cos=none:%loop-value%]":
                set {_c2} to loop-value
        if {_c} is set:
            wait 1 tick
            bwCosCatMenu({_p}, {_c})
            stop
        if {_c2} is set:
            delete {bwc::sel::%{_u}%::%{_c2}%}
            send "&7Kein Effekt in der Kategorie &f%bwCosCatName({_c2})% &7ausgewählt." to {_p}
            wait 1 tick
            bwCosCatMenu({_p}, {_c2})
            stop
        loop bwCosAll():
            if {_l} contains "[cos=item:%loop-value%]":
                set {_id} to loop-value
        if {_id} is set:
            bwCosClick({_p}, {_id})

# --- Pfeilspuren -------------------------------------------------
# Der Pfeil zieht Partikel hinter sich her, bis er stehen bleibt (max. 5 Sekunden)
function bwArrowTrail(proj: entity, id: text):
    set {_k} to bwCosPart({_id})
    set {_last} to location of {_proj}
    loop 100 times:
        if {_proj} is alive:
            set {_loc} to location of {_proj}
            bwPart({_k}, {_loc})
            if distance between {_last} and {_loc} < 0.05:
                stop
            set {_last} to {_loc}
            wait 1 tick
        else:
            stop

on shoot:
    if shooter is a player:
        set {_id} to {bwc::sel::%uuid of shooter%::arrow}
        if {_id} is set:
            bwArrowTrail(projectile, {_id})

# --- Betten-Explosion --------------------------------------------
# Position des zuletzt abgebauten Bettes merken (SBW gibt sie nicht weiter)
on break:
    if "%type of event-block%" does not end with "bed":
        stop
    set {-bwx::bedloc::%uuid of player%} to location of event-block
    set {-bwx::bedtime::%uuid of player%} to now

# Wird von /bwpoints bed ausgelöst (SBW-Reward player-destroy-bed)
function bwBedEffect(p: player):
    set {_u} to "%uuid of {_p}%"
    set {_id} to {bwc::sel::%{_u}%::bed}
    if {_id} is not set:
        stop
    wait 2 ticks
    set {_l} to location of {_p}
    if {-bwx::bedloc::%{_u}%} is set:
        if difference between {-bwx::bedtime::%{_u}%} and now is less than 5 seconds:
            set {_l} to {-bwx::bedloc::%{_u}%}
    delete {-bwx::bedloc::%{_u}%}
    delete {-bwx::bedtime::%{_u}%}
    bwBurst({_id}, {_l}, 14, 0.3)

# =========================================================
# 9. CHAT: SLOWMODE + ANTI-SPAM
# =========================================================
# - Slowmode: eine Nachricht pro {@chat_seconds} Sekunden (0 = Slowmode aus)
# - Anti-Spam: Dieselbe Nachricht (Groß/Klein und Leerzeichen egal) darf maximal {@chat_repeat_max}x
#   HINTEREINANDER gesendet werden. Sobald {@chat_repeat_minutes} Minuten seit der ersten dieser
#   Nachrichten vergangen sind, ist sie wieder erlaubt. Eine andere Nachricht zwischendurch
#   setzt den Zähler sofort zurück.
# - Admins (op) sind ausgenommen. Befehle sind nicht betroffen.
on chat:
    if player is op:
        stop
    set {_u} to "%uuid of player%"
    set {_m} to message in lowercase
    replace all " " with "" in {_m}
    set {_same} to false
    if {-bwx::chat::last::%{_u}%} is {_m}:
        set {_same} to true
    set {_block} to false
    if {_same} is true:
        if difference between {-bwx::chat::first::%{_u}%} and now is less than {@chat_repeat_minutes} minutes:
            if {-bwx::chat::count::%{_u}%} >= {@chat_repeat_max}:
                set {_block} to true
    if {_block} is true:
        cancel event
        set {_rem} to {@chat_repeat_minutes} minutes - (difference between {-bwx::chat::first::%{_u}%} and now)
        send "&cDiese Nachricht hast du schon {@chat_repeat_max}x hintereinander geschrieben. In &e%{_rem}% &cdarfst du sie wieder senden." to player
        stop
    set {_bwopt_chat_seconds} to {@chat_seconds}
    if {_bwopt_chat_seconds} > 0:
        if {-bwx::chat::time::%{_u}%} is set:
            set {_w} to difference between {-bwx::chat::time::%{_u}%} and now
            if {_w} is less than {@chat_seconds} seconds:
                set {_rem} to {@chat_seconds} seconds - {_w}
                cancel event
                send "&cSlowmode: Du kannst erst in &e%{_rem}% &cwieder schreiben." to player
                stop
    set {-bwx::chat::time::%{_u}%} to now
    if {_same} is true:
        if difference between {-bwx::chat::first::%{_u}%} and now is less than {@chat_repeat_minutes} minutes:
            add 1 to {-bwx::chat::count::%{_u}%}
        else:
            set {-bwx::chat::count::%{_u}%} to 1
            set {-bwx::chat::first::%{_u}%} to now
    else:
        set {-bwx::chat::last::%{_u}%} to {_m}
        set {-bwx::chat::count::%{_u}%} to 1
        set {-bwx::chat::first::%{_u}%} to now

on quit:
    delete {-bwx::chat::last::%uuid of player%}
    delete {-bwx::chat::count::%uuid of player%}
    delete {-bwx::chat::first::%uuid of player%}
    delete {-bwx::chat::time::%uuid of player%}

# =========================================================
# 10. ACHIEVEMENTS AUS
# =========================================================
# Skript hat keinen Advancement-Event. Es gibt zwei Wege (beide nötig für "komplett aus"):
#  a) Chat-Meldungen: gamerule {@advancement_rule} false. Das wird beim Laden für die Hauptwelt
#     gesetzt; für jede Arena-Welt/Vorlage einmal /noadvancements ausführen, während man darin steht
#     (SBW kopiert die Vorlagen-Welt inkl. Gamerule bei jeder Runde).
#  b) Pop-ups und Fortschritt: in spigot.yml  advancements: disabled: ['*']  (Server neu starten).
on load:
    execute console command "gamerule {@advancement_rule} false"

command /noadvancements:
    permission: op
    trigger:
        if sender is not a player:
            stop
        make player execute command "gamerule {@advancement_rule} false"
        send "&aAdvancement-Meldungen in der Welt &f%name of world of player% &aausgeschaltet." to player

# =========================================================
# 11. VORSCHLÄGE: /vorschlag (Spieler), /vorschlaege (Admins)
# =========================================================
# Spieler: /vorschlag <text>  -> ein Vorschlag pro {@suggest_hours} Stunden (10-250 Zeichen)
# Admins:  /vorschlaege       -> Menü: Linksklick = im Chat lesen + als gelesen markieren,
#                                Shift-Linksklick = erledigt, Rechtsklick = löschen
#          /vorschlaege list | lesen <id> | erledigt <id> | loeschen <id> | clear (löscht alle erledigten)
# Gespeichert wird dauerhaft in {bws::...}. Admins bekommen beim Join einen Hinweis auf neue Vorschläge.
function bwSugIds() :: texts:
    set {_n} to 0
    if {bws::next} is set:
        set {_n} to {bws::next}
    while {_n} > 0:
        if {bws::idx::%{_n}%} is set:
            add "%{_n}%" to {_out::*}
        remove 1 from {_n}
    return {_out::*}

function bwSugNewCount() :: number:
    set {_c} to 0
    loop bwSugIds():
        if {bws::status::%loop-value%} is "neu":
            add 1 to {_c}
    return {_c}

function bwSugDelete(id: text):
    delete {bws::idx::%{_id}%}
    delete {bws::name::%{_id}%}
    delete {bws::text::%{_id}%}
    delete {bws::time::%{_id}%}
    delete {bws::status::%{_id}%}

function bwSugStatusText(id: text) :: text:
    if {bws::status::%{_id}%} is "neu":
        return "&a[NEU]"
    if {bws::status::%{_id}%} is "erledigt":
        return "&b[ERLEDIGT]"
    return "&7[gelesen]"

function bwSugRead(s: player, id: text):
    if {bws::idx::%{_id}%} is not set:
        send "&cVorschlag #%{_id}% gibt es nicht." to {_s}
        stop
    set {_d} to {bws::time::%{_id}%} formatted as "dd.MM.yyyy HH:mm"
    send "&8&m-------&r &6Vorschlag #%{_id}% &8&m-------" to {_s}
    send "&7Von: &f%{bws::name::%{_id}%}% &8| &7%{_d}% &8| %bwSugStatusText({_id})%" to {_s}
    send "&f%{bws::text::%{_id}%}%" to {_s}
    if {bws::status::%{_id}%} is "neu":
        set {bws::status::%{_id}%} to "gelesen"

command /vorschlag <text>:
    aliases: suggest
    usage: /vorschlag <text>
    trigger:
        if sender is not a player:
            send "&cNur für Spieler!" to sender
            stop
        set {_u} to "%uuid of player%"
        if player is not op:
            if {bws::last::%{_u}%} is set:
                set {_d} to difference between {bws::last::%{_u}%} and now
                if {_d} is less than {@suggest_hours} hours:
                    set {_rem} to {@suggest_hours} hours - {_d}
                    send "&cDu kannst erst in &e%{_rem}% &cwieder einen Vorschlag einreichen." to player
                    stop
        set {_t} to arg-1
        replace all "&" with "" in {_t}
        if length of {_t} < 10:
            send "&cBitte schreibe mindestens 10 Zeichen." to player
            stop
        if length of {_t} > 250:
            send "&cMaximal 250 Zeichen, dein Vorschlag hat %length of {_t}%." to player
            stop
        add 1 to {bws::next}
        set {_id} to "%{bws::next}%"
        set {bws::idx::%{_id}%} to true
        set {bws::name::%{_id}%} to name of player
        set {bws::text::%{_id}%} to {_t}
        set {bws::time::%{_id}%} to now
        set {bws::status::%{_id}%} to "neu"
        if player is not op:
            set {bws::last::%{_u}%} to now
        send "&aDanke! Dein Vorschlag (#%{_id}%) wurde an die Admins weitergeleitet." to player
        loop all players:
            if loop-player is op:
                send "&e[Vorschlag] &7Neuer Vorschlag #%{_id}% von &f%name of player%&7. Öffnen mit &e/vorschlaege" to loop-player

function bwSugMenu(p: player, page: number):
    set {_ids::*} to bwSugIds()
    set {_total} to size of {_ids::*}
    set {_pages} to ceil({_total} / 45)
    if {_pages} < 1:
        set {_pages} to 1
    if {_page} > {_pages}:
        set {_page} to {_pages}
    if {_page} < 1:
        set {_page} to 1
    set {-bws::page::%uuid of {_p}%} to {_page}
    set {_inv} to chest inventory with 6 rows named "&8Vorschläge &7(Seite %{_page}%/%{_pages}%)"
    set {_start} to (({_page} - 1) * 45) + 1
    set {_i} to 0
    while {_i} < 45:
        set {_k} to {_start} + {_i}
        if {_k} <= {_total}:
            set {_id} to {_ids::%{_k}%}
            set {_st} to {bws::status::%{_id}%}
            if {_st} is "neu":
                set {_x} to paper named "&e#%{_id}% &7von &f%{bws::name::%{_id}%}% &a[NEU]"
            else if {_st} is "erledigt":
                set {_x} to emerald named "&e#%{_id}% &7von &f%{bws::name::%{_id}%}% &b[ERLEDIGT]"
            else:
                set {_x} to book named "&e#%{_id}% &7von &f%{bws::name::%{_id}%}% &7[gelesen]"
            set {_lore::*} to bwWrap({bws::text::%{_id}%}, 36)
            set {_d} to {bws::time::%{_id}%} formatted as "dd.MM.yyyy HH:mm"
            add " " to {_lore::*}
            add "&7Eingereicht: &f%{_d}%" to {_lore::*}
            add "&eLinksklick: lesen" to {_lore::*}
            add "&eShift-Linksklick: erledigt" to {_lore::*}
            add "&cRechtsklick: löschen" to {_lore::*}
            add "&8[sug=%{_id}%]" to {_lore::*}
            set lore of {_x} to {_lore::*}
            set slot {_i} of {_inv} to {_x}
            delete {_lore::*}
        add 1 to {_i}
    loop 9 times:
        set {_s} to 44 + loop-number
        set slot {_s} of {_inv} to gray stained glass pane named " "
    if {_page} > 1:
        set {_x} to arrow named "&7Vorherige Seite"
        set lore of {_x} to "&8[sug=prev]"
        set slot 45 of {_inv} to {_x}
    if {_page} < {_pages}:
        set {_x} to arrow named "&7Nächste Seite"
        set lore of {_x} to "&8[sug=next]"
        set slot 53 of {_inv} to {_x}
    set {_x} to nether star named "&6%{_total}% Vorschläge"
    set lore of {_x} to "&7Neu: &a%bwSugNewCount()%"
    set slot 49 of {_inv} to {_x}
    set {_x} to emerald named "&aErledigte löschen"
    set lore of {_x} to "&7Löscht alle als erledigt markierten" and "&8[sug=cleardone]"
    set slot 46 of {_inv} to {_x}
    set {_x} to clock named "&eCooldowns zurücksetzen"
    set lore of {_x} to "&7Alle Spieler dürfen sofort wieder einreichen" and "&8[sug=cd]"
    set slot 47 of {_inv} to {_x}
    set {_x} to tnt named "&c&lALLE Vorschläge löschen"
    set lore of {_x} to "&cShift-Linksklick zum Bestätigen" and "&8[sug=reset]"
    set slot 51 of {_inv} to {_x}
    open {_inv} to {_p}

command /vorschlaege [<text>] [<text>]:
    permission: op
    aliases: vorschläge, suggestions
    usage: /vorschlaege [list | lesen <id> | erledigt <id> | loeschen <id> | clear | reset confirm | cooldown [spieler]]
    trigger:
        if arg-1 is not set:
            if sender is a player:
                bwSugMenu(player, 1)
            else:
                send "&7Nutze /vorschlaege list" to sender
            stop
        if arg-1 is "list":
            set {_ids::*} to bwSugIds()
            send "&8&m-------&r &6Vorschläge (%size of {_ids::*}%, neu: %bwSugNewCount()%) &8&m-------" to sender
            loop {_ids::*}:
                set {_t} to {bws::text::%loop-value%}
                if length of {_t} > 60:
                    set {_t} to "%first 60 characters of {_t}%..."
                send "&e#%loop-value% %bwSugStatusText(loop-value)% &f%{bws::name::%loop-value%}%&7: %{_t}%" to sender
            stop
        if arg-1 is "clear":
            set {_n} to 0
            loop bwSugIds():
                if {bws::status::%loop-value%} is "erledigt":
                    bwSugDelete(loop-value)
                    add 1 to {_n}
            send "&a%{_n}% erledigte Vorschläge gelöscht." to sender
            stop
        if arg-1 is "reset":
            if arg-2 is not "confirm":
                send "&cACHTUNG: Das löscht ALLE Vorschläge! Bestätigung: &e/vorschlaege reset confirm" to sender
                stop
            loop bwSugIds():
                bwSugDelete(loop-value)
            delete {bws::next}
            send "&aAlle Vorschläge wurden zurückgesetzt." to sender
            stop
        if arg-1 is "cooldown":
            if arg-2 is not set:
                delete {bws::last::*}
                send "&aAlle Vorschlags-Cooldowns wurden zurückgesetzt." to sender
                stop
            set {_o} to arg-2 parsed as offlineplayer
            delete {bws::last::%uuid of {_o}%}
            send "&aCooldown von &f%arg-2% &azurückgesetzt." to sender
            stop
        if arg-2 is not set:
            send "&cNutzung: /vorschlaege %arg-1% <id>" to sender
            stop
        set {_id} to arg-2
        if {bws::idx::%{_id}%} is not set:
            send "&cVorschlag #%{_id}% gibt es nicht." to sender
            stop
        if arg-1 is "lesen" or "read":
            if sender is a player:
                bwSugRead(player, {_id})
        else if arg-1 is "erledigt":
            set {bws::status::%{_id}%} to "erledigt"
            send "&aVorschlag #%{_id}% ist als erledigt markiert." to sender
        else if arg-1 is "loeschen" or "delete":
            bwSugDelete({_id})
            send "&aVorschlag #%{_id}% gelöscht." to sender
        else:
            send "&cNutzung: /vorschlaege [list | lesen <id> | erledigt <id> | loeschen <id> | clear]" to sender

on inventory click:
    set {_t} to "%name of player's current inventory%"
    if {_t} contains "Vorschläge":
        cancel event
        if player is not op:
            stop
        set {_ci} to event-item
        if {_ci} is not set:
            stop
        set {_l} to "%lore of {_ci}%"
        if {_l} does not contain "[sug=":
            stop
        set {_p} to player
        set {_pg} to {-bws::page::%uuid of {_p}%}
        if {_pg} is not set:
            set {_pg} to 1
        if {_l} contains "[sug=prev]":
            wait 1 tick
            bwSugMenu({_p}, {_pg} - 1)
            stop
        if {_l} contains "[sug=next]":
            wait 1 tick
            bwSugMenu({_p}, {_pg} + 1)
            stop
        if {_l} contains "[sug=cleardone]":
            loop bwSugIds():
                if {bws::status::%loop-value%} is "erledigt":
                    bwSugDelete(loop-value)
            wait 1 tick
            bwSugMenu({_p}, {_pg})
            stop
        if {_l} contains "[sug=cd]":
            delete {bws::last::*}
            send "&aAlle Vorschlags-Cooldowns wurden zurückgesetzt." to {_p}
            stop
        if {_l} contains "[sug=reset]":
            if click type is left mouse button with shift:
                loop bwSugIds():
                    bwSugDelete(loop-value)
                delete {bws::next}
                send "&aAlle Vorschläge wurden zurückgesetzt." to {_p}
            else:
                send "&cZum Löschen ALLER Vorschläge: Shift-Linksklick." to {_p}
            wait 1 tick
            bwSugMenu({_p}, {_pg})
            stop
        loop bwSugIds():
            if {_l} contains "[sug=%loop-value%]":
                set {_id} to loop-value
        if {_id} is not set:
            stop
        if click type is left mouse button with shift:
            set {bws::status::%{_id}%} to "erledigt"
        else if click type is left mouse button:
            bwSugRead({_p}, {_id})
        else if click type is right mouse button or right mouse button with shift:
            bwSugDelete({_id})
        wait 1 tick
        bwSugMenu({_p}, {_pg})

on join:
    set {_p} to player
    if {_p} is op:
        wait 3 seconds
        set {_n} to bwSugNewCount()
        if {_n} > 0:
            send "&e[Vorschlag] &7Es gibt &a%{_n}% neue Vorschläge&7. Öffnen mit &e/vorschlaege" to {_p}

# =========================================================
# 12. BANK: /bank  (Punkte sicher anlegen, Zinsen)
# =========================================================
# {bwp::bank::<uuid>} = Kontostand. Zinsen: {@bank_rate}% pro Stunde, ausgezahlt alle 10 Minuten (auch offline),
# Kontostand maximal {@bank_max}. Eingezahlte Punkte sind vom Spielstand getrennt und gehen beim Gamblen
# nicht verloren.
function bwBank(u: text) :: number:
    if {bwp::bank::%{_u}%} is not set:
        return 0
    return {bwp::bank::%{_u}%}

function bwBankEarned(u: text) :: number:
    if {bwp::bankint::%{_u}%} is not set:
        return 0
    return {bwp::bankint::%{_u}%}

function bwBankDeposit(p: player, amt: number):
    set {_u} to "%uuid of {_p}%"
    if {_amt} < 1:
        send action bar "&cKeine Punkte zum Einzahlen." to {_p}
        stop
    if bwPts({_u}) < {_amt}:
        send action bar "&cNicht genug Punkte! Guthaben: %bwPts({_u})%" to {_p}
        play sound "entity.villager.no" with volume 1 and pitch 1 to {_p}
        stop
    if bwBank({_u}) + {_amt} > {@bank_max}:
        set {_amt} to {@bank_max} - bwBank({_u})
        if {_amt} < 1:
            send action bar "&cDein Konto ist voll (maximal {@bank_max} Punkte)." to {_p}
            stop
    set {bwp::pts::%{_u}%} to bwPts({_u}) - {_amt}
    set {bwp::bank::%{_u}%} to bwBank({_u}) + {_amt}
    send "&6[Bank] &7Eingezahlt: &e%{_amt}% &8| &7Konto: &e%bwBank({_u})% &8| &7Guthaben: &e%bwPts({_u})%" to {_p}
    play sound "entity.experience_orb.pickup" with volume 1 and pitch 1 to {_p}

function bwBankWithdraw(p: player, amt: number):
    set {_u} to "%uuid of {_p}%"
    if {_amt} < 1:
        send action bar "&cNichts zum Auszahlen." to {_p}
        stop
    if bwBank({_u}) < {_amt}:
        send action bar "&cSo viel hast du nicht auf dem Konto! Konto: %bwBank({_u})%" to {_p}
        play sound "entity.villager.no" with volume 1 and pitch 1 to {_p}
        stop
    set {bwp::bank::%{_u}%} to bwBank({_u}) - {_amt}
    set {bwp::pts::%{_u}%} to bwPts({_u}) + {_amt}
    send "&6[Bank] &7Ausgezahlt: &e%{_amt}% &8| &7Konto: &e%bwBank({_u})% &8| &7Guthaben: &e%bwPts({_u})%" to {_p}
    play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.3 to {_p}

function bwBankMenu(p: player):
    set {_u} to "%uuid of {_p}%"
    set {_inv} to chest inventory with 4 rows named "&6&lBank"
    loop 36 times:
        set {_s} to loop-number - 1
        set slot {_s} of {_inv} to gray stained glass pane named " "
    set {_x} to gold block named "&6Dein Konto: &e%bwBank({_u})% Punkte"
    set lore of {_x} to "&7Zinsen: &a{@bank_rate}%%&7 pro Stunde" and "&7Auszahlung alle 10 Minuten, auch offline" and "&7Maximaler Kontostand: &e{@bank_max}" and "&7Bisher verdient: &a+%bwBankEarned({_u})%"
    set slot 4 of {_inv} to {_x}
    set {_n} to 0
    loop 100, 500, 1000 and 5000:
        set {_sl} to 10 + {_n}
        set {_x} to lime stained glass pane named "&aEinzahlen: &e%loop-value%"
        set lore of {_x} to "&7Legt &e%loop-value% Punkte &7auf dein Konto" and "&8[bank=in:%loop-value%]"
        set slot {_sl} of {_inv} to {_x}
        set {_sl} to 19 + {_n}
        set {_x} to orange stained glass pane named "&6Auszahlen: &e%loop-value%"
        set lore of {_x} to "&7Holt &e%loop-value% Punkte &7vom Konto" and "&8[bank=out:%loop-value%]"
        set slot {_sl} of {_inv} to {_x}
        add 1 to {_n}
    set {_x} to lime concrete named "&a&lAlles einzahlen"
    set lore of {_x} to "&7Dein ganzes Guthaben (&e%bwPts({_u})%&7)" and "&8[bank=in:all]"
    set slot 14 of {_inv} to {_x}
    set {_x} to orange concrete named "&6&lAlles auszahlen"
    set lore of {_x} to "&7Dein ganzes Konto (&e%bwBank({_u})%&7)" and "&8[bank=out:all]"
    set slot 23 of {_inv} to {_x}
    set {_x} to nether star named "&6Guthaben: &e%bwPts({_u})% Punkte"
    set slot 31 of {_inv} to {_x}
    set {_x} to emerald named "&2Zur Börse"
    set lore of {_x} to "&7Aktien kaufen und verkaufen" and "&8[bank=stocks]"
    set slot 33 of {_inv} to {_x}
    open {_inv} to {_p}

command /bank [<text>] [<text>]:
    aliases: konto
    usage: /bank [einzahlen <anzahl|alles> | auszahlen <anzahl|alles>]
    trigger:
        if sender is not a player:
            send "&cNur für Spieler!" to sender
            stop
        if bwIsArena(world of player) is true:
            send "&cIn Arena-Welten ist die Bank nicht erreichbar. Geh zurück in die Lobby!" to player
            stop
        set {_u} to "%uuid of player%"
        if arg-1 is not set:
            bwBankMenu(player)
            stop
        if arg-1 is "einzahlen" or "deposit" or "auszahlen" or "withdraw":
            if arg-2 is not set:
                send "&cNutzung: /bank %arg-1% <anzahl|alles>" to player
                stop
            set {_n} to 0
            if arg-2 is "alles" or "all":
                if arg-1 is "einzahlen" or "deposit":
                    set {_n} to bwPts({_u})
                else:
                    set {_n} to bwBank({_u})
            else:
                set {_n} to arg-2 parsed as integer
            if {_n} is not set:
                send "&cBitte gib eine ganze Zahl oder &ealles &can." to player
                stop
            if arg-1 is "einzahlen" or "deposit":
                bwBankDeposit(player, {_n})
            else:
                bwBankWithdraw(player, {_n})
            stop
        send "&6[Bank] &7Konto: &e%bwBank({_u})% &8| &7Guthaben: &e%bwPts({_u})% &8| &7Zinsen: &a{@bank_rate}%%&7/Stunde" to player
        send "&7Nutzung: &e/bank &8| &e/bank einzahlen <anzahl|alles> &8| &e/bank auszahlen <anzahl|alles>" to player

on inventory click:
    set {_t} to "%name of player's current inventory%"
    if {_t} contains "Bank":
        cancel event
        set {_ci} to event-item
        if {_ci} is not set:
            stop
        set {_l} to "%lore of {_ci}%"
        if {_l} does not contain "[bank=":
            stop
        set {_p} to player
        set {_u} to "%uuid of {_p}%"
        wait 1 tick
        if {_l} contains "[bank=stocks]":
            bwStkMenu({_p})
            stop
        if {_l} contains "[bank=in:all]":
            bwBankDeposit({_p}, bwPts({_u}))
        else if {_l} contains "[bank=out:all]":
            bwBankWithdraw({_p}, bwBank({_u}))
        else:
            loop 100, 500, 1000 and 5000:
                if {_l} contains "[bank=in:%loop-value%]":
                    bwBankDeposit({_p}, loop-value)
                if {_l} contains "[bank=out:%loop-value%]":
                    bwBankWithdraw({_p}, loop-value)
        bwBankMenu({_p})

# Zinsen: alle 10 Minuten (Prozent pro Stunde / 6), Nachkommastellen werden mitgeführt
every 10 minutes:
    loop {bwp::bank::*}:
        set {_u} to loop-index
        set {_bal} to loop-value
        if {_bal} > 0:
            set {_car} to {bwp::bankcarry::%{_u}%}
            if {_car} is not set:
                set {_car} to 0
            set {_acc} to ({_bal} * {@bank_rate} / 600) + {_car}
            set {_i} to floor({_acc})
            set {bwp::bankcarry::%{_u}%} to {_acc} - {_i}
            if {_i} > 0:
                add {_i} to {bwp::bank::%{_u}%}
                add {_i} to {bwp::bankint::%{_u}%}

# =========================================================
# 13. AKTIEN-BÖRSE: /aktien  (virtuelle Börse, Kurse schwanken jede Minute)
# =========================================================
# 6 Aktien. Alle 60 Sekunden ändert sich jeder Kurs zufällig (innerhalb der Schwankung der Aktie) und wird
# sanft zum Basiskurs zurückgezogen (Kurse laufen nicht ins Unendliche). Kauf/Verkauf kostet {@stock_fee}% Gebühr.
# Die Kurse laufen auch weiter, wenn niemand online ist.
# {bwm::price::<id>} aktueller Kurs, {bwm::prev::<id>} Kurs der Vorminute,
# {bwm::own::<uuid>::<id>} Anzahl Aktien, {bwm::cost::<uuid>::<id>} Einstandswert.
function bwStkIds() :: texts:
    return "IRON", "GOLD", "EMER", "DIAM", "TNT" and "BEDX"

function bwStkName(id: text) :: text:
    if {_id} is "IRON":
        return "&fIron Industries"
    if {_id} is "GOLD":
        return "&6Gold Rush AG"
    if {_id} is "EMER":
        return "&aEmerald Corp"
    if {_id} is "DIAM":
        return "&bDiamond Holding"
    if {_id} is "TNT":
        return "&cBoom & Co"
    return "&dBedwars Entertainment"

function bwStkBase(id: text) :: number:
    if {_id} is "IRON":
        return 100
    if {_id} is "GOLD":
        return 250
    if {_id} is "EMER":
        return 600
    if {_id} is "DIAM":
        return 1500
    if {_id} is "TNT":
        return 400
    return 3000

# maximale Schwankung pro Minute in Prozent
function bwStkVol(id: text) :: number:
    if {_id} is "IRON":
        return 2
    if {_id} is "GOLD":
        return 3
    if {_id} is "EMER":
        return 4
    if {_id} is "DIAM":
        return 5
    if {_id} is "TNT":
        return 7
    return 4

function bwStkIcon(id: text) :: item:
    if {_id} is "IRON":
        return iron ingot
    if {_id} is "GOLD":
        return gold ingot
    if {_id} is "EMER":
        return emerald
    if {_id} is "DIAM":
        return diamond
    if {_id} is "TNT":
        return tnt
    return red bed

function bwStkPrice(id: text) :: number:
    if {-bwm::price::%{_id}%} is not set:
        if {bwm::price::%{_id}%} is set:
            set {-bwm::price::%{_id}%} to {bwm::price::%{_id}%}
            set {-bwm::prev::%{_id}%} to {bwm::prev::%{_id}%}
        else:
            set {-bwm::price::%{_id}%} to bwStkBase({_id})
    return {-bwm::price::%{_id}%}

function bwStkOwn(u: text, id: text) :: number:
    if {bwm::own::%{_u}%::%{_id}%} is not set:
        return 0
    return {bwm::own::%{_u}%::%{_id}%}

# Wert aller Aktien eines Spielers
function bwStkValue(u: text) :: number:
    set {_v} to 0
    loop bwStkIds():
        add bwStkOwn({_u}, loop-value) * bwStkPrice(loop-value) to {_v}
    return {_v}

# Kursänderung seit der Vorminute (Text mit Pfeil)
function bwStkTrend(id: text) :: text:
    set {_now} to bwStkPrice({_id})
    set {_old} to {-bwm::prev::%{_id}%}
    if {_old} is not set:
        return "&7■ 0%%"
    set {_ch} to round((({_now} - {_old}) / {_old}) * 1000) / 10
    if {_ch} > 0:
        return "&a▲ +%{_ch}%%%"
    if {_ch} < 0:
        return "&c▼ %{_ch}%%%"
    return "&7■ 0%%"

function bwStkTick():
    loop bwStkIds():
        set {_id} to loop-value
        set {_old} to bwStkPrice({_id})
        set {_base} to bwStkBase({_id})
        set {_vol} to bwStkVol({_id})
        set {_chg} to a random number between (0 - {_vol}) and {_vol}
        set {_pull} to (({_base} - {_old}) / {_base}) * 4
        set {_new} to round({_old} * (1 + (({_chg} + {_pull}) / 100)))
        if {_new} < 1:
            set {_new} to 1
        set {-bwm::prev::%{_id}%} to {_old}
        set {-bwm::price::%{_id}%} to {_new}

every 1 minute:
    bwStkTick()

# Kurse nur alle 5 Minuten dauerhaft speichern (nicht jede Minute) -> weniger Datenbank-Schreibvorgaenge
every 5 minutes:
    loop bwStkIds():
        if {-bwm::price::%{loop-value}%} is set:
            if {bwm::price::%{loop-value}%} is not {-bwm::price::%{loop-value}%}:
                set {bwm::price::%{loop-value}%} to {-bwm::price::%{loop-value}%}
                set {bwm::prev::%{loop-value}%} to {-bwm::prev::%{loop-value}%}

function bwStkBuy(p: player, id: text, qty: number):
    set {_u} to "%uuid of {_p}%"
    set {_price} to bwStkPrice({_id})
    set {_cost} to ceil({_price} * {_qty} * (100 + {@stock_fee}) / 100)
    if bwPts({_u}) < {_cost}:
        send action bar "&cNicht genug Punkte! Du brauchst %{_cost}% (inkl. Gebühr)." to {_p}
        play sound "entity.villager.no" with volume 1 and pitch 1 to {_p}
        stop
    set {bwp::pts::%{_u}%} to bwPts({_u}) - {_cost}
    set {bwm::own::%{_u}%::%{_id}%} to bwStkOwn({_u}, {_id}) + {_qty}
    add {_price} * {_qty} to {bwm::cost::%{_u}%::%{_id}%}
    send "&2[Börse] &7Gekauft: &f%{_qty}%x %bwStkName({_id})% &7zu &e%{_price}% &8| &7Kosten: &e%{_cost}% &8| &7Guthaben: &e%bwPts({_u})%" to {_p}
    play sound "entity.item.pickup" with volume 1 and pitch 1.2 to {_p}

function bwStkSell(p: player, id: text, qty: number):
    set {_u} to "%uuid of {_p}%"
    set {_have} to bwStkOwn({_u}, {_id})
    if {_have} < 1:
        send action bar "&cDu besitzt keine Aktien von %bwStkName({_id})%." to {_p}
        play sound "entity.villager.no" with volume 1 and pitch 1 to {_p}
        stop
    if {_qty} > {_have}:
        set {_qty} to {_have}
    set {_price} to bwStkPrice({_id})
    set {_gain} to floor({_price} * {_qty} * (100 - {@stock_fee}) / 100)
    set {_cost} to {bwm::cost::%{_u}%::%{_id}%}
    if {_cost} is not set:
        set {_cost} to 0
    set {_part} to floor({_cost} * {_qty} / {_have})
    set {bwp::pts::%{_u}%} to bwPts({_u}) + {_gain}
    set {bwm::own::%{_u}%::%{_id}%} to {_have} - {_qty}
    set {bwm::cost::%{_u}%::%{_id}%} to {_cost} - {_part}
    if {_have} - {_qty} < 1:
        delete {bwm::own::%{_u}%::%{_id}%}
        delete {bwm::cost::%{_u}%::%{_id}%}
    set {_pl} to {_gain} - {_part}
    if {_pl} >= 0:
        send "&2[Börse] &7Verkauft: &f%{_qty}%x %bwStkName({_id})% &7zu &e%{_price}% &8| &7Erlös: &e%{_gain}% &8| &aGewinn: +%{_pl}%" to {_p}
    else:
        send "&2[Börse] &7Verkauft: &f%{_qty}%x %bwStkName({_id})% &7zu &e%{_price}% &8| &7Erlös: &e%{_gain}% &8| &cVerlust: %{_pl}%" to {_p}
    play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.2 to {_p}

function bwStkMenu(p: player):
    set {_u} to "%uuid of {_p}%"
    set {_inv} to chest inventory with 4 rows named "&2&lBörse"
    loop 36 times:
        set {_s} to loop-number - 1
        set slot {_s} of {_inv} to gray stained glass pane named " "
    set {_n} to 10
    loop bwStkIds():
        set {_id} to loop-value
        set {_pr} to bwStkPrice({_id})
        set {_have} to bwStkOwn({_u}, {_id})
        set {_x} to bwStkIcon({_id})
        set name of {_x} to "%bwStkName({_id})% &8(%{_id}%)"
        add "&7Kurs: &e%{_pr}% Punkte &8| %bwStkTrend({_id})%" to {_lore::*}
        add "&7Besitz: &f%{_have}% Aktien &8(Wert &e%{_have} * {_pr}%&8)" to {_lore::*}
        if {_have} > 0:
            set {_cost} to {bwm::cost::%{_u}%::%{_id}%}
            if {_cost} is not set:
                set {_cost} to 0
            set {_pl} to ({_have} * {_pr}) - {_cost}
            if {_pl} >= 0:
                add "&7Gewinn/Verlust: &a+%{_pl}%" to {_lore::*}
            else:
                add "&7Gewinn/Verlust: &c%{_pl}%" to {_lore::*}
        add " " to {_lore::*}
        add "&aLinksklick: 1 kaufen" to {_lore::*}
        add "&aShift-Linksklick: 10 kaufen" to {_lore::*}
        add "&cRechtsklick: 1 verkaufen" to {_lore::*}
        add "&cShift-Rechtsklick: 10 verkaufen" to {_lore::*}
        add "&8[stk=%{_id}%]" to {_lore::*}
        set lore of {_x} to {_lore::*}
        delete {_lore::*}
        set slot {_n} of {_inv} to {_x}
        add 1 to {_n}
    set {_x} to book named "&6Dein Depot: &e%bwStkValue({_u})% Punkte"
    set lore of {_x} to "&7Guthaben: &e%bwPts({_u})% Punkte" and "&7Gebühr pro Handel: &c{@stock_fee}%%" and "&7Kurse ändern sich jede Minute"
    set slot 4 of {_inv} to {_x}
    set {_x} to barrel named "&cAlles verkaufen"
    set lore of {_x} to "&7Verkauft alle deine Aktien zum aktuellen Kurs" and "&8[stk=sellall]"
    set slot 29 of {_inv} to {_x}
    set {_x} to nether star named "&6Guthaben: &e%bwPts({_u})% Punkte"
    set slot 31 of {_inv} to {_x}
    set {_x} to gold block named "&6Zur Bank"
    set lore of {_x} to "&7Punkte anlegen und Zinsen kassieren" and "&8[stk=bank]"
    set slot 33 of {_inv} to {_x}
    open {_inv} to {_p}

command /aktien:
    aliases: boerse, stocks, aktie
    trigger:
        if sender is not a player:
            send "&cNur für Spieler!" to sender
            stop
        if bwIsArena(world of player) is true:
            send "&cIn Arena-Welten ist die Börse geschlossen. Geh zurück in die Lobby!" to player
            stop
        bwStkMenu(player)

on inventory click:
    set {_t} to "%name of player's current inventory%"
    if {_t} contains "Börse":
        cancel event
        set {_ci} to event-item
        if {_ci} is not set:
            stop
        set {_l} to "%lore of {_ci}%"
        if {_l} does not contain "[stk=":
            stop
        set {_p} to player
        set {_u} to "%uuid of {_p}%"
        wait 1 tick
        if {_l} contains "[stk=bank]":
            bwBankMenu({_p})
            stop
        if {_l} contains "[stk=sellall]":
            loop bwStkIds():
                if bwStkOwn({_u}, loop-value) > 0:
                    bwStkSell({_p}, loop-value, bwStkOwn({_u}, loop-value))
            bwStkMenu({_p})
            stop
        loop bwStkIds():
            if {_l} contains "[stk=%loop-value%]":
                set {_id} to loop-value
        if {_id} is not set:
            stop
        if click type is left mouse button:
            bwStkBuy({_p}, {_id}, 1)
        else if click type is left mouse button with shift:
            bwStkBuy({_p}, {_id}, 10)
        else if click type is right mouse button:
            bwStkSell({_p}, {_id}, 1)
        else if click type is right mouse button with shift:
            bwStkSell({_p}, {_id}, 10)
        bwStkMenu({_p})

# =========================================================
# 14. JUMP & RUN (Pale Oak Druckplatten)
# =========================================================
# Wer auf eine Pale-Oak-Druckplatte tritt, startet das Jump & Run. Jede weitere Pale-Oak-Druckplatte
# ist automatisch ein Checkpoint. Fällst du tief, geht es zum letzten Checkpoint zurück.
# Ziel (optional, Admin): /jumprun setfinish  (auf der Ziel-Platte stehen). Wer sie im Jump & Run betritt,
# bekommt {@jr_reward} Punkte (alle {@jr_cooldown_minutes} Minuten, die Bestzeit wird immer gespeichert).
# Läuft nur ausserhalb von Arena-Welten. /jumprun stop beendet, /jumprun cp bringt dich zum Checkpoint.
# Kurzbefehl /jn: Jeder Checkpoint hat eine feste Nummer (1, 2, 3 ... in der Reihenfolge des Erreichens).
#   /jn checkpoint <Nummer> = dorthin, /jn checkpoint start = zum Start, /jn checkpoint = aktueller, /jn list.
#   Dieselbe Platte bekommt nie eine zweite Nummer. Wer zu Checkpoint 2 geht, wird bei einem Sturz auch dorthin gesetzt.
# Die 3 Jump-&-Run-Items liegen in den Hotbar-Slots 3, 4 und 5. Vorherige Items dieser Slots werden gemerkt.
function bwJrGive(p: player):
    set {_u} to "%uuid of {_p}%"
    if {bwx::jr::saved::%{_u}%} is not set:
        set {bwx::jr::saved::%{_u}%} to true
        loop 3 times:
            set {_s} to loop-number + 2
            delete {bwx::jr::item::%{_u}%::%{_s}%}
            if slot {_s} of {_p}'s inventory is not air:
                set {bwx::jr::item::%{_u}%::%{_s}%} to slot {_s} of {_p}'s inventory
    set slot 3 of {_p}'s inventory to red bed named "&a&l[JR] Zum Checkpoint"
    set slot 4 of {_p}'s inventory to clock named "&e&l[JR] Neustart"
    set slot 5 of {_p}'s inventory to barrier named "&c&l[JR] Verlassen"

function bwJrRestore(p: player):
    set {_u} to "%uuid of {_p}%"
    loop all items in {_p}'s inventory:
        if "%name of loop-item%" contains "[JR]":
            remove loop-item from {_p}'s inventory
    if {bwx::jr::saved::%{_u}%} is set:
        loop 3 times:
            set {_s} to loop-number + 2
            if {bwx::jr::item::%{_u}%::%{_s}%} is set:
                set slot {_s} of {_p}'s inventory to {bwx::jr::item::%{_u}%::%{_s}%}
        delete {bwx::jr::saved::%{_u}%}
        delete {bwx::jr::item::%{_u}%::*}

# Zurück an den Start: Checkpoints und Zeit werden zurückgesetzt
function bwJrReset(p: player):
    set {_u} to "%uuid of {_p}%"
    if {-bwx::jr::startloc::%{_u}%} is not set:
        stop
    set {_sl} to {-bwx::jr::startloc::%{_u}%}
    teleport {_p} to {_sl}
    set fall distance of {_p} to 0
    delete {-bwx::jr::seen::%{_u}%::*}
    delete {-bwx::jr::loc::%{_u}%::*}
    set {-bwx::jr::seen::%{_u}%::%{-bwx::jr::startkey::%{_u}%}%} to 0
    set {-bwx::jr::loc::%{_u}%::0} to {_sl}
    set {-bwx::jr::cur::%{_u}%} to 0
    set {-bwx::jr::cp::%{_u}%} to {_sl}
    set {-bwx::jr::n::%{_u}%} to 0
    set {-bwx::jr::falls::%{_u}%} to 0
    set {-bwx::jr::start::%{_u}%} to now
    send action bar "&e&lJump & Run neu gestartet" to {_p}
    play sound "entity.enderman.teleport" with volume 0.6 and pitch 1.2 to {_p}

function bwJrStop(p: player):
    set {_u} to "%uuid of {_p}%"
    bwJrRestore({_p})
    delete {-bwx::jr::seen::%{_u}%::*}
    delete {-bwx::jr::loc::%{_u}%::*}
    delete {-bwx::jr::cur::%{_u}%}
    delete {-bwx::jr::startloc::%{_u}%}
    delete {-bwx::jr::startkey::%{_u}%}
    delete {-bwx::jr::active::%{_u}%}
    delete {-bwx::jr::cp::%{_u}%}
    delete {-bwx::jr::n::%{_u}%}
    delete {-bwx::jr::start::%{_u}%}
    delete {-bwx::jr::plate::%{_u}%}
    delete {-bwx::jr::falls::%{_u}%}

# Zu Checkpoint Nummer {_n} teleportieren (0 = Start). Danach ist dieser Checkpoint der aktive
# (dorthin geht es auch, wenn man faellt). Die Nummer einer Platte bleibt fuer die ganze Runde gleich.
function bwJrGoto(p: player, n: number):
    set {_u} to "%uuid of {_p}%"
    if {-bwx::jr::active::%{_u}%} is not true:
        send "&cDu bist in keinem Jump & Run." to {_p}
        stop
    set {_max} to {-bwx::jr::n::%{_u}%}
    if {-bwx::jr::loc::%{_u}%::%{_n}%} is not set:
        if {_max} is 0:
            send "&cDu hast noch keinen Checkpoint erreicht. Tritt auf weitere Pale-Oak-Platten." to {_p}
        else:
            send "&cCheckpoint %{_n}% hast du noch nicht erreicht. Du hast die Checkpoints &f1 bis %{_max}%&c." to {_p}
        stop
    set {_loc} to {-bwx::jr::loc::%{_u}%::%{_n}%}
    teleport {_p} to {_loc}
    set fall distance of {_p} to 0
    set {-bwx::jr::cp::%{_u}%} to {_loc}
    set {-bwx::jr::cur::%{_u}%} to {_n}
    if {_n} is 0:
        send action bar "&aZurück zum Start." to {_p}
    else:
        send action bar "&aZurück zu Checkpoint %{_n}%." to {_p}
    play sound "entity.enderman.teleport" with volume 0.6 and pitch 1.2 to {_p}

function bwJrFinish(p: player, u: text):
    set {_t} to difference between {-bwx::jr::start::%{_u}%} and now
    set {_f} to {-bwx::jr::falls::%{_u}%}
    if {_f} is not set:
        set {_f} to 0
    bwJrStop({_p})
    send title "&a&lGESCHAFFT!" with subtitle "&7Zeit: &e%{_t}% &8| &7Stürze: &e%{_f}%" to {_p} for 4 seconds
    play sound "entity.player.levelup" with volume 1 and pitch 1 to {_p}
    if {bwx::jr::best::%{_u}%} is not set:
        set {bwx::jr::best::%{_u}%} to {_t}
        send "&6[Jump & Run] &7Neue Bestzeit: &e%{_t}%" to {_p}
    else if {_t} < {bwx::jr::best::%{_u}%}:
        set {bwx::jr::best::%{_u}%} to {_t}
        send "&6[Jump & Run] &aNeue Bestzeit: &e%{_t}%" to {_p}
    set {_ok} to true
    if {bwx::jr::last::%{_u}%} is set:
        if difference between {bwx::jr::last::%{_u}%} and now is less than {@jr_cooldown_minutes} minutes:
            set {_ok} to false
    if {_ok} is true:
        set {bwp::pts::%{_u}%} to bwPts({_u}) + {@jr_reward}
        set {bwx::jr::last::%{_u}%} to now
        send "&6[Jump & Run] &7Belohnung: &e+{@jr_reward} Punkte" to {_p}
    else:
        send "&6[Jump & Run] &7Eine Belohnung gibt es nur alle {@jr_cooldown_minutes} Minuten." to {_p}

on step on pale oak pressure plate:
    set {_p} to player
    if bwIsArena(world of {_p}) is true:
        stop
    if gamemode of {_p} is spectator:
        stop
    set {_u} to "%uuid of {_p}%"
    set {_l} to location of (block at (location of {_p}))
    set {_key} to "%{_l}%"
    set {_cp} to {_l} offset by vector(0.5, 0.2, 0.5)
    set yaw of {_cp} to yaw of {_p}
    set pitch of {_cp} to 0
    if {-bwx::jr::active::%{_u}%} is true:
        if {bwx::jrfinish::%name of world of {_p}%} is {_l}:
            bwJrFinish({_p}, {_u})
            stop
        # Schon bekannte Platte: sie behaelt ihre Nummer (wird NIE doppelt gezaehlt) und ist wieder der aktive Checkpoint
        if {-bwx::jr::seen::%{_u}%::%{_key}%} is set:
            set {_k} to {-bwx::jr::seen::%{_u}%::%{_key}%}
            if {-bwx::jr::loc::%{_u}%::%{_k}%} is set:
                if {-bwx::jr::cur::%{_u}%} is not {_k}:
                    set {-bwx::jr::cur::%{_u}%} to {_k}
                    set {-bwx::jr::cp::%{_u}%} to {-bwx::jr::loc::%{_u}%::%{_k}%}
                    if {_k} is 0:
                        send action bar "&aStart &7ist wieder aktiv" to {_p}
                    else:
                        send action bar "&aCheckpoint %{_k}% &7ist wieder aktiv" to {_p}
                    play sound "block.note_block.chime" with volume 1 and pitch 1.2 to {_p}
            stop
        # Neue Platte = naechster Checkpoint mit der naechsten freien Nummer
        set {_k} to {-bwx::jr::n::%{_u}%} + 1
        set {-bwx::jr::n::%{_u}%} to {_k}
        set {-bwx::jr::seen::%{_u}%::%{_key}%} to {_k}
        set {-bwx::jr::loc::%{_u}%::%{_k}%} to {_cp}
        set {-bwx::jr::cur::%{_u}%} to {_k}
        set {-bwx::jr::plate::%{_u}%} to {_l}
        set {-bwx::jr::cp::%{_u}%} to {_cp}
        send action bar "&a&lCheckpoint %{_k}% &7gespeichert" to {_p}
        play sound "block.note_block.chime" with volume 1 and pitch 1.5 to {_p}
        stop
    if {bwx::jrfinish::%name of world of {_p}%} is {_l}:
        send action bar "&cDas ist das Ziel! Starte das Jump & Run an einer anderen Platte." to {_p}
        stop
    set {-bwx::jr::active::%{_u}%} to true
    set {-bwx::jr::plate::%{_u}%} to {_l}
    set {-bwx::jr::cp::%{_u}%} to {_cp}
    set {-bwx::jr::n::%{_u}%} to 0
    set {-bwx::jr::falls::%{_u}%} to 0
    set {-bwx::jr::start::%{_u}%} to now
    delete {-bwx::jr::seen::%{_u}%::*}
    delete {-bwx::jr::loc::%{_u}%::*}
    set {-bwx::jr::seen::%{_u}%::%{_key}%} to 0
    set {-bwx::jr::loc::%{_u}%::0} to {_cp}
    set {-bwx::jr::cur::%{_u}%} to 0
    set {-bwx::jr::startloc::%{_u}%} to {_cp}
    set {-bwx::jr::startkey::%{_u}%} to {_key}
    bwJrGive({_p})
    send title "&6&lJUMP & RUN" with subtitle "&7Gestartet! Jede Platte ist ein nummerierter Checkpoint." to {_p} for 3 seconds
    send "&6[Jump & Run] &7Jede weitere &fPale-Oak-Druckplatte &7ist ein Checkpoint (1, 2, 3 ...). Zurück: &e/jn checkpoint <Nummer> &7| Beenden: &e/jn stop" to {_p}
    play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.2 to {_p}

every 2 ticks:
    loop all players:
        set {_u} to "%uuid of loop-player%"
        if {-bwx::jr::active::%{_u}%} is true:
            set {_cp} to {-bwx::jr::cp::%{_u}%}
            if world of loop-player is not world of {_cp}:
                bwJrStop(loop-player)
            else if y-coordinate of (location of loop-player) < (y-coordinate of {_cp}) - {@jr_fall_depth}:
                teleport loop-player to {_cp}
                set fall distance of loop-player to 0
                add 1 to {-bwx::jr::falls::%{_u}%}
                send action bar "&cGefallen! &7Zurück zum Checkpoint." to loop-player
                play sound "entity.enderman.teleport" with volume 0.6 and pitch 1.2 to loop-player

on quit:
    bwJrStop(player)

on world change:
    bwJrStop(player)

command /jumprun [<text>] [<text>]:
    aliases: jr, jn
    usage: /jn [checkpoint <Nummer> | list | stop | setfinish | delfinish]
    trigger:
        if sender is not a player:
            send "&cNur für Spieler!" to sender
            stop
        set {_u} to "%uuid of player%"
        if arg-1 is "stop" or "leave":
            if {-bwx::jr::active::%{_u}%} is true:
                bwJrStop(player)
                send "&6[Jump & Run] &7Beendet." to player
            else:
                send "&cDu bist in keinem Jump & Run." to player
            stop
        if arg-1 is "cp" or "checkpoint":
            if {-bwx::jr::active::%{_u}%} is not true:
                send "&cDu bist in keinem Jump & Run." to player
                stop
            # Ohne Nummer: zum aktuellen Checkpoint. "start" oder 0: zum Startpunkt
            if arg-2 is not set:
                bwJrGoto(player, {-bwx::jr::cur::%{_u}%})
                stop
            if arg-2 is "start":
                bwJrGoto(player, 0)
                stop
            set {_num} to arg-2 parsed as integer
            if {_num} is not set:
                send "&cNutzung: /jn checkpoint <Nummer> &7(oder &fstart&7)" to player
                stop
            bwJrGoto(player, {_num})
            stop
        if arg-1 is "list" or "liste":
            if {-bwx::jr::active::%{_u}%} is not true:
                send "&cDu bist in keinem Jump & Run." to player
                stop
            set {_max} to {-bwx::jr::n::%{_u}%}
            if {_max} is 0:
                send "&6[Jump & Run] &7Noch kein Checkpoint erreicht. Tritt auf weitere Pale-Oak-Platten." to player
                stop
            send "&6[Jump & Run] &7Erreichte Checkpoints: &f1 bis %{_max}% &8| &7Aktiv: &e%{-bwx::jr::cur::%{_u}%}% &8| &7Zurück: &e/jn checkpoint <Nummer>" to player
            stop
        if arg-1 is "setfinish":
            if player is not op:
                send "&cKeine Berechtigung." to player
                stop
            set {bwx::jrfinish::%name of world of player%} to location of (block at (location of player))
            send "&aZiel-Platte gesetzt (die Platte, auf der du stehst). Das Jump & Run endet dort." to player
            stop
        if arg-1 is "delfinish":
            if player is not op:
                send "&cKeine Berechtigung." to player
                stop
            delete {bwx::jrfinish::%name of world of player%}
            send "&aZiel-Platte entfernt." to player
            stop
        send "&6[Jump & Run] &7Tritt auf eine &fPale-Oak-Druckplatte&7, um zu starten. Weitere Platten sind nummerierte Checkpoints (&e/jn checkpoint <Nummer>&7)." to player
        if {bwx::jr::best::%{_u}%} is set:
            send "&7Deine Bestzeit: &e%{bwx::jr::best::%{_u}%}%" to player

# Die 3 Jump-&-Run-Items (Bett = Checkpoint, Uhr = Neustart, Barriere = Verlassen)
on rightclick:
    set {_n} to "%name of player's tool%"
    if {_n} contains "[JR]":
        cancel event
        set {_u} to "%uuid of player%"
        if {-bwx::jr::active::%{_u}%} is not true:
            bwJrRestore(player)
            stop
        if {_n} contains "Checkpoint":
            teleport player to {-bwx::jr::cp::%{_u}%}
            set fall distance of player to 0
            send action bar "&aZurück zum Checkpoint." to player
        else if {_n} contains "Neustart":
            bwJrReset(player)
        else if {_n} contains "Verlassen":
            bwJrStop(player)
            send "&6[Jump & Run] &7Beendet." to player

on drop:
    if "%name of event-item%" contains "[JR]":
        cancel event

on inventory click:
    if "%name of event-item%" contains "[JR]":
        cancel event

# Falls der Server mit aktivem Jump & Run abgestürzt ist: Items beim Join zurückgeben
on join:
    if {bwx::jr::saved::%uuid of player%} is set:
        bwJrRestore(player)

# Admin: Pale-Oak-Druckplatte direkt unter dir setzen
command /jrplatte:
    aliases: jrplate
    usage: /jrplatte
    trigger:
        if sender is not a player:
            send "&cNur für Spieler!" to sender
            stop
        if player is not op:
            send "&cKeine Berechtigung." to player
            stop
        set block at location of player to pale oak pressure plate
        send "&aPale-Oak-Druckplatte unter dir gesetzt." to player

# =========================================================
# 15. SPRUCE-TÜREN UND DRUCKPLATTEN FÜR ALLE SPIELER
# =========================================================
# Spruce-Türen dürfen alle Spieler benutzen. Das Skript hebt einen Abbruch des Klicks auf, sofern der Server
# abgebrochene Klicks überhaupt an Skript weitergibt. Ein Schutz-Plugin (z.B. WorldGuard, Lobby-Schutz)
# kann ein Skript NICHT zuverlässig überstimmen: dort muss die Berechtigung bzw. das Flag "use" gesetzt
# werden (Anleitung in der Antwort). Druckplatten funktionieren für alle Spieler (Jump & Run oben).
# DEAKTIVIERT: Tueren sind in der Lobby jetzt per WorldGuard-Blacklist gesperrt. Dieser Block hat den
# Schutz bei Spruce-Tueren wieder aufgehoben (uncancel event) und Tueren damit doch benutzbar gemacht.
#on rightclick on spruce door with priority highest:
#    if event is cancelled:
#        uncancel event

# =========================================================
# 16./17. ROULETTE und BLACKJACK: siehe BedwarsGamble.sk
# =========================================================

# =========================================================
# 18. /chelp: INTERAKTIVES HILFE-MENÜ (GUI)
# =========================================================
# Hauptmenü mit Kategorien. Ein Klick auf einen Befehl führt ihn aus (ohne Argumente) oder zeigt die
# Nutzung im Chat (Befehle mit Argumenten). Admin-Kategorie nur für OPs.
function bwHelpItem(i: item, n: text, d: text, a: text) :: item:
    set {_x} to {_i}
    set name of {_x} to {_n}
    if {_a} starts with "run:":
        set lore of {_x} to {_d} and " " and "&aKlick: ausführen" and "&8[hlp=%{_a}%]"
    else if {_a} starts with "flow:":
        set lore of {_x} to {_d} and " " and "&aKlick: Auswahl öffnen" and "&8[hlp=%{_a}%]"
    else:
        set lore of {_x} to {_d} and " " and "&eKlick: Nutzung anzeigen" and "&8[hlp=%{_a}%]"
    return {_x}

# Spielerauswahl für /pay, /addpoints, /stats
function bwHelpPick(p: player, mode: text):
    set {-bwx::hlp::mode::%uuid of {_p}%} to {_mode}
    set {_inv} to chest inventory with 6 rows named "&6&lHilfe &8- &7Spieler wählen"
    loop 54 times:
        set {_s} to loop-number - 1
        set slot {_s} of {_inv} to gray stained glass pane named " "
    set {_n} to 0
    loop all players:
        if {_n} < 45:
            set {_skip} to false
            if {_mode} is "pay":
                if loop-player is {_p}:
                    set {_skip} to true
            if {_skip} is false:
                set {_x} to player head
                set skull owner of {_x} to loop-player
                set name of {_x} to "&f%name of loop-player%"
                set lore of {_x} to "&7Klicken zum Auswählen" and "&8[hlp=who:%name of loop-player%]"
                set slot {_n} of {_inv} to {_x}
                add 1 to {_n}
    set {_x} to arrow named "&7Zurück"
    set lore of {_x} to "&8[hlp=cat:main]"
    set slot 49 of {_inv} to {_x}
    open {_inv} to {_p}

# Mengenauswahl für /pay und /addpoints
function bwHelpAmt(p: player):
    set {_u} to "%uuid of {_p}%"
    set {_inv} to chest inventory with 3 rows named "&6&lHilfe &8- &7Menge wählen"
    loop 27 times:
        set {_s} to loop-number - 1
        set slot {_s} of {_inv} to gray stained glass pane named " "
    set {_n} to 0
    loop 10, 50, 100, 500, 1000 and 5000:
        set {_sl} to 10 + {_n}
        set {_x} to gold nugget named "&e%loop-value% Punkte"
        set lore of {_x} to "&7An &f%{-bwx::hlp::target::%{_u}%}%" and "&8[hlp=amt:%loop-value%]"
        set slot {_sl} of {_inv} to {_x}
        add 1 to {_n}
    set {_x} to nether star named "&c&lAlles"
    set lore of {_x} to "&7Dein ganzes Guthaben (&e%bwPts({_u})%&7)" and "&8[hlp=amt:all]"
    set slot 16 of {_inv} to {_x}
    set {_x} to writable book named "&bEigene Zahl"
    set lore of {_x} to "&7Du schreibst die Menge in den Chat" and "&8[hlp=amt:chat]"
    set slot 22 of {_inv} to {_x}
    set {_x} to book named "&6Empfänger: &f%{-bwx::hlp::target::%{_u}%}%"
    set lore of {_x} to "&7Dein Guthaben: &e%bwPts({_u})% Punkte"
    set slot 4 of {_inv} to {_x}
    set {_x} to arrow named "&7Zurück"
    set lore of {_x} to "&8[hlp=cat:main]"
    set slot 26 of {_inv} to {_x}
    open {_inv} to {_p}

# Auswahl aus Listen (Arenen, Teams, Inhaber, Smaragd-Spawner)
function bwHelpChoose(p: player, mode: text):
    set {-bwx::hlp::mode::%uuid of {_p}%} to {_mode}
    set {_inv} to chest inventory with 6 rows named "&6&lHilfe &8- &7Auswahl"
    loop 54 times:
        set {_s} to loop-number - 1
        set slot {_s} of {_inv} to gray stained glass pane named " "
    set {_n} to 0
    if {_mode} is "join" or "gamestop":
        loop all worlds:
            if bwIsArena(loop-world) is true:
                if {_n} < 45:
                    set {_x} to red bed named "&f%name of loop-world%"
                    set lore of {_x} to "&7Spieler: &e%size of (all players in loop-world)%" and "&8[hlp=sel:%name of loop-world%]"
                    set slot {_n} of {_inv} to {_x}
                    add 1 to {_n}
    else if {_mode} is "top":
        loop "kills", "wins", "beds", "finalkills", "games", "deaths", "level" and "punkte":
            set {_x} to paper named "&e%loop-value%"
            set lore of {_x} to "&7Top 10 anzeigen" and "&8[hlp=sel:%loop-value%]"
            set slot {_n} of {_inv} to {_x}
            add 1 to {_n}
    else if {_mode} is "resetall":
        set {_x} to lime concrete named "&aJa: Punkte, Level, Statistiken ALLER Spieler zurücksetzen"
        set lore of {_x} to "&7Gekaufte Kosmetika bleiben" and "&8[hlp=sel:yes]"
        set slot 20 of {_inv} to {_x}
        set {_x} to red concrete named "&cJa: zusätzlich auch alle Kosmetika löschen"
        set lore of {_x} to "&7Unwiderruflich!" and "&8[hlp=sel:yeskos]"
        set slot 24 of {_inv} to {_x}
        set {_n} to 2
    else if {_mode} is "esadd":
        loop "red", "blue", "green", "yellow", "cyan", "white", "pink", "gray", "lime", "orange", "magenta", "light_blue", "light_gray", "brown" and "black":
            set {_x} to bwTeamWool(loop-value)
            set name of {_x} to "%bwTeamColor(loop-value)%%bwTeamNameDE(loop-value)%"
            set lore of {_x} to "&7Team wählen" and "&8[hlp=sel:%loop-value%]"
            set slot {_n} of {_inv} to {_x}
            add 1 to {_n}
    else if {_mode} is "ownrem":
        loop {bwx::owner::*}:
            if {_n} < 45:
                set {_x} to golden helmet named "&f%loop-index%"
                set lore of {_x} to "&7%loop-value%" and "&8[hlp=sel:%loop-index%]"
                set slot {_n} of {_inv} to {_x}
                add 1 to {_n}
    else if {_mode} is "esrem":
        loop {bw::esp::*}:
            if {_n} < 45:
                set {_x} to emerald block named "&f%loop-index%"
                set lore of {_x} to "&7Team: %{bw::espteam::%loop-index%}%" and "&8[hlp=sel:%loop-index%]"
                set slot {_n} of {_inv} to {_x}
                add 1 to {_n}
    else if {_mode} is "jrcp":
        set {_uu} to "%uuid of {_p}%"
        if {-bwx::jr::active::%{_uu}%} is true:
            set {_x} to ender eye named "&aStart"
            set lore of {_x} to "&7Zurück zum Startpunkt" and "&8[hlp=sel:0]"
            set slot {_n} of {_inv} to {_x}
            add 1 to {_n}
            loop {-bwx::jr::n::%{_uu}%} times:
                if {_n} < 45:
                    set {_x} to pale oak pressure plate named "&aCheckpoint %loop-number%"
                    if {-bwx::jr::cur::%{_uu}%} is loop-number:
                        set lore of {_x} to "&e► Aktiver Checkpoint" and "&7Klicken zum Teleportieren" and "&8[hlp=sel:%loop-number%]"
                    else:
                        set lore of {_x} to "&7Klicken zum Teleportieren" and "&8[hlp=sel:%loop-number%]"
                    set slot {_n} of {_inv} to {_x}
                    add 1 to {_n}
    if {_n} is 0:
        set {_x} to barrier named "&cNichts zur Auswahl vorhanden"
        set slot 22 of {_inv} to {_x}
    set {_x} to arrow named "&7Zurück"
    set lore of {_x} to "&8[hlp=cat:main]"
    set slot 49 of {_inv} to {_x}
    open {_inv} to {_p}

function bwHelpMain(p: player):
    set {_inv} to chest inventory with 4 rows named "&6&lBedwars-Hilfe"
    loop 36 times:
        set {_s} to loop-number - 1
        set slot {_s} of {_inv} to gray stained glass pane named " "
    set slot 10 of {_inv} to bwHelpItem(iron sword, "&cSpielen", "&7Beitreten, verlassen, zuschauen, Jump & Run", "cat:play")
    set slot 11 of {_inv} to bwHelpItem(gold ingot, "&6Punkte & Wirtschaft", "&7Punkte, /pay, Bank, Aktien", "cat:eco")
    set slot 12 of {_inv} to bwHelpItem(nether star, "&dGamble-Hub", "&7Glücksrad, Münzwurf, Slots, Roulette, Blackjack", "cat:gamble")
    set slot 13 of {_inv} to bwHelpItem(blaze powder, "&eKosmetik & Einstellungen", "&7Effekte kaufen, Hotbar sortieren", "cat:cos")
    set slot 14 of {_inv} to bwHelpItem(book, "&bInfo & Statistik", "&7Stats, Bestenliste, Inhaber, Vorschläge", "cat:info")
    if {_p} is op:
        set slot 16 of {_inv} to bwHelpItem(command block, "&4Admin", "&7Nur für Admins", "cat:admin")
    set slot 31 of {_inv} to bwHelpItem(barrier, "&cSchliessen", "&7Menü schliessen", "close")
    open {_inv} to {_p}

function bwHelpCat(p: player, c: text):
    # Normale Kategorien: 4 Zeilen (Zurueck-Pfeil auf Slot 31). Admin: 6 Zeilen, nach Bereichen geordnet.
    set {_rows} to 4
    set {_back} to 31
    set {_title} to "&6&lHilfe &8- &7Befehle"
    if {_c} is "admin":
        set {_rows} to 6
        set {_back} to 49
        set {_title} to "&6&lHilfe &8- &4Admin"
    set {_inv} to chest inventory with {_rows} rows named {_title}
    loop ({_rows} * 9) times:
        set {_s} to loop-number - 1
        set slot {_s} of {_inv} to gray stained glass pane named " "
    if {_c} is "play":
        # Reihe 1: Arena-Befehle
        set slot 10 of {_inv} to bwHelpItem(iron sword, "&e/bw join", "&7Arena aus der Liste wählen und beitreten", "flow:join")
        set slot 11 of {_inv} to bwHelpItem(paper, "&e/bw list", "&7Alle Arenen anzeigen", "run:bw list")
        set slot 12 of {_inv} to bwHelpItem(red bed, "&e/bw leave", "&7Arena verlassen", "run:bw leave")
        set slot 13 of {_inv} to bwHelpItem(ender pearl, "&e/bw rejoin", "&7Erneut beitreten", "run:bw rejoin")
        set slot 14 of {_inv} to bwHelpItem(compass, "&e/bw autojoin", "&7Zufällige Arena", "run:bw autojoin")
        set slot 15 of {_inv} to bwHelpItem(spyglass, "&e/spectate", "&7Einem laufenden Spiel zuschauen (Spielerauswahl, Folgen)", "run:spectate")
        # Reihe 2: Gruppe und Chat
        set slot 19 of {_inv} to bwHelpItem(player head, "&e/party", "&7Party-Befehle", "run:party")
        set slot 20 of {_inv} to bwHelpItem(goat horn, "&e/shout <Nachricht>", "&7An alle schreiben (auch Präfix @a / @t)", "flow:shout")
        # Reihe 3: Jump & Run
        set slot 28 of {_inv} to bwHelpItem(pale oak pressure plate, "&eJump & Run", "&7Tritt auf eine Pale-Oak-Druckplatte. Platten = nummerierte Checkpoints", "say:/jn checkpoint <Nummer>  |  /jn list  |  /jn stop")
        set slot 29 of {_inv} to bwHelpItem(ender eye, "&eCheckpoint wählen", "&7/jn checkpoint <Nummer>", "flow:jrcp")
        set slot 30 of {_inv} to bwHelpItem(barrier, "&eJump & Run beenden", "&7/jn stop", "run:jumprun stop")
    else if {_c} is "eco":
        set slot 10 of {_inv} to bwHelpItem(gold ingot, "&e/punkte", "&7Dein Level, XP, Punkte, Bank, Depot", "run:punkte")
        set slot 11 of {_inv} to bwHelpItem(emerald, "&e/pay <Spieler> <Anzahl>", "&7Punkte an einen Spieler überweisen", "flow:pay")
        set slot 12 of {_inv} to bwHelpItem(gold block, "&e/bank", "&7Punkte anlegen, Zinsen kassieren", "run:bank")
        set slot 13 of {_inv} to bwHelpItem(diamond, "&e/aktien", "&7Börse: Aktien kaufen und verkaufen", "run:aktien")
        set slot 14 of {_inv} to bwHelpItem(clock, "&e/gamble bonus", "&7Täglicher Bonus", "run:gamble bonus")
    else if {_c} is "gamble":
        set slot 10 of {_inv} to bwHelpItem(nether star, "&e/gamble", "&7Gamble-Hub", "run:gamble")
        set slot 11 of {_inv} to bwHelpItem(nether star, "&6Glücksrad", "&7/gamble rad", "run:gamble rad")
        set slot 12 of {_inv} to bwHelpItem(gold ingot, "&eMünzwurf", "&7/gamble muenzwurf", "run:gamble muenzwurf")
        set slot 13 of {_inv} to bwHelpItem(diamond, "&bSpielautomat", "&7/gamble slots", "run:gamble slots")
        set slot 14 of {_inv} to bwHelpItem(red concrete, "&4Roulette", "&7/gamble roulette", "run:gamble roulette")
        set slot 15 of {_inv} to bwHelpItem(paper, "&2Blackjack", "&7/gamble blackjack", "run:gamble blackjack")
        set slot 16 of {_inv} to bwHelpItem(book, "&dStatistik", "&7/gamble stats", "run:gamble stats")
    else if {_c} is "cos":
        set slot 10 of {_inv} to bwHelpItem(blaze powder, "&e/kosmetik", "&7Pfeilspuren, Betten-Explosionen, Kill-Effekte", "run:kosmetik")
        set slot 11 of {_inv} to bwHelpItem(comparator, "&e/settings", "&7Hotbar-Sortierung und Quickshop", "run:settings")
    else if {_c} is "info":
        set slot 10 of {_inv} to bwHelpItem(paper, "&e/stats [Spieler]", "&7Kills, Siege, Betten ... (Spieler wählen)", "flow:stats")
        set slot 11 of {_inv} to bwHelpItem(diamond sword, "&e/top", "&7Bestenliste: Art im Menü wählen", "flow:top")
        set slot 12 of {_inv} to bwHelpItem(golden helmet, "&e/inhaber", "&7Die Inhaber des Servers", "run:inhaber")
        set slot 13 of {_inv} to bwHelpItem(writable book, "&e/vorschlag <Text>", "&7Vorschlag einreichen (alle {@suggest_hours} Stunden)", "flow:suggest")
        set slot 14 of {_inv} to bwHelpItem(map, "&e/bw stats", "&7Deine SBW-Statistik", "run:bw stats")
        set slot 15 of {_inv} to bwHelpItem(gold block, "&e/bw leaderboard", "&7SBW-Bestenliste", "run:bw leaderboard")
    else if {_c} is "admin":
        if {_p} is not op:
            stop
        # Jede Reihe ist ein Bereich, links steht die Ueberschrift (Slots 9, 18, 27, 36)
        set slot 9 of {_inv} to red banner named "&c&lSpiel & Arenen"
        set slot 10 of {_inv} to bwHelpItem(barrier, "&c/game stop", "&7Arena wählen, Spiel abbrechen", "flow:gamestop")
        set slot 11 of {_inv} to bwHelpItem(armor stand, "&c/teamdebug", "&7Team, Teamtruhe, Forge-Stufe", "run:teamdebug")
        set slot 12 of {_inv} to bwHelpItem(furnace, "&c/resetteamchests", "&7Rundendaten aller Welten löschen", "run:resetteamchests")
        set slot 13 of {_inv} to bwHelpItem(leather chestplate, "&c/resetteamcolors", "&7Gelernte Teamfarben löschen", "run:resetteamcolors")
        set slot 14 of {_inv} to bwHelpItem(clock, "&c/arenanormal", "&7Schwierigkeit deiner Welt auf normal", "run:arenanormal")
        set slot 15 of {_inv} to bwHelpItem(experience bottle, "&c/noadvancements", "&7Advancement-Meldungen in deiner Welt aus", "run:noadvancements")
        set slot 16 of {_inv} to bwHelpItem(compass, "&c/setbwlobby", "&7Lobby-Punkt setzen", "run:setbwlobby")
        set slot 18 of {_inv} to orange banner named "&6&lSpieler & Server"
        set slot 19 of {_inv} to bwHelpItem(emerald, "&c/addpoints <Spieler> <Anzahl>", "&7Punkte geben", "flow:addpoints")
        set slot 20 of {_inv} to bwHelpItem(tnt, "&c/resetstats", "&7Spieler wählen, Statistiken zurücksetzen", "flow:resetstats")
        set slot 21 of {_inv} to bwHelpItem(redstone, "&c/resetstats all", "&7Alle Spieler zurücksetzen (mit Bestätigung)", "flow:resetall")
        set slot 22 of {_inv} to bwHelpItem(golden helmet, "&c/inhaber add", "&7Name und Rolle in den Chat schreiben", "flow:ownadd")
        set slot 23 of {_inv} to bwHelpItem(barrier, "&cInhaber entfernen", "&7Aus der Liste wählen", "flow:ownrem")
        set slot 24 of {_inv} to bwHelpItem(writable book, "&c/vorschlaege", "&7Vorschläge lesen, verwalten, zurücksetzen", "run:vorschlaege")
        set slot 25 of {_inv} to bwHelpItem(paper, "&c/qsstatus [reset]", "&7Gelernte Quickshop-Items", "run:qsstatus")
        set slot 27 of {_inv} to green banner named "&a&lSmaragd-Spawner"
        set slot 28 of {_inv} to bwHelpItem(emerald block, "&cSmaragd-Spawner setzen", "&7Team wählen, Namen in den Chat schreiben. Stehe an der Stelle!", "flow:esadd")
        set slot 29 of {_inv} to bwHelpItem(barrier, "&cSmaragd-Spawner entfernen", "&7Aus der Liste wählen", "flow:esrem")
        set slot 30 of {_inv} to bwHelpItem(paper, "&cSmaragd-Spawner Liste", "&7/emeraldspawner list", "run:emeraldspawner list")
        set slot 31 of {_inv} to bwHelpItem(emerald, "&cSmaragd-Vorlage", "&7Smaragd aus Map-Spawner in der Hand halten", "run:emeraldspawner template")
        set slot 36 of {_inv} to light blue banner named "&b&lJump & Run"
        set slot 37 of {_inv} to bwHelpItem(pale oak pressure plate, "&c/jumprun setfinish", "&7Ziel-Platte setzen (auf der Platte stehen)", "run:jumprun setfinish")
        set slot 38 of {_inv} to bwHelpItem(pale oak pressure plate, "&c/jumprun delfinish", "&7Ziel-Platte entfernen", "run:jumprun delfinish")
        set slot 39 of {_inv} to bwHelpItem(pale oak pressure plate, "&c/jrplatte", "&7Pale-Oak-Druckplatte direkt unter dir setzen", "run:jrplatte")
        set slot 45 of {_inv} to yellow banner named "&e&lLevel, XP & Werkzeuge"
        set slot 46 of {_inv} to bwHelpItem(experience bottle, "&c/level add <Spieler> [Anzahl]", "&7Spieler wählen, Level um 1 erhöhen (mehr per Befehl)", "flow:leveladd")
        set slot 47 of {_inv} to bwHelpItem(barrier, "&c/xp reset <Spieler>", "&7XP und Level eines Spielers zurücksetzen", "flow:xpreset")
        set slot 48 of {_inv} to bwHelpItem(leather chestplate, "&c/teamitem <Farbe>", "&7Brustplatte einer Teamfarbe holen (z.B. red, blue)", "say:/teamitem <Farbe>")
        set slot 50 of {_inv} to bwHelpItem(spyglass, "&c/itemdebug", "&7Name, Lore und Typ des Items in deiner Hand", "run:itemdebug")
    set slot {_back} of {_inv} to bwHelpItem(arrow, "&7Zurück", "&7Zum Hauptmenü", "cat:main")
    open {_inv} to {_p}

command /chelp:
    trigger:
        if sender is not a player:
            send "&cNur für Spieler!" to sender
            stop
        bwHelpMain(player)

on inventory click:
    set {_t} to "%name of player's current inventory%"
    if {_t} contains "Hilfe":
        cancel event
        set {_ci} to event-item
        if {_ci} is not set:
            stop
        set {_l} to "%lore of {_ci}%"
        if {_l} does not contain "[hlp=":
            stop
        set {_p} to player
        set {_parts::*} to split {_l} at "[hlp="
        set {_rest::*} to split "%{_parts::2}%" at "]"
        set {_a} to {_rest::1}
        wait 1 tick
        if {_a} is "close":
            close {_p}'s inventory
            stop
        if {_a} is "cat:main":
            bwHelpMain({_p})
            stop
        if {_a} starts with "cat:":
            replace all "cat:" with "" in {_a}
            bwHelpCat({_p}, {_a})
            stop
        if {_a} starts with "run:":
            replace all "run:" with "" in {_a}
            close {_p}'s inventory
            make {_p} execute command {_a}
            stop
        set {_u} to "%uuid of {_p}%"
        if {_a} starts with "flow:":
            replace all "flow:" with "" in {_a}
            delete {-bwx::hlp::target::%{_u}%}
            if {_a} is "suggest" or "shout" or "ownadd":
                close {_p}'s inventory
                set {-bwx::hlp::input::%{_u}%} to {_a}
                if {_a} is "ownadd":
                    send "&6[Hilfe] &7Schreibe &fName Rolle &7in den Chat, z.B. &fSteve Owner&7. &8(&eabbrechen&8 = Abbruch)" to {_p}
                else:
                    send "&6[Hilfe] &7Schreibe jetzt deinen Text in den Chat. &8(&eabbrechen&8 = Abbruch)" to {_p}
                stop
            if {_a} is "join" or "gamestop" or "esadd" or "ownrem" or "esrem" or "top" or "resetall" or "jrcp":
                bwHelpChoose({_p}, {_a})
                stop
            bwHelpPick({_p}, {_a})
            stop
        if {_a} starts with "sel:":
            replace all "sel:" with "" in {_a}
            set {_mode} to {-bwx::hlp::mode::%{_u}%}
            close {_p}'s inventory
            if {_mode} is "join":
                make {_p} execute command "bw join %{_a}%"
            else if {_mode} is "gamestop":
                make {_p} execute command "game stop %{_a}%"
            else if {_mode} is "ownrem":
                make {_p} execute command "inhaber remove %{_a}%"
            else if {_mode} is "esrem":
                make {_p} execute command "emeraldspawner remove %{_a}%"
            else if {_mode} is "jrcp":
                make {_p} execute command "jn checkpoint %{_a}%"
            else if {_mode} is "top":
                make {_p} execute command "top %{_a}%"
            else if {_mode} is "resetall":
                if {_p} is op:
                    if {_a} is "yes":
                        make {_p} execute command "resetstats all confirm"
                    else if {_a} is "yeskos":
                        make {_p} execute command "resetstats all confirm kosmetik"
            else if {_mode} is "esadd":
                set {-bwx::hlp::target::%{_u}%} to {_a}
                set {-bwx::hlp::input::%{_u}%} to "esadd"
                send "&6[Hilfe] &7Schreibe den Namen/die Nummer des Spawners in den Chat (du musst an der richtigen Stelle stehen). &8(&eabbrechen&8 = Abbruch)" to {_p}
            stop
        if {_a} starts with "who:":
            replace all "who:" with "" in {_a}
            set {-bwx::hlp::target::%{_u}%} to {_a}
            if {-bwx::hlp::mode::%{_u}%} is "stats":
                close {_p}'s inventory
                make {_p} execute command "stats %{_a}%"
                stop
            if {-bwx::hlp::mode::%{_u}%} is "resetstats":
                close {_p}'s inventory
                make {_p} execute command "resetstats %{_a}%"
                stop
            if {-bwx::hlp::mode::%{_u}%} is "leveladd":
                close {_p}'s inventory
                make {_p} execute command "level add %{_a}%"
                stop
            if {-bwx::hlp::mode::%{_u}%} is "xpreset":
                close {_p}'s inventory
                make {_p} execute command "xp reset %{_a}%"
                stop
            bwHelpAmt({_p})
            stop
        if {_a} starts with "amt:":
            replace all "amt:" with "" in {_a}
            set {_mode} to {-bwx::hlp::mode::%{_u}%}
            set {_t2} to {-bwx::hlp::target::%{_u}%}
            if {_mode} is not set:
                stop
            if {_t2} is not set:
                stop
            if {_mode} is "addpoints":
                if {_p} is not op:
                    close {_p}'s inventory
                    stop
            if {_a} is "chat":
                close {_p}'s inventory
                set {-bwx::hlp::input::%{_u}%} to {_mode}
                send "&6[Hilfe] &7Schreibe jetzt die Menge in den Chat. &8(&eabbrechen&8 = Abbruch)" to {_p}
                stop
            if {_a} is "all":
                set {_a} to "%bwPts({_u})%"
            close {_p}'s inventory
            make {_p} execute command "%{_mode}% %{_t2}% %{_a}%"
            stop
        if {_a} starts with "say:":
            replace all "say:" with "" in {_a}
            close {_p}'s inventory
            send "&6[Hilfe] &7Nutzung: &e%{_a}%" to {_p}

# Texteingabe aus dem Hilfe-Menü (eigene Menge, Vorschlag, Shout)
on chat with priority lowest:
    set {_u} to "%uuid of player%"
    set {_mode} to {-bwx::hlp::input::%{_u}%}
    if {_mode} is not set:
        stop
    cancel event
    delete {-bwx::hlp::input::%{_u}%}
    set {_m} to message
    set {_p} to player
    wait 1 tick
    if {_m} is "abbrechen":
        send "&6[Hilfe] &7Abgebrochen." to {_p}
        stop
    if {_mode} is "suggest":
        make {_p} execute command "vorschlag %{_m}%"
        stop
    if {_mode} is "shout":
        make {_p} execute command "shout %{_m}%"
        stop
    if {_mode} is "ownadd":
        make {_p} execute command "inhaber add %{_m}%"
        stop
    if {_mode} is "esadd":
        make {_p} execute command "emeraldspawner add %{_m}% %{-bwx::hlp::target::%{_u}%}%"
        stop
    set {_n} to {_m} parsed as integer
    if {_n} is not set:
        send "&cDas ist keine ganze Zahl. Abgebrochen." to {_p}
        stop
    make {_p} execute command "%{_mode}% %{-bwx::hlp::target::%{_u}%}% %{_n}%"

# =========================================================
# 19. /inhaber
# =========================================================
# Zeigt die Inhaber des Servers. Admins pflegen die Liste im Spiel:
#   /inhaber add <Name> [Rolle]    /inhaber remove <Name>
command /inhaber [<text>] [<text>] [<text>]:
    aliases: owner, owners
    usage: /inhaber
    trigger:
        if arg-1 is "add":
            if sender is not op:
                send "&cKeine Berechtigung." to sender
                stop
            if arg-2 is not set:
                send "&cNutzung: /inhaber add <Name> [Rolle]" to sender
                stop
            set {_role} to "Inhaber"
            if arg-3 is set:
                set {_role} to arg-3
            set {bwx::owner::%arg-2%} to {_role}
            send "&a%arg-2% wurde als &f%{_role}% &aeingetragen." to sender
            stop
        if arg-1 is "remove":
            if sender is not op:
                send "&cKeine Berechtigung." to sender
                stop
            if arg-2 is not set:
                send "&cNutzung: /inhaber remove <Name>" to sender
                stop
            delete {bwx::owner::%arg-2%}
            send "&a%arg-2% wurde entfernt." to sender
            stop
        send "&8&m-----------&r &6&lServer-Inhaber &8&m-----------" to sender
        if size of {bwx::owner::*} is 0:
            send "&7Noch keine Inhaber eingetragen." to sender
            if sender is op:
                send "&7Admins: &e/inhaber add <Name> [Rolle]" to sender
        else:
            loop {bwx::owner::*}:
                send "&e★ &f&l%loop-index% &8- &7%loop-value%" to sender
        send "&8&m------------------------------------" to sender
