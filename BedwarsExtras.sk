# =========================================================
# BEDWARS EXTRAS (zweite Datei, ergänzt Bedwars.sk)
#  1. Hilfsfunktionen
#  2. /spectate  (Zuschauer-System, neu)
#  3. Feuerball-Knockback (stark reduziert)
#  4. Tabliste: Teamfarbe + Level
#  5. Statistik: /stats, /top
#  6. Punkte: /punkte, /pay
#  7. Admin: /resetstats, /game stop, /cancelgame, /setbwlobby
#  8. Kosmetik-Shop: /kosmetik (erweitert, ab 5000 Punkten)
#  9. Chat: Slowmode + Anti-Spam (max. 2x gleiche Nachricht)
# 10. Achievements aus
# 11. Vorschläge: /vorschlag, /vorschlaege (Admins ohne Cooldown, mit Reset)
# 12. Bank  13. Aktien  14. Jump & Run  15. Spruce-Türen
# 16. Roulette  17. Blackjack  18. /chelp GUI  19. /inhaber
# Benötigt Bedwars.sk (bwTeam, bwPts, bwXp, bwLevelOf, bwAddPoints, ...)
# =========================================================

options:
    # Name der Gamerule fuer Advancement-Meldungen (neue MC-Versionen: show_advancement_messages,
    # aeltere: announceAdvancements). Im Spiel mit /gamerule + Tab-Taste nachsehen.
    advancement_rule: show_advancement_messages
    # Muss zu Bedwars.sk passen (gleiche Werte wie dort)
    lobby_world: Lobby
    squad_worlds: BedwarsRooftop,BedwarsWilderWestern,BedwarsPlayground
    # true = dieses Skript setzt die Tab-Namen (Level/Team). false = TAB-Plugin übernimmt (empfohlen mit TAB)
    tab_skript: false
    # true = dieses Skript schickt Level + Teamfarbe an das TAB-Plugin (/tab player ...), der Rang kommt
    # live aus LuckPerms (%luckperms-prefix%). Gilt für ALLE LuckPerms-Gruppen. Nur aktiv, wenn tab_skript: false
    tab_bridge: true
    # Alle Welten, deren Name mit diesem Text beginnt, zählen zusätzlich als Arena-Welt
    arena_prefix: Bedwars
    # Spectate: so weit darf sich ein Zuschauer vom nächsten aktiven Spieler entfernen (Blöcke)
    spec_leash: 120
    # Feuerball-Knockback (Geschwindigkeit pro Tick, nicht Blöcke!):
    #   direkt  h=0.55 / y=0.45  -> ca. 4-5 Blöcke Weite
    #   nahe    h=0.32 / y=0.35  -> ca. 2-3 Blöcke Weite
    # Alles bis fb_direct_range Blöcke Abstand zur Explosion zählt als Direkttreffer
    fb_direct_range: 2.2
    fb_direct_h: 0.55
    fb_direct_y: 0.45
    fb_near_h: 0.32
    fb_near_y: 0.35
    # Feuerball: Cooldown in Sekunden (weisser Balken in der Hotbar)
    fb_cooldown: 1.5
    # Feuerball: Y-Geschwindigkeit beim Draufspringen (ca. 8 Bloecke) bzw. Springen + Sprinten (ca. 10 Bloecke)
    fb_jump_y: 1.185
    fb_sprint_y: 1.343
    fb_sprint_h: 0.7
    # Windcharge: zusaetzlicher Rueckstoss (Radius in Bloecken, Hoch-Schub, Weg-Schub)
    wc_radius: 3.5
    wc_up: 0.6
    wc_push: 0.3
    # Chat: Sekunden zwischen zwei Nachrichten (0 = Slowmode aus)
    chat_seconds: 60
    # Dieselbe Nachricht maximal so oft hintereinander, danach so viele Minuten Sperre nur für diese Nachricht
    chat_repeat_max: 2
    chat_repeat_minutes: 5
    # Vorschläge: Stunden zwischen zwei Vorschlägen pro Spieler (Admins: kein Cooldown)
    suggest_hours: 5
    # Bank: Zinsen in Prozent pro Stunde, maximaler Kontostand
    bank_rate: 1
    bank_max: 100000
    # Aktien: Gebühr pro Kauf/Verkauf in Prozent
    stock_fee: 2
    # Roulette / Blackjack: Maximaleinsatz
    roulette_max: 5000
    bj_max: 5000
    # Jump & Run: Belohnung am Ziel, Cooldown für die Belohnung, Sturztiefe unter dem Checkpoint
    jr_reward: 40
    jr_cooldown_minutes: 60
    jr_fall_depth: 3

# =========================================================
# 1. HILFSFUNKTIONEN
# =========================================================
function bwIsArena(w: world) :: boolean:
    set {_n} to "%name of {_w}%"
    if {_n} is "{@lobby_world}":
        return false
    if ",{@squad_worlds}," contains ",%{_n}%,":
        return true
    if {_n} starts with "{@arena_prefix}":
        return true
    return false

# true, wenn der Spieler gerade aktiv in einer Arena spielt
function bwInGame(p: player) :: boolean:
    if gamemode of {_p} is not survival:
        return false
    if bwIsArena(world of {_p}) is not true:
        return false
    if bwTeam({_p}) is "none":
        return false
    return true

# Teamname -> Farbcode fürs Tab (passend zu den RGB-Werten der SBW-Teamfarben)
function bwTeamColor(t: text) :: text:
    if {_t} is "red":
        return "&c"
    if {_t} is "blue":
        return "&1"
    if {_t} is "light_blue":
        return "&9"
    if {_t} is "green":
        return "&2"
    if {_t} is "lime":
        return "&a"
    if {_t} is "yellow":
        return "&e"
    if {_t} is "cyan":
        return "&b"
    if {_t} is "white":
        return "&f"
    if {_t} is "pink":
        return "&d"
    if {_t} is "magenta":
        return "&5"
    if {_t} is "orange":
        return "&6"
    if {_t} is "gray":
        return "&8"
    if {_t} is "light_gray":
        return "&7"
    if {_t} is "brown":
        return "&4"
    if {_t} is "black":
        return "&0"
    return "&7"

# Teamname -> deutscher Anzeigename (alle Farben)
function bwTeamNameDE(t: text) :: text:
    if {_t} is "red":
        return "Rot"
    if {_t} is "blue":
        return "Blau"
    if {_t} is "light_blue":
        return "Hellblau"
    if {_t} is "green":
        return "Dunkelgrün"
    if {_t} is "lime":
        return "Grün"
    if {_t} is "yellow":
        return "Gelb"
    if {_t} is "cyan":
        return "Türkis"
    if {_t} is "white":
        return "Weiß"
    if {_t} is "pink":
        return "Rosa"
    if {_t} is "magenta":
        return "Lila"
    if {_t} is "orange":
        return "Orange"
    if {_t} is "gray":
        return "Grau"
    if {_t} is "light_gray":
        return "Hellgrau"
    if {_t} is "brown":
        return "Braun"
    if {_t} is "black":
        return "Schwarz"
    set {_n} to {_t}
    replace all "team" with "Team " in {_n}
    return {_n}

# Text in Zeilen mit höchstens n Zeichen umbrechen (für Lore)
function bwWrap(t: text, n: number) :: texts:
    set {_words::*} to split {_t} at " "
    set {_line} to ""
    loop {_words::*}:
        if {_line} is "":
            set {_try} to "%loop-value%"
        else:
            set {_try} to "%{_line}% %loop-value%"
        if length of {_try} > {_n}:
            if {_line} is not "":
                add "&f%{_line}%" to {_out::*}
            set {_line} to "%loop-value%"
        else:
            set {_line} to {_try}
    if {_line} is not "":
        add "&f%{_line}%" to {_out::*}
    return {_out::*}

# Partikel (alle Partikelnamen des Skripts stehen NUR hier -> bei einem Fehler nur diese Zeilen ändern)
function bwPart(k: text, l: location):
    if {_k} is "flame":
        draw flame particle at {_l}
    else if {_k} is "heart":
        draw heart particle at {_l}
    else if {_k} is "villager":
        draw happy villager particle at {_l}
    else if {_k} is "crit":
        draw crit particle at {_l}
    else if {_k} is "endrod":
        draw end rod particle at {_l}
    else if {_k} is "note":
        draw note particle at {_l}
    else if {_k} is "soul":
        draw soul fire flame particle at {_l}
    else if {_k} is "firework":
        draw firework particle at {_l}
    else if {_k} is "dragon":
        draw dragon breath particle at {_l}
    else if {_k} is "totem":
        draw totem of undying particle at {_l}
    else if {_k} is "snow":
        draw snowflake particle at {_l}
    else if {_k} is "enchant":
        draw glow particle at {_l}
    else if {_k} is "portal":
        draw portal particle at {_l}
    else if {_k} is "witch":
        draw witch particle at {_l}
    else if {_k} is "spark":
        draw electric spark particle at {_l}
    else if {_k} is "glow":
        draw glow particle at {_l}
    else if {_k} is "sculk":
        draw sculk soul particle at {_l}
    else if {_k} is "lv5":
        draw crit particle at {_l}
        draw cloud particle at {_l}
    else if {_k} is "lv10":
        draw soul fire flame particle at {_l}
        draw flame particle at {_l}
    else if {_k} is "lv20":
        draw firework particle at {_l}
        draw end rod particle at {_l}
    else if {_k} is "lv30":
        draw glow particle at {_l}
        draw electric spark particle at {_l}
    else if {_k} is "lv40":
        draw dragon breath particle at {_l}
        draw portal particle at {_l}
    else if {_k} is "lv50":
        draw totem of undying particle at {_l}
        draw firework particle at {_l}
    else if {_k} is "lv75":
        draw sculk soul particle at {_l}
        draw soul fire flame particle at {_l}
        draw end rod particle at {_l}
    else if {_k} is "lv100":
        draw totem of undying particle at {_l}
        draw dragon breath particle at {_l}
        draw heart particle at {_l}
    else:
        draw cloud particle at {_l}

# Ring aus 12 Partikeln um einen Punkt
function bwRing(k: text, l: location, r: number, y: number):
    loop 12 times:
        set {_a} to loop-number * 30
        bwPart({_k}, ({_l} offset by vector(cos({_a}) * {_r}, {_y}, sin({_a}) * {_r})))

# Effekt-Ausbruch (Betten, Kills): steps Ringe, die sich um step Blöcke pro Tick weiten
function bwBurst(id: text, l: location, steps: number, step: number):
    set {_k} to bwCosPart({_id})
    if {_k} is "lightning":
        strike lightning effect at {_l}
        play sound "entity.lightning_bolt.thunder" with volume 1 and pitch 1 at {_l}
        stop
    play sound "entity.generic.explode" with volume 0.7 and pitch 1.4 at {_l}
    loop {_steps} times:
        bwRing({_k}, {_l}, loop-number * {_step}, loop-number * 0.12)
        wait 1 tick

# Statistik-Zähler (games, wins, kills, finalkills, deaths, beds)
function bwStatAdd(p: player, k: text, n: number):
    set {_u} to "%uuid of {_p}%"
    add {_n} to {bwst::%{_k}%::%{_u}%}
    set {bwx::name::%{_u}%} to name of {_p}

function bwStat(u: text, k: text) :: number:
    if {bwst::%{_k}%::%{_u}%} is not set:
        return 0
    return {bwst::%{_k}%::%{_u}%}

# =========================================================
# 2. /spectate  (Zuschauer-System)
# =========================================================
# /spectate [arena|spieler]   einem laufenden SPIEL zuschauen (Spectator-Modus: frei fliegen, nichts anfassen)
# /spectate                   als Zuschauer: öffnet die Spielerauswahl (Folgen / hinteleportieren)
# /spectate frei              Folge-Modus beenden und wieder frei fliegen
# /spectate leave             Zuschauen beenden
# Ohne Arena-Name: läuft genau ein Spiel, gehst du dorthin; sonst bekommst du die Liste.
# Zuschauer sind echte Zuschauer: Spectator-Modus, keine Interaktion, keine Container, keine Befehle
# (ausser /spectate, /chelp, /inhaber, /bw). Sie fliegen frei, werden aber nie weiter als {@spec_leash}
# Blöcke vom nächsten aktiven Spieler wegfliegen. Endet das Spiel (5 Sekunden lang kein aktiver Spieler
# in der Arena), wird das Zuschauen automatisch beendet. Kurze Aussetzer der Team-Erkennung beenden das
# Zuschauen NICHT mehr.
function bwSpecStop(p: player):
    set {_u} to "%uuid of {_p}%"
    if {-bwx::spec::%{_u}%} is not set:
        stop
    delete {-bwx::spec::%{_u}%}
    delete {-bwx::specfollow::%{_u}%}
    delete {-bwx::specempty::%{_u}%}
    set {_gm} to {bwx::specgm::%{_u}%}
    if {_gm} is not set:
        set {_gm} to survival
    if "%{_gm}%" is "spectator":
        set {_gm} to survival
    set gamemode of {_p} to {_gm}
    if {bwx::specloc::%{_u}%} is set:
        teleport {_p} to {bwx::specloc::%{_u}%}
    else if {bwx::lobbyloc} is set:
        teleport {_p} to {bwx::lobbyloc}
    delete {bwx::specloc::%{_u}%}
    delete {bwx::specgm::%{_u}%}
    send "&aDu schaust nicht mehr zu." to {_p}

# Alle aktiven Spieler (lebend, im Team) einer Welt
function bwSpecPlayers(w: world) :: players:
    loop all players in {_w}:
        if bwInGame(loop-player) is true:
            add loop-player to {_r::*}
    return {_r::*}

# Anzahl aktiver Spieler in einer Welt
function bwSpecActive(w: world) :: number:
    set {_n} to 0
    loop all players in {_w}:
        if bwInGame(loop-player) is true:
            add 1 to {_n}
    return {_n}

# Alle Arena-Welten, in denen gerade gespielt wird
function bwSpecWorlds() :: worlds:
    loop all worlds:
        if bwIsArena(loop-world) is true:
            if bwSpecActive(loop-world) > 0:
                add loop-world to {_r::*}
    return {_r::*}

# Nächster aktiver Spieler zu p in der Welt w (Liste mit 0 oder 1 Element)
function bwSpecNearest(p: player, w: world) :: players:
    set {_best} to 999999
    loop all players in {_w}:
        if bwInGame(loop-player) is true:
            set {_d} to distance between loop-player and {_p}
            if {_d} < {_best}:
                set {_best} to {_d}
                set {_near} to loop-player
    return {_near}

# Kamera hinter und über einen Spieler setzen
function bwSpecGoto(p: player, t: player):
    set {_yaw} to yaw of {_t}
    set {_l} to (location of {_t}) offset by vector(sin({_yaw}) * 3, 2, 0 - (cos({_yaw}) * 3))
    set yaw of {_l} to {_yaw}
    set pitch of {_l} to 20
    teleport {_p} to {_l}

function bwSpecFollow(p: player, t: player):
    set {_u} to "%uuid of {_p}%"
    set {-bwx::specfollow::%{_u}%} to {_t}
    bwSpecGoto({_p}, {_t})
    send "&aDu folgst jetzt &f%name of {_t}%&a. &7Frei fliegen: &e/spectate frei" to {_p}

function bwSpecStart(p: player, w: world):
    set {_u} to "%uuid of {_p}%"
    set {_act::*} to bwSpecPlayers({_w})
    if size of {_act::*} is 0:
        send "&cIn dieser Arena spielt gerade niemand." to {_p}
        stop
    if {-bwx::spec::%{_u}%} is not set:
        set {bwx::specloc::%{_u}%} to location of {_p}
        set {bwx::specgm::%{_u}%} to gamemode of {_p}
    set {-bwx::spec::%{_u}%} to "%name of {_w}%"
    delete {-bwx::specfollow::%{_u}%}
    delete {-bwx::specempty::%{_u}%}
    set {_first} to random element out of {_act::*}
    teleport {_p} to ((location of {_first}) offset by vector(0, 12, 0))
    # Manche Welt-Plugins (z.B. Multiverse "force gamemode") setzen beim Weltwechsel Survival.
    # Deshalb erst NACH dem Teleport auf Spectator stellen und danach laufend erzwingen.
    wait 3 ticks
    set gamemode of {_p} to spectator
    send "&aDu schaust jetzt dem Spiel in &f%name of {_w}% &azu und kannst frei umherfliegen." to {_p}
    send "&7Spieler auswählen: &e/spectate &8| &7Beenden: &e/spectate leave" to {_p}

function bwSpecMenu(p: player):
    set {_u} to "%uuid of {_p}%"
    if {-bwx::spec::%{_u}%} is not set:
        stop
    set {_w} to world "%{-bwx::spec::%{_u}%}%"
    if {_w} is not set:
        stop
    set {_inv} to chest inventory with 3 rows named "&8Zuschauer &7- Spieler wählen"
    set {_n} to 0
    loop bwSpecPlayers({_w}):
        if {_n} < 18:
            set {_pl} to loop-value
            set {_t} to bwTeam({_pl})
            set {_x} to bwTeamWool({_t})
            set name of {_x} to "%bwTeamColor({_t})%%name of {_pl}%"
            set {_hp} to floor((health of {_pl}) / 2)
            set lore of {_x} to "&7Team: %bwTeamColor({_t})%%bwTeamNameDE({_t})%" and "&7Leben: &c%{_hp}% ❤" and "&aLinksklick: folgen" and "&eRechtsklick: hinteleportieren" and "&8[spec=%name of {_pl}%]"
            set slot {_n} of {_inv} to {_x}
            add 1 to {_n}
    set {_x} to feather named "&bFrei fliegen"
    set lore of {_x} to "&7Folge-Modus beenden" and "&8[spec=free]"
    set slot 22 of {_inv} to {_x}
    set {_x} to barrier named "&cZuschauen beenden"
    set lore of {_x} to "&7Zurück in die Lobby" and "&8[spec=leave]"
    set slot 26 of {_inv} to {_x}
    open {_inv} to {_p}

command /spectate [<text>]:
    aliases: zuschauen
    usage: /spectate [arena|spieler] | /spectate frei | /spectate leave
    trigger:
        if sender is not a player:
            send "&cNur für Spieler!" to sender
            stop
        set {_u} to "%uuid of player%"
        if arg-1 is "leave" or "stop" or "ende":
            if {-bwx::spec::%{_u}%} is set:
                bwSpecStop(player)
            else:
                send "&cDu schaust gerade keinem Spiel zu." to player
            stop
        if {-bwx::spec::%{_u}%} is set:
            if arg-1 is not set:
                bwSpecMenu(player)
                stop
            if arg-1 is "frei" or "free":
                delete {-bwx::specfollow::%{_u}%}
                send "&aDu fliegst jetzt frei." to player
                stop
        if bwInGame(player) is true:
            send "&cDu spielst gerade selbst und kannst nicht zuschauen." to player
            stop
        set {_ws::*} to bwSpecWorlds()
        if size of {_ws::*} is 0:
            send "&cZurzeit läuft kein Spiel, dem du zuschauen kannst." to player
            stop
        if arg-1 is set:
            set {_tp} to arg-1 parsed as player
            if {_tp} is set:
                if bwInGame({_tp}) is true:
                    if {-bwx::spec::%{_u}%} is not set:
                        bwSpecStart(player, world of {_tp})
                    bwSpecFollow(player, {_tp})
                else:
                    send "&cDer Spieler &f%arg-1% &cspielt gerade nicht aktiv mit." to player
                stop
            set {_w} to world arg-1
            if {_w} is not set:
                send "&cArena oder Spieler &f%arg-1% &cwurde nicht gefunden." to player
                stop
            if {_ws::*} does not contain {_w}:
                send "&cIn der Arena &f%arg-1% &cläuft gerade kein Spiel." to player
                stop
        else:
            if size of {_ws::*} is 1:
                set {_w} to {_ws::1}
            else:
                send "&6Laufende Spiele (&e/spectate <arena>&6):" to player
                loop {_ws::*}:
                    send "&e%name of loop-value% &7(%bwSpecActive(loop-value)% Spieler)" to player
                stop
        bwSpecStart(player, {_w})

on inventory click:
    set {_t} to "%name of player's current inventory%"
    if {_t} contains "Zuschauer":
        cancel event
        set {_ci} to event-item
        if {_ci} is not set:
            stop
        set {_l} to "%lore of {_ci}%"
        if {_l} does not contain "[spec=":
            stop
        set {_p} to player
        set {_u} to "%uuid of {_p}%"
        if {-bwx::spec::%{_u}%} is not set:
            stop
        wait 1 tick
        close {_p}'s inventory
        if {_l} contains "[spec=leave]":
            bwSpecStop({_p})
            stop
        if {_l} contains "[spec=free]":
            delete {-bwx::specfollow::%{_u}%}
            send "&aDu fliegst jetzt frei." to {_p}
            stop
        set {_w} to world "%{-bwx::spec::%{_u}%}%"
        if {_w} is not set:
            stop
        loop bwSpecPlayers({_w}):
            if {_l} contains "[spec=%name of loop-value%]":
                set {_target} to loop-value
        if {_target} is not set:
            send "&cDieser Spieler ist nicht mehr im Spiel." to {_p}
            stop
        if click type is right mouse button or right mouse button with shift:
            delete {-bwx::specfollow::%{_u}%}
            bwSpecGoto({_p}, {_target})
        else:
            bwSpecFollow({_p}, {_target})

# Zuschauer können NICHT eingreifen: keine Container, kein Rechtsklick, keine fremden Befehle
on inventory open:
    if {-bwx::spec::%uuid of player%} is set:
        if "%name of event-inventory%" does not contain "Zuschauer":
            cancel event

on rightclick:
    if {-bwx::spec::%uuid of player%} is set:
        cancel event

on command:
    if {-bwx::spec::%uuid of player%} is not set:
        stop
    if player is op:
        stop
    set {_c} to command in lowercase
    if {_c} is "spectate" or "zuschauen" or "chelp" or "inhaber" or "bw":
        stop
    cancel event
    send "&cAls Zuschauer sind die meisten Befehle gesperrt. Beenden mit &e/spectate leave&c." to player

# Folge-Modus: der Zuschauer darf sich im Umkreis frei umsehen, wird aber bei Bedarf nachgezogen
every 5 ticks:
    loop all players:
        set {_u} to "%uuid of loop-player%"
        if {-bwx::specfollow::%{_u}%} is set:
            set {_t} to {-bwx::specfollow::%{_u}%}
            if {_t} is not online:
                delete {-bwx::specfollow::%{_u}%}
                send "&eDein Ziel hat das Spiel verlassen. Du fliegst jetzt frei." to loop-player
            else if bwInGame({_t}) is not true:
                delete {-bwx::specfollow::%{_u}%}
                send "&eDein Ziel ist ausgeschieden. Du fliegst jetzt frei. &7Neues Ziel: &e/spectate" to loop-player
            else if world of {_t} is not world of loop-player:
                delete {-bwx::specfollow::%{_u}%}
            else if distance between loop-player and {_t} > 7:
                bwSpecGoto(loop-player, {_t})

# Zuschauen automatisch beenden (Spiel vorbei / Welt verlassen) und Zuschauer in der Arena halten
every 10 ticks:
    loop all players:
        set {_u} to "%uuid of loop-player%"
        if {-bwx::spec::%{_u}%} is set:
            set {_p} to loop-player
            set {_w} to world "%{-bwx::spec::%{_u}%}%"
            if {_w} is not set:
                bwSpecStop({_p})
            else if world of {_p} is not {_w}:
                bwSpecStop({_p})
            else:
                if gamemode of {_p} is not spectator:
                    set gamemode of {_p} to spectator
                set {_act::*} to bwSpecPlayers({_w})
                if size of {_act::*} is 0:
                    add 1 to {-bwx::specempty::%{_u}%}
                    if {-bwx::specempty::%{_u}%} >= 10:
                        send "&eDas Spiel ist vorbei." to {_p}
                        bwSpecStop({_p})
                else:
                    delete {-bwx::specempty::%{_u}%}
                    set {_nn::*} to bwSpecNearest({_p}, {_w})
                    if size of {_nn::*} > 0:
                        set {_near} to {_nn::1}
                        if distance between {_p} and {_near} > {@spec_leash}:
                            bwSpecGoto({_p}, {_near})
                            send action bar "&eDu hast die Arena verlassen und wurdest zurückgeholt." to {_p}
                    delete {_nn::*}
            delete {_act::*}

# Solange man zuschaut, darf kein anderes Plugin den Spielmodus ändern (Survival wird abgelehnt)
on gamemode change to survival:
    if {-bwx::spec::%uuid of player%} is set:
        cancel event

on gamemode change to adventure:
    if {-bwx::spec::%uuid of player%} is set:
        cancel event

# Wer beim Zuschauen den Server verlässt, wird beim nächsten Join zurückgesetzt
on quit:
    delete {-bwx::spec::%uuid of player%}
    delete {-bwx::specfollow::%uuid of player%}
    delete {-bwx::specempty::%uuid of player%}

on join:
    set {_p} to player
    set {_u} to "%uuid of {_p}%"
    if {bwx::specloc::%{_u}%} is set:
        wait 1 tick
        set {_gm} to {bwx::specgm::%{_u}%}
        if {_gm} is not set:
            set {_gm} to survival
        if "%{_gm}%" is "spectator":
            set {_gm} to survival
        set gamemode of {_p} to {_gm}
        teleport {_p} to {bwx::specloc::%{_u}%}
        delete {bwx::specloc::%{_u}%}
        delete {bwx::specgm::%{_u}%}

# Wer einem Spiel beitritt, hört vorher auf zuzuschauen
on command "/bw join":
    bwSpecStop(player)

# =========================================================
# 3. FEUERBALL-KNOCKBACK (stark reduziert)
# =========================================================
# Die Explosion selbst bleibt unverändert, danach wird der Rückstoß der Spieler in der Nähe
# durch eine feste, kleine Geschwindigkeit ersetzt (Richtung: von der Explosion weg).
# Direkttreffer (bis {@fb_direct_range} Blöcke Abstand): ca. 4-5 Blöcke.  Streutreffer: ca. 2-3 Blöcke.
function bwFireKb(p: player, c: location, jump: boolean, sprint: boolean):
    set {_pl} to location of {_p}
    set {_d} to distance between {_c} and {_pl}
    set {_h} to {@fb_near_h}
    set {_y} to {@fb_near_y}
    if {_d} <= {@fb_direct_range}:
        set {_h} to {@fb_direct_h}
        set {_y} to {@fb_direct_y}
        if {_jump} is true:
            set {_y} to {@fb_jump_y}
    set {_v} to vector from {_c} to {_pl}
    if {_d} <= {@fb_direct_range}:
        if {_jump} is true:
            if {_sprint} is true:
                set {_y} to {@fb_sprint_y}
                set {_h} to {@fb_sprint_h}
                set {_v} to vector from {_pl} to (location 3 meters in front of {_p})
    set y component of {_v} to 0
    if vector length of {_v} < 0.05:
        set {_v} to vector(0, 0, 0)
    else:
        set vector length of {_v} to {_h}
    set y component of {_v} to {_y}
    set velocity of {_p} to {_v}

# Werfer jedes Feuerballs merken (für die Kill-Gutschrift)
on shoot:
    if shooter is a player:
        if projectile is a fireball or a small fireball:
            set {_p} to shooter
            if {-bwx::fbcd::%uuid of {_p}%} is set:
                if difference between {-bwx::fbcd::%uuid of {_p}%} and now is less than {@fb_cooldown} seconds:
                    # Cooldown aktiv: Wurf abbrechen und das von SBW entfernte Item zurueckgeben
                    cancel event
                    wait 1 tick
                    set {_diff} to {-bwx::fbcnt::%uuid of {_p}%} - bwFcCount({_p})
                    if {_diff} > 0:
                        set {_it} to {-bwx::fbitem::%uuid of {_p}%}
                        set item amount of {_it} to {_diff}
                        give {_it} to {_p}
                    stop
            set {-bw::fbo::%uuid of projectile%} to shooter
            set {-bwx::fbcd::%uuid of shooter%} to now
            set item cooldown of fire charge for shooter to {@fb_cooldown} seconds

# Feuerball-Cooldown: waehrend der Wartezeit wird der Rechtsklick abgebrochen
function bwFcCount(p: player) :: number:
    set {_c} to 0
    loop all items in {_p}'s inventory:
        if loop-item is fire charge:
            add item amount of loop-item to {_c}
    return {_c}

on rightclick holding fire charge with priority lowest:
    set {-bwx::fbcnt::%uuid of player%} to bwFcCount(player)
    set {-bwx::fbitem::%uuid of player%} to player's tool
    if {-bwx::fbcd::%uuid of player%} is set:
        if difference between {-bwx::fbcd::%uuid of player%} and now is less than {@fb_cooldown} seconds:
            cancel event

# Windcharge: zusaetzlicher Rueckstoss nach dem Aufprall (Hoch-Schub wie in Vanilla)
on projectile hit:
    if projectile is a wind charge:
        if {-bwx::wkproj::%uuid of projectile%} is set:
            delete {-bwx::wkproj::%uuid of projectile%}
            stop
        set {_loc} to location of projectile
        wait 1 tick
        loop all players in radius {@wc_radius} around {_loc}:
            if gamemode of loop-player is survival:
                if bwIsArena(world of loop-player) is true:
                    set {_f} to 1 - ((distance between {_loc} and location of loop-player) / {@wc_radius})
                    if {_f} > 0:
                        set {_v} to vector from {_loc} to location of loop-player
                        set y component of {_v} to 0
                        if vector length of {_v} > 0.05:
                            set vector length of {_v} to ({@wc_push} * {_f})
                        else:
                            set {_v} to vector(0, 0, 0)
                        set y component of {_v} to ({@wc_up} * {_f})
                        add {_v} to velocity of loop-player

on explode:
    if event-entity is a fireball or a small fireball:
        set {_loc} to location of event-entity
        set {_sh} to {-bw::fbo::%uuid of event-entity%}
        delete {-bw::fbo::%uuid of event-entity%}
        loop all players in radius 6 around {_loc}:
            set {_u} to "%uuid of loop-player%"
            set {_jp::%{_u}%} to true
            if loop-player is on ground:
                set {_jp::%{_u}%} to false
            set {_sp::%{_u}%} to false
            if loop-player is sprinting:
                set {_sp::%{_u}%} to true
        wait 1 tick
        # Kill-Gutschrift (ohne Schaden): wer vom Feuerball getroffen wird und danach stirbt (Void, Fall), zählt für den Werfer
        if {_sh} is a player:
            bwCreditHit({_sh}, {_loc})
        loop all players in radius 6 around {_loc}:
            if gamemode of loop-player is survival:
                if bwTeam(loop-player) is not "none":
                    bwFireKb(loop-player, {_loc}, {_jp::%uuid of loop-player%}, {_sp::%uuid of loop-player%})

# =========================================================
# 4. TABLISTE: TEAMFARBE + LEVEL
# =========================================================
# Format: [Lv 12] Rot Spielername   (Team + Name in der Teamfarbe; ohne Team weiß; Zuschauer grau)
# Wird alle 2 Sekunden und beim Join aktualisiert, gilt in der Lobby und in der Runde.
# Einzige Stelle mit dem Tablist-Ausdruck. Falls Skript sie nicht kennt: "tablist name" durch
# "player list name" ersetzen.
function bwSetTab(p: player, t: text):
    set tablist name of {_p} to {_t}

# TAB-Bridge: Skript kennt Level + Team, TAB kennt den Rang. Das Skript setzt pro Spieler die
# TAB-Eigenschaften tabprefix/tagprefix/tagsuffix (nur wenn sich etwas geändert hat) und baut den
# LuckPerms-Rang als Platzhalter %luckperms-prefix% ein, den TAB selbst live auflöst.
# (%% = ein echtes Prozentzeichen im Skript)
function bwTabBridge(p: player):
    set {_u} to "%uuid of {_p}%"
    set {_n} to name of {_p}
    set {_lv} to bwLevelOf(bwXp({_u}))
    set {_t} to bwTeam({_p})
    if bwIsArena(world of {_p}) is not true:
        set {_t} to "none"
    set {_rank} to "%%luckperms-prefix%%"
    if gamemode of {_p} is spectator:
        set {_tab} to "&8[&6Lv %{_lv}%&8] &7%{_rank}%&7"
        set {_tagp} to "&7%{_rank}%&7"
    else if {_t} is "none":
        set {_tab} to "&8[&6Lv %{_lv}%&8] &f%{_rank}%&f"
        set {_tagp} to "&f%{_rank}%&f"
    else:
        set {_c} to bwTeamColor({_t})
        set {_tab} to "&8[&6Lv %{_lv}%&8] %{_c}%[%bwTeamNameDE({_t})%] &f%{_rank}%%{_c}%"
        set {_tagp} to "%{_c}%[%bwTeamNameDE({_t})%] &f%{_rank}%%{_c}%"
    set {_tags} to " &8[&6Lv %{_lv}%&8]"
    set {_cache} to "%{_tab}%|%{_tagp}%|%{_tags}%"
    if {-bwx::tabcache::%{_u}%} is {_cache}:
        stop
    set {-bwx::tabcache::%{_u}%} to {_cache}
    execute console command "tab player %{_n}% tabprefix %{_tab}%"
    execute console command "tab player %{_n}% tagprefix %{_tagp}%"
    execute console command "tab player %{_n}% tagsuffix %{_tags}%"

on quit:
    delete {-bwx::tabcache::%uuid of player%}

function bwTabName(p: player):
    set {_bwopt_tab_skript} to "{@tab_skript}"
    if {_bwopt_tab_skript} is not "true":
        set {_bwopt_tab_bridge} to "{@tab_bridge}"
        if {_bwopt_tab_bridge} is "true":
            bwTabBridge({_p})
        stop
    set {_u} to "%uuid of {_p}%"
    set {_lv} to bwLevelOf(bwXp({_u}))
    set {_n} to name of {_p}
    if {bwx::name::%{_u}%} is not {_n}:
        set {bwx::name::%{_u}%} to {_n}
    if gamemode of {_p} is spectator:
        bwSetTab({_p}, "&8[&6Lv %{_lv}%&8] &7%{_n}%")
        stop
    set {_t} to bwTeam({_p})
    # Teamfarbe nur in der Lobby/Runde eines Spiels (Arena-Welten), nie in der Welt-Lobby
    if bwIsArena(world of {_p}) is not true:
        set {_t} to "none"
    if {_t} is "none":
        bwSetTab({_p}, "&8[&6Lv %{_lv}%&8] &f%{_n}%")
        stop
    set {_c} to bwTeamColor({_t})
    bwSetTab({_p}, "&8[&6Lv %{_lv}%&8] %{_c}%%bwTeamNameDE({_t})% %{_c}%%{_n}%")

every 2 seconds:
    loop all players:
        bwTabName(loop-player)

on join:
    set {_p} to player
    set {bwx::name::%uuid of {_p}%} to name of {_p}
    wait 1 second
    bwTabName({_p})

# =========================================================
# 5. STATISTIK: /stats, /top
# =========================================================
# Gezählt wird über die SBW-Rewards (config.yml -> /bwpoints ...) und den Tod-Event unten.
on death of player:
    if bwIsArena(world of victim) is true:
        if bwTeam(victim) is not "none":
            bwStatAdd(victim, "deaths", 1)
        if attacker is a player:
            set {_id} to {bwc::sel::%uuid of attacker%::kill}
            if {_id} is set:
                bwBurst({_id}, location of victim, 8, 0.2)

function bwShowStats(s: player, u: text, n: text):
    set {_g} to bwStat({_u}, "games")
    set {_w} to bwStat({_u}, "wins")
    set {_k} to bwStat({_u}, "kills")
    set {_fk} to bwStat({_u}, "finalkills")
    set {_d} to bwStat({_u}, "deaths")
    set {_b} to bwStat({_u}, "beds")
    set {_wr} to 0
    if {_g} > 0:
        set {_wr} to floor(({_w} / {_g}) * 1000) / 10
    set {_kd} to {_k} + {_fk}
    if {_d} > 0:
        set {_kd} to floor((({_k} + {_fk}) / {_d}) * 100) / 100
    set {_xp} to bwXp({_u})
    send "&8&m-------&r &6Statistiken: &e%{_n}% &8&m-------" to {_s}
    send "&7Level: &6%bwLevelOf({_xp})% &8| &7XP: &e%{_xp}% &8| &7Punkte: &e%bwPts({_u})%" to {_s}
    send "&7Spiele: &f%{_g}% &8| &7Siege: &a%{_w}% &8| &7Siegrate: &f%{_wr}%%%" to {_s}
    send "&7Kills: &f%{_k}% &8| &7Final Kills: &f%{_fk}% &8| &7Tode: &c%{_d}% &8| &7K/D: &f%{_kd}%" to {_s}
    send "&7Betten zerstört: &f%{_b}%" to {_s}

command /stats [<offlineplayer>]:
    usage: /stats [spieler]
    trigger:
        if arg-1 is not set:
            if sender is not a player:
                send "&cNutzung: /stats <spieler>" to sender
                stop
            bwShowStats(player, "%uuid of player%", name of player)
            stop
        set {_u} to "%uuid of arg-1%"
        if {bwx::name::%{_u}%} is not set:
            send "&cVon diesem Spieler gibt es keine Daten." to sender
            stop
        if sender is a player:
            bwShowStats(player, {_u}, {bwx::name::%{_u}%})
        else:
            set {_k} to bwStat({_u}, "kills")
            set {_w} to bwStat({_u}, "wins")
            send "&7Stats von %{bwx::name::%{_u}%}%: Kills %{_k}%, Wins %{_w}%" to sender

function bwTopLines(k: text) :: texts:
    if {_k} is "level":
        loop {bwp::xp::*}:
            set {_v::%loop-index%} to loop-value
    else if {_k} is "punkte":
        loop {bwp::pts::*}:
            set {_v::%loop-index%} to loop-value
    else:
        loop {bwst::%{_k}%::*}:
            set {_v::%loop-index%} to loop-value
    set {_r} to 1
    while {_r} <= 10:
        set {_best} to 0
        set {_bi} to ""
        loop {_v::*}:
            if loop-value > {_best}:
                set {_best} to loop-value
                set {_bi} to loop-index
        if {_bi} is "":
            set {_r} to 99
        else:
            set {_name} to {bwx::name::%{_bi}%}
            if {_name} is not set:
                set {_name} to "Unbekannt"
            if {_k} is "level":
                add "&e%{_r}%. &f%{_name}% &8- &6Level %bwLevelOf({_best})%" to {_out::*}
            else:
                add "&e%{_r}%. &f%{_name}% &8- &a%{_best}%" to {_out::*}
            delete {_v::%{_bi}%}
        add 1 to {_r}
    return {_out::*}

command /top [<text>]:
    aliases: leaderboard, bestenliste
    usage: /top [kills|wins|beds|finalkills|games|deaths|level|punkte]
    trigger:
        set {_k} to "kills"
        if arg-1 is set:
            set {_k} to arg-1 in lowercase
        if {_k} is "siege":
            set {_k} to "wins"
        if {_k} is "betten":
            set {_k} to "beds"
        set {_valid} to false
        if {_k} is "kills" or "wins" or "beds" or "finalkills" or "games" or "deaths" or "level" or "punkte":
            set {_valid} to true
        if {_valid} is false:
            send "&cNutzung: /top [kills|wins|beds|finalkills|games|deaths|level|punkte]" to sender
            stop
        set {_l::*} to bwTopLines({_k})
        send "&8&m-------&r &6Top 10: &e%{_k}% &8&m-------" to sender
        if size of {_l::*} is 0:
            send "&7Noch keine Einträge." to sender
            stop
        loop {_l::*}:
            send loop-value to sender

# =========================================================
# 6. PUNKTE: /punkte [spieler]  |  /pay <spieler> <anzahl>
# =========================================================
command /punkte [<text>] [<text>] [<integer>]:
    aliases: points, level, bwlevel
    usage: /punkte [spieler]  |  /level add <spieler> [anzahl] (nur Admins)
    trigger:
        if arg-1 is "add":
            if sender is not op:
                send "&cKeine Berechtigung." to sender
                stop
            if arg-2 is not set:
                send "&cNutzung: &e/level add <Spieler> [Anzahl]" to sender
                stop
            set {_t} to arg-2 parsed as player
            if {_t} is not set:
                send "&cSpieler &f%arg-2% &cist nicht online." to sender
                stop
            set {_n} to 1
            if arg-3 is set:
                set {_n} to arg-3
            if {_n} < 1:
                send "&cDie Anzahl muss mindestens 1 sein. &7(Zurücksetzen: &e/xp reset <Spieler>&7)" to sender
                stop
            bwAddLevels({_t}, {_n})
            set {_tu} to "%uuid of {_t}%"
            set {_lvl} to bwLevelOf(bwXp({_tu}))
            send "&a%name of {_t}% ist jetzt &6Level %{_lvl}%&a." to sender
            stop
        if arg-1 is "schenken" or "gift" or "give":
            send "&e/punkte schenken gibt es nicht mehr. Nutze jetzt &6/pay <Spieler> <Anzahl>&e." to sender
            stop
        if arg-1 is set:
            set {_op} to arg-1 parsed as offlineplayer
            set {_ou} to "%uuid of {_op}%"
            if {bwx::name::%{_ou}%} is not set:
                send "&cVon diesem Spieler gibt es keine Daten." to sender
                stop
            set {_xp} to bwXp({_ou})
            send "&6%{bwx::name::%{_ou}%}%&7: Level &6%bwLevelOf({_xp})% &8| &7XP &e%{_xp}% &8| &7Punkte &e%bwPts({_ou})% &8| &7Bank &e%bwBank({_ou})%" to sender
            stop
        if sender is not a player:
            send "&cNutzung: /punkte <spieler>" to sender
            stop
        set {_u} to "%uuid of player%"
        set {_xp} to bwXp({_u})
        send "&8&m-------&r &6Dein Fortschritt &8&m-------" to player
        send bwStatusLine(player) to player
        send "&7Level: &6%bwLevelOf({_xp})% &8| &7Gesamt-XP: &e%{_xp}% &8| &7Punkte: &e%bwPts({_u})% &8| &7Bank: &e%bwBank({_u})% &8| &7Depot: &e%bwStkValue({_u})%" to player
        send "&7Punkte gibt es für: Runde betreten, Kill, Final Kill, Bett, Sieg." to player
        send "&7Befehle: &e/pay &8| &e/bank &8| &e/aktien &8| &e/gamble &8| &e/kosmetik &8| &e/chelp" to player

# /pay ersetzt das frühere Schenken
command /pay <text> <integer>:
    usage: /pay <Spieler> <Anzahl>
    trigger:
        if sender is not a player:
            send "&cNur für Spieler!" to sender
            stop
        set {_t} to arg-1 parsed as player
        if {_t} is not set:
            send "&cSpieler &f%arg-1% &cist nicht online." to player
            stop
        if {_t} is player:
            send "&cDu kannst dir selbst keine Punkte überweisen." to player
            stop
        if arg-2 < 1:
            send "&cDie Anzahl muss mindestens 1 sein." to player
            stop
        set {_u} to "%uuid of player%"
        if bwPts({_u}) < arg-2:
            send "&cDu hast nur &e%bwPts({_u})% &cPunkte." to player
            stop
        set {_tu} to "%uuid of {_t}%"
        set {bwp::pts::%{_u}%} to bwPts({_u}) - arg-2
        set {bwp::pts::%{_tu}%} to bwPts({_tu}) + arg-2
        send "&aDu hast &e%arg-2% Punkte &aan &f%name of {_t}% &aüberwiesen. &7Guthaben: &e%bwPts({_u})%" to player
        send "&a&f%name of player% &ahat dir &e%arg-2% Punkte &aüberwiesen! &7Guthaben: &e%bwPts({_tu})%" to {_t}
        play sound "entity.player.levelup" with volume 0.6 and pitch 1.6 to {_t}

# =========================================================
# 7. ADMIN: /resetstats, /game stop, /cancelgame, /setbwlobby
# =========================================================
# /resetstats <spieler>                  Punkte, XP/Level und Statistiken (Skript-Leaderboard) eines Spielers
# /resetstats <spieler> kosmetik         zusätzlich seine gekauften Kosmetika
# /resetstats all confirm [kosmetik]     das Gleiche für ALLE Spieler (Leaderboard komplett leer)
# Hinweis: Die internen SBW-Statistiken (/bw stats, SBW-Hologramm) liegen in einer eigenen Datei,
# die ein Skript nicht löschen kann (siehe README unten in der Antwort).
function bwResetPlayer(u: text, withcos: boolean):
    delete {bwp::pts::%{_u}%}
    delete {bwp::xp::%{_u}%}
    loop "plays", "won", "lost", "best", "streak", "cbest", "dstreak" and "dlast":
        delete {bwp::g%loop-value%::%{_u}%}
    loop "games", "wins", "kills", "finalkills", "deaths" and "beds":
        delete {bwst::%loop-value%::%{_u}%}
    if {_withcos} is true:
        delete {bwc::own::%{_u}%::*}
        delete {bwc::sel::%{_u}%::*}

command /resetstats <text> [<text>] [<text>]:
    permission: op
    usage: /resetstats <spieler> [kosmetik] | /resetstats all confirm [kosmetik]
    trigger:
        set {_cos} to false
        if arg-2 is "kosmetik":
            set {_cos} to true
        if arg-3 is "kosmetik":
            set {_cos} to true
        if arg-1 is "all":
            if arg-2 is not "confirm":
                send "&cACHTUNG: Das setzt Punkte, Level und Statistiken ALLER Spieler zurück!" to sender
                send "&cZur Bestätigung: &e/resetstats all confirm &7(optional &e/resetstats all confirm kosmetik&7)" to sender
                stop
            delete {bwp::pts::*}
            delete {bwp::xp::*}
            delete {bwst::*}
            if {_cos} is true:
                delete {bwc::*}
            send "&aAlle Punkte, Level und Statistiken (Leaderboard) wurden zurückgesetzt." to sender
            stop
        set {_op} to arg-1 parsed as offlineplayer
        set {_u} to "%uuid of {_op}%"
        if {bwx::name::%{_u}%} is not set:
            send "&cVon diesem Spieler gibt es keine Daten." to sender
            stop
        bwResetPlayer({_u}, {_cos})
        send "&aPunkte, Level und Statistiken von &f%{bwx::name::%{_u}%}% &awurden zurückgesetzt." to sender

# Lobby-Punkt, zu dem Spieler nach /game stop bzw. /spectate leave gebracht werden
command /setbwlobby:
    permission: op
    trigger:
        if sender is not a player:
            stop
        set {bwx::lobbyloc} to location of player
        send "&aLobby-Punkt gesetzt." to player

# Alle Spieler einer Arena in die Lobby schicken und die Rundendaten löschen
function bwEvacuate(w: world):
    loop all players in {_w}:
        bwSpecStop(loop-player)
        add loop-player to {_pl::*}
    loop {_pl::*}:
        make loop-value execute command "bw leave"
    wait 1 second
    loop {_pl::*}:
        if world of loop-value is {_w}:
            if {bwx::lobbyloc} is set:
                teleport loop-value to {bwx::lobbyloc}
            else:
                make loop-value execute command "spawn"
        send "&c&lDas Spiel wurde von einem Admin abgebrochen." to loop-value
    bwResetWorldData({_w})

command /game [<text>] [<text>]:
    permission: op
    usage: /game stop [arena]
    trigger:
        if arg-1 is not "stop":
            send "&cNutzung: /game stop [arena]" to sender
            stop
        if arg-2 is set:
            set {_w} to world arg-2
        else if sender is a player:
            set {_w} to world of player
        if {_w} is not set:
            send "&cNutze /game stop <arena> (Name der Arena-Welt)." to sender
            stop
        if name of {_w} is "{@lobby_world}":
            send "&cDas ist die Lobby, kein Spiel." to sender
            stop
        if size of (all players in {_w}) is 0:
            send "&cIn dieser Welt ist niemand." to sender
            stop
        send "&aSpiel in &f%name of {_w}% &awird abgebrochen ..." to sender
        bwEvacuate({_w})

command /cancelgame [<text>]:
    permission: op
    aliases: stopgame
    usage: /cancelgame [arena]
    trigger:
        if arg-1 is set:
            set {_w} to world arg-1
        else if sender is a player:
            set {_w} to world of player
        if {_w} is not set:
            send "&cNutze /cancelgame <arena> (Name der Arena-Welt)." to sender
            stop
        if name of {_w} is "{@lobby_world}":
            send "&cDas ist die Lobby, kein Spiel." to sender
            stop
        if size of (all players in {_w}) is 0:
            send "&cIn dieser Welt ist niemand." to sender
            stop
        send "&aSpiel in &f%name of {_w}% &awird abgebrochen ..." to sender
        bwEvacuate({_w})

# =========================================================
# 8. KOSMETIK-SHOP: /kosmetik
# =========================================================
# Bezahlt wird mit Punkten (nur der Punktestand sinkt, XP/Level bleiben).
# {bwc::own::<uuid>::<id>} = gekauft, {bwc::sel::<uuid>::<kategorie>} = aktuell ausgewählt
# Kategorien: arrow (Pfeilspuren), bed (Betten-Explosion), kill (Kill-Effekte)
# Level-Kosmetika (a_lv5, k_lv10, ...) werden bei Level 5/10/20/30/40/50/75/100 automatisch freigeschaltet.
# Alle Effekte stehen in den Tabellen unten (Name, Preis, Icon, Partikel).
#
# Hinweis: In den Lore-Texten steht absichtlich nie das Wort "Price"/"Quickbuy-Slot",
# damit die Shop-Handler in Bedwars.sk diese Menüs ignorieren.

