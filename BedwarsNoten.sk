# =========================================================
# BEDWARS NOTEN-MUSIK (sechste Datei, braucht skript-reflect, KEIN SkBee) - OHNE RESOURCE PACK
# =========================================================
# Spielt Lieder im Notenblock-Format (.nbs) mit den eingebauten Minecraft-Notenblock-Sounds ab.
# Dafuer braucht kein Spieler ein Resource Pack: die Sounds stecken schon im Spiel.
#
# /noten play <Distanz> <Datei>   Lied an DEINER Position abspielen, Hoerweite = Distanz in Bloecken (z.B. 30).
#                                 Je weiter weg, desto leiser. Statt einer Zahl: "alle" = alle Spieler hoeren es ueberall.
# /noten stop                  Lied beenden
# /noten list                  Dateien im Ordner anzeigen
#
# SO BENUTZT DU ES:
# 1. .nbs-Dateien in den Ordner plugins/Musik/nbs legen (wird beim Laden des Skripts automatisch angelegt;
#    sonst selbst anlegen oder einmal /noten list ausfuehren).
#    Dateinamen: NUR kleine Buchstaben, Zahlen, _ und - (z.B. lobby_theme.nbs).
# 2. /noten list und z.B. /noten play 30 lobby_theme
#
# WOHER KOMMEN .nbs-DATEIEN?
# - Aus dem Programm "Open Note Block Studio" (kostenlos): dort Lieder selbst bauen oder eine MIDI-Datei
#   importieren und als .nbs speichern.
# - Aus Online-Sammlungen fuer Notenblock-Lieder.
# Eine .ogg-Datei (echte Aufnahme) laesst sich NICHT automatisch in .nbs umwandeln.
#
# HINWEISE: Es werden die 16 Vanilla-Instrumente gespielt. Eigene Instrumente einer .nbs-Datei werden
# uebersprungen. Das Einlesen einer grossen Datei kann beim ersten Abspielen kurz ruckeln.
# =========================================================

import:
    java.io.File
    java.nio.file.Files

options:
    nbs_dir: plugins/Musik/nbs
    # Maximale Hoerweite in Bloecken
    nbs_max_dist: 200

# ---------------------------------------------------------
# Byte-Hilfen (die Datei liegt zum Parsen in {-bwx::nbs::tmp::*}, Zahlen sind Little-Endian)
# ---------------------------------------------------------
function bwNbsU(x: number) :: number:
    if {_x} < 0:
        return {_x} + 256
    return {_x}

function bwNbsShort(p: number) :: number:
    return bwNbsU({-bwx::nbs::tmp::%{_p}%}) + bwNbsU({-bwx::nbs::tmp::%{_p} + 1%}) * 256

function bwNbsInt(p: number) :: number:
    set {_a} to bwNbsU({-bwx::nbs::tmp::%{_p}%})
    set {_b} to bwNbsU({-bwx::nbs::tmp::%{_p} + 1%})
    set {_c} to bwNbsU({-bwx::nbs::tmp::%{_p} + 2%})
    set {_d} to bwNbsU({-bwx::nbs::tmp::%{_p} + 3%})
    return {_a} + {_b} * 256 + {_c} * 65536 + {_d} * 16777216

# Instrument-Nummer -> Vanilla-Notenblock-Sound ("none" = nicht abspielbar)
function bwNbsSound(i: number) :: text:
    if {_i} is 0:
        return "block.note_block.harp"
    if {_i} is 1:
        return "block.note_block.bass"
    if {_i} is 2:
        return "block.note_block.basedrum"
    if {_i} is 3:
        return "block.note_block.snare"
    if {_i} is 4:
        return "block.note_block.hat"
    if {_i} is 5:
        return "block.note_block.guitar"
    if {_i} is 6:
        return "block.note_block.flute"
    if {_i} is 7:
        return "block.note_block.bell"
    if {_i} is 8:
        return "block.note_block.chime"
    if {_i} is 9:
        return "block.note_block.xylophone"
    if {_i} is 10:
        return "block.note_block.iron_xylophone"
    if {_i} is 11:
        return "block.note_block.cow_bell"
    if {_i} is 12:
        return "block.note_block.didgeridoo"
    if {_i} is 13:
        return "block.note_block.bit"
    if {_i} is 14:
        return "block.note_block.banjo"
    if {_i} is 15:
        return "block.note_block.pling"
    return "none"

# Ordner einlesen -> {-bwx::nbs::files::*} (Namen ohne .nbs)
function bwNbsList():
    delete {-bwx::nbs::files::*}
    set {_dir} to new File("{@nbs_dir}")
    {_dir}.mkdirs()
    set {_names::*} to ...{_dir}.list()
    loop sorted {_names::*}:
        set {_f} to "%loop-value%"
        if {_f} ends with ".nbs":
            set {_b} to subtext of {_f} from characters 1 to (length of {_f} - 4)
            if {_b} matches "[a-z0-9_-]+":
                add {_b} to {-bwx::nbs::files::*}

# Beim Laden des Skripts den Ordner sofort anlegen (plugins/Musik/nbs)
on load:
    bwNbsList()

# .nbs-Datei einlesen -> {-bwx::nbs::notes::<name>::<tick>::*} = "instrument,taste,lautstaerke"
function bwNbsLoad(n: text) :: boolean:
    set {_f} to new File("{@nbs_dir}/%{_n}%.nbs")
    if {_f}.exists() is not true:
        return false
    set {_path} to {_f}.toPath()
    set {-bwx::nbs::tmp::*} to ...Files.readAllBytes({_path})
    set {_size} to size of {-bwx::nbs::tmp::*}
    if {_size} < 20:
        delete {-bwx::nbs::tmp::*}
        return false
    delete {-bwx::nbs::notes::%{_n}%::*}
    # Kopf: neues Format beginnt mit 0 (Short), danach Version
    set {_ver} to 0
    set {_p} to 3
    if bwNbsShort(1) is 0:
        set {_ver} to bwNbsU({-bwx::nbs::tmp::3})
        set {_p} to 5
        if {_ver} >= 3:
            set {_p} to 7
    # Anzahl Ebenen (Short), dann 4 Texte (Name, Autor, Original-Autor, Beschreibung)
    add 2 to {_p}
    loop 4 times:
        set {_len} to bwNbsInt({_p})
        add 4 + {_len} to {_p}
    # Tempo (Short, Hundertstel Ticks pro Sekunde), 3 Bytes, 5 Ints, MIDI-Dateiname
    set {_tempo} to bwNbsShort({_p})
    if {_tempo} <= 0:
        set {_tempo} to 1000
    add 2 to {_p}
    add 3 to {_p}
    add 20 to {_p}
    set {_len} to bwNbsInt({_p})
    add 4 + {_len} to {_p}
    if {_ver} >= 4:
        add 4 to {_p}
    # Noten
    set {_tick} to -1
    set {_maxtick} to 0
    set {_go} to true
    while {_go} is true:
        if {_p} + 1 > {_size}:
            set {_go} to false
        else:
            set {_jump} to bwNbsShort({_p})
            add 2 to {_p}
            if {_jump} is 0:
                set {_go} to false
            else:
                add {_jump} to {_tick}
                set {_maxtick} to {_tick}
                set {_in} to true
                while {_in} is true:
                    if {_p} + 1 > {_size}:
                        set {_in} to false
                        set {_go} to false
                    else:
                        set {_lj} to bwNbsShort({_p})
                        add 2 to {_p}
                        if {_lj} is 0:
                            set {_in} to false
                        else:
                            set {_inst} to bwNbsU({-bwx::nbs::tmp::%{_p}%})
                            set {_key} to bwNbsU({-bwx::nbs::tmp::%{_p} + 1%})
                            set {_vel} to 100
                            add 2 to {_p}
                            if {_ver} >= 4:
                                set {_vel} to bwNbsU({-bwx::nbs::tmp::%{_p}%})
                                add 4 to {_p}
                            add "%{_inst}%,%{_key}%,%{_vel}%" to {-bwx::nbs::notes::%{_n}%::%{_tick}%::*}
    delete {-bwx::nbs::tmp::*}
    set {-bwx::nbs::len::%{_n}%} to {_maxtick}
    set {-bwx::nbs::tempo::%{_n}%} to {_tempo}
    return true

# ---------------------------------------------------------
# Wiedergabe: jeden Server-Tick weiterzaehlen, alle faelligen Noten abspielen
# ---------------------------------------------------------
every tick:
    set {_cur} to {-bwx::nbs::cur}
    if {_cur} is not set:
        stop
    add {-bwx::nbs::tps} / 20 to {-bwx::nbs::pos}
    set {_upto} to floor({-bwx::nbs::pos})
    while {-bwx::nbs::last} < {_upto}:
        add 1 to {-bwx::nbs::last}
        loop {-bwx::nbs::notes::%{_cur}%::%{-bwx::nbs::last}%::*}:
            set {_parts::*} to split loop-value at ","
            set {_snd} to bwNbsSound({_parts::1} parsed as number)
            if {_snd} is not "none":
                set {_key} to {_parts::2} parsed as number
                # in den Vanilla-Bereich (Tasten 33 bis 57) schieben
                while {_key} < 33:
                    add 12 to {_key}
                while {_key} > 57:
                    subtract 12 from {_key}
                set {_pitch} to 2 ^ (({_key} - 45) / 12)
                set {_vol} to ({_parts::3} parsed as number) / 100
                if {-bwx::nbs::dist} is set:
                    loop all players in world of {-bwx::nbs::loc}:
                        set {_d} to distance between (location of loop-player) and {-bwx::nbs::loc}
                        if {_d} <= {-bwx::nbs::dist}:
                            set {_v} to {_vol} * (1 - 0.8 * {_d} / {-bwx::nbs::dist})
                            play sound {_snd} with volume {_v} and pitch {_pitch} to loop-player
                else:
                    loop all players:
                        play sound {_snd} with volume {_vol} and pitch {_pitch} to loop-player
    if {-bwx::nbs::last} > {-bwx::nbs::len::%{_cur}%}:
        delete {-bwx::nbs::cur}

command /noten [<text>] [<text>] [<text>]:
    aliases: nbs
    usage: /noten play <Distanz|alle> <Datei> | stop | list
    permission: op
    trigger:
        if arg-1 is "list" or "liste":
            bwNbsList()
            if size of {-bwx::nbs::files::*} is 0:
                send "&6[Noten] &7Keine .nbs-Dateien in &f{@nbs_dir} &7gefunden. Dateinamen: nur a-z, 0-9, _ und -" to sender
                stop
            send "&6[Noten] &7Dateien (&e%size of {-bwx::nbs::files::*}%&7):" to sender
            loop {-bwx::nbs::files::*}:
                send "&8- &f%loop-value%" to sender
            stop
        if arg-1 is "stop":
            delete {-bwx::nbs::cur}
            send "&6[Noten] &7Musik beendet." to sender
            stop
        if arg-1 is "play" or "abspielen":
            if arg-2 is not set:
                send "&cNutzung: /noten play <Distanz|alle> <Datei>" to sender
                stop
            if arg-3 is not set:
                send "&cNutzung: /noten play <Distanz|alle> <Datei> &7(Dateien: /noten list)" to sender
                stop
            set {_dist} to arg-2 parsed as number
            if arg-2 is not "alle":
                if {_dist} is not set:
                    send "&cDie Distanz muss eine Zahl (Blöcke) sein, z.B. &e30&c, oder &ealle&c." to sender
                    stop
                if sender is not a player:
                    send "&cVon der Konsole geht nur &e/noten play alle <Datei>&c." to sender
                    stop
                if {_dist} < 1:
                    set {_dist} to 1
                if {_dist} > {@nbs_max_dist}:
                    set {_dist} to {@nbs_max_dist}
            set {_n} to arg-3 in lowercase
            if {_n} ends with ".nbs":
                set {_n} to subtext of {_n} from characters 1 to (length of {_n} - 4)
            bwNbsList()
            if {-bwx::nbs::files::*} does not contain {_n}:
                send "&cDatei &f%{_n}% &cnicht gefunden. Vorhandene Dateien: &e/noten list" to sender
                stop
            if {-bwx::nbs::len::%{_n}%} is not set:
                send "&6[Noten] &7Lese &f%{_n}% &7ein ..." to sender
                if bwNbsLoad({_n}) is not true:
                    send "&cDie Datei &f%{_n}% &cließ sich nicht einlesen." to sender
                    stop
            set {-bwx::nbs::tps} to {-bwx::nbs::tempo::%{_n}%} / 100
            set {-bwx::nbs::pos} to 0
            set {-bwx::nbs::last} to -1
            delete {-bwx::nbs::dist}
            delete {-bwx::nbs::loc}
            if arg-2 is not "alle":
                set {-bwx::nbs::dist} to {_dist}
                set {-bwx::nbs::loc} to location of player
            set {-bwx::nbs::cur} to {_n}
            if arg-2 is "alle":
                send "&6[Noten] &7Spiele &f%{_n}% &7für alle Spieler (kein Resource Pack nötig)." to sender
            else:
                send "&6[Noten] &7Spiele &f%{_n}% &7an deiner Position, Hörweite &e%{_dist}% &7Blöcke (kein Resource Pack nötig)." to sender
            stop
        send "&6[Noten] &7Nutzung: &e/noten play <Distanz|alle> <Datei> &8| &e/noten stop &8| &e/noten list" to sender
